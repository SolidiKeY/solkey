\programSource "PaperTest.sol";

\problem {
    find<[int]>(storage, cons3(PaperTest$bucket, PaperTest$TokenBucket$tokens, size)) = 0 ->
    \<{
        alice.account.token.value = 7;
        Token storage tokRef = alice.account.token;
        bucket.tokens.push() = tokRef;
        Token[] storage bt = bucket.tokens;
        assert(bt.length == 1);
        assert(bt[0].value == 7);
    }\> true
}
