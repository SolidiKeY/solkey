\programSource "PaperTest.sol";

\problem {
    memory = mtMem ->
        \<{
            Person memory carol;
            Account memory carolAcc = carol.account;
            carolAcc.balance = 100;
            delete carol.account;
            assert(carol.account.balance == 0);
            assert(carolAcc.balance == 100);
        }\> true
}
