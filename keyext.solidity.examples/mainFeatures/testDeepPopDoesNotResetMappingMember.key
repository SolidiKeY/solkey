\programSource "PaperTest.sol";

\problem {
    find<[int]>(storage, cons2(PaperTest$ledgerUses, size)) = 0 ->
    \<{
        ledgerUses.push();
        ledgerUses[0].ledger.balances[1] = 10;
        ledgerUses.pop();
        ledgerUses.push();
        assert(ledgerUses[0].ledger.balances[1] == 10);
    }\> true
}
