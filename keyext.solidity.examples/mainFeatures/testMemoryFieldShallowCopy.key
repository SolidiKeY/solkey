\programSource "PaperTest.sol";

\problem {
    memory = mtMem ->
        \<{
            Person memory carol;
            Person memory david;
            david.account.balance = 50;
            carol.account = david.account;
            carol.account.balance = 60;
            assert(david.account.balance == 60);
            assert(carol.account.balance == 60);
        }\> true
}
