\programSource "PaperTest.sol";

\problem {
    memory = mtMem ->
        \<{
            uint[] memory carolValues = new uint[](3);
            uint i = 1;
            carolValues[i--] = 77;
            uint v = carolValues[1];
            delete carolValues[1];
            assert(i == 0);
            assert(v == 77);
            assert(carolValues[1] == 0);
        }\> true
}
