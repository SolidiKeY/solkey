\programSource "PaperTest.sol";

\problem {
    memory = mtMem ->
        \<{
            uint[] memory carolValues = new uint[](3);
            uint i = 1;
            carolValues[--i] = 77;
            uint v = carolValues[i];
            delete carolValues[i];
            assert(i == 0);
            assert(v == 77);
            assert(carolValues[0] == 0);
        }\> true
}
