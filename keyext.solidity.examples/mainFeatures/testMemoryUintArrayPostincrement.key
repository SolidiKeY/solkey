\programSource "PaperTest.sol";

\problem {
    memory = mtMem ->
        \<{
            uint[] memory carolValues = new uint[](3);
            uint i = 0;
            carolValues[i++] = 77;
            uint v = carolValues[0];
            delete carolValues[0];
            assert(i == 1);
            assert(v == 77);
            assert(carolValues[0] == 0);
        }\> true
}
