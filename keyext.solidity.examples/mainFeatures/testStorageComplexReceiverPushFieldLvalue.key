\programSource "PaperTest.sol";

\problem {
    find<[int]>(storage, cons3(PaperTest$bucket, PaperTest$TokenBucket$tokens, size)) = 0 ->
    \<{
        bucket.tokens.push().value = 5;
        Token[] storage bt = bucket.tokens;
        assert(bt.length == 1);
        assert(bt[0].value == 5);
    }\> true
}
