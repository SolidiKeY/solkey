\programSource "PaperTest.sol";

\problem {
    \<{
        alice.account.balance = 100;
        alice.account.token.value = 7;
        delete alice.account;
        int b = alice.account.balance;
        uint v = alice.account.token.value;
        assert(b == 0);
        assert(v == 0);
    }\> true
}
