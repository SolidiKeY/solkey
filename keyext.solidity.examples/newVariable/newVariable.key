// Showcase: introducing a fresh program variable with \new and executing statements one at a
// time through a context block (c# ... #c).
//
// freshTempAssign rewrites the first active assignment `v = se;` by routing the value through a
// fresh temporary tmp (\new(tmp, int) creates a fresh local variable on every application) and
// then continues with the remaining program in the context block. Applying it twice executes
// `p = 42; q = p;` sequentially, so q = 42 is proved.
//
// This exercises the per-statement execution machinery (ProgramContextAdder) together with the
// fresh-variable mechanism (\new), independent of any committed execution semantics.

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program Variable v;
    \program Variable tmp;
    \program SimpleExpression se;
    \formula post;
}

\programVariables {
    int p, q;
}

\rules {
    freshTempAssign {
        \schemaVar \program Variable v;
        \schemaVar \program Variable tmp;
        \schemaVar \program SimpleExpression se;
        \schemaVar \formula post;
        \find(\modality{#mod}{c# s#v = s#se; #c}\endmodality(post))
        \varcond(\new(tmp, int))
        \replacewith({tmp := se}{v := tmp}\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ p = 42; q = p; }\>(q = 42)
}
