\functions {
    \unique Field nonce;
    \unique MapField balances;
    \unique RefField inner;
    \unique Field ledger;
    \unique Field ledger2;
}

\problem {
    {storage := copyAt(storage, cons(ledger2, nil), find<[StValue]>(storage, cons(ledger, nil)))}
        (   find<[int]>(storage, cons2(ledger2, nonce))
              = find<[int]>(storage, cons2(ledger, nonce))
          & find<[int]>(storage, cons(ledger2, cons(inner, cons(nonce, nil))))
              = find<[int]>(storage, cons(ledger, cons(inner, cons(nonce, nil))))
          & find<[int]>(storage, cons(ledger2, cons(balances, cons(at(1), nil))))
              = find<[int]>(storage, cons(ledger2, cons(balances, cons(at(1), nil))))
          & find<[int]>(storage, cons(ledger2, cons(inner, cons(balances, cons(at(1), nil)))))
              = find<[int]>(storage, cons(ledger2, cons(inner, cons(balances, cons(at(1), nil))))) )
}
