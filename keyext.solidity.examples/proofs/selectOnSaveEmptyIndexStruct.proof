\profile "Solidity Profile";

\settings // Proof-Settings-Config-File
{
    "Choice": {
        "integerSimplificationRules": "integerSimplificationRules:full",
        "programRules": "programRules:Solidity",
        "transferSemantics": "transferSemantics:noCallback"
    },
    "Strategy": {
        "ActiveStrategy": "Modular SolidityDL Strategy",
        "MaximumNumberOfAutomaticApplications": 10000,
        "Timeout": -1,
        "options": {
            "AUTO_INDUCTION_OPTIONS_KEY": "AUTO_INDUCTION_OFF",
            "FUNCTION_OPTIONS_KEY": "FUNCTION_CONTRACT",
            "LOOP_OPTIONS_KEY": "LOOP_INVARIANT",
            "NON_LIN_ARITH_OPTIONS_KEY": "NON_LIN_ARITH_NONE",
            "QUANTIFIERS_OPTIONS_KEY": "QUANTIFIERS_NON_SPLITTING_WITH_PROGS",
            "SPLITTING_OPTIONS_KEY": "SPLITTING_DELAYED",
            "STOPMODE_OPTIONS_KEY": "STOPMODE_DEFAULT",
            "USER_TACLETS_OPTIONS_KEY1": "USER_TACLETS_OFF",
            "USER_TACLETS_OPTIONS_KEY2": "USER_TACLETS_OFF",
            "USER_TACLETS_OPTIONS_KEY3": "USER_TACLETS_OFF"
        }
    }
} 

\functions {
    IdentityPrim p;
    Identity id;
    Memory m;
    Struct s;
    Struct t;
    \unique Field f;
    \unique Field g;
    \unique MapField mf;
}
\problem {
     leq(selectSt<[int]>(t, size), 1)
   & leq(selectSt<[int]>(s, size), 1)
->   selectSt<[Struct]>(save(s, nil, t), at(1))
   = selectSt<[Struct]>(s, at(1))
}

\proof {
(branch "dummy ID"
(rule "selectOnSaveEmptyIndexStruct" (formula "1") (term "0,1"))
(rule "impRight" (formula "1"))
(rule "andLeft" (formula "1"))
(rule "castDel" (formula "3") (term "0,1,0,0"))
(rule "castDel" (formula "3") (term "0,2,1,0"))
(rule "inEqSimp_ltToLeq" (formula "3") (term "0,2,0"))
(rule "polySimp_mulComm0" (formula "3") (term "1,0,0,0,2,0"))
(rule "polySimp_addComm1" (formula "3") (term "0,0,2,0"))
(rule "add_literals" (formula "3") (term "0,0,0,2,0"))
(rule "inEqSimp_ltToLeq" (formula "3") (term "0,0"))
(rule "polySimp_mulComm0" (formula "3") (term "1,0,0,0,0"))
(rule "polySimp_addComm1" (formula "3") (term "0,0,0"))
(rule "add_literals" (formula "3") (term "0,0,0,0"))
(rule "inEqSimp_sepNegMonomial0" (formula "3") (term "0,2,0"))
(rule "polySimp_mulLiterals" (formula "3") (term "0,0,2,0"))
(rule "polySimp_elimOne" (formula "3") (term "0,0,2,0"))
(rule "inEqSimp_sepNegMonomial0" (formula "3") (term "0,0"))
(rule "polySimp_mulLiterals" (formula "3") (term "0,0,0"))
(rule "polySimp_elimOne" (formula "3") (term "0,0,0"))
(rule "inEqSimp_contradInEq0" (formula "3") (term "0,0") (assumesSeqFormula "1"))
(rule "qeq_literals" (formula "3") (term "0,0,0"))
(rule "concrete_and_2" (formula "3") (term "0,0"))
(rule "ifthenelse_false" (formula "3") (term "0"))
(rule "ifthenelse_concrete4" (formula "3"))
(rule "orRight" (formula "3"))
(rule "notRight" (formula "3"))
(rule "inEqSimp_contradInEq0" (formula "1") (assumesSeqFormula "3"))
(rule "qeq_literals" (formula "1") (term "0"))
(rule "concrete_and_2" (formula "1"))
(rule "closeFalse" (formula "1"))
)
}
