\functions {
    IdentityPrim p;
    Identity id;
    Memory m;
    Struct s;
    Struct t;
    \unique Field f;
    \unique Field g;
    \unique MapField mf;
}

\problem {
    selectSt<[int]>(t, size) <= 1 & selectSt<[int]>(s, size) <= 1
        -> selectSt<[Struct]>(save(s, nil, t), at(1)) = selectSt<[Struct]>(s, at(1))
}
