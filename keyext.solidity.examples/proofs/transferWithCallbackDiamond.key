\programSource "../TestSuite.sol";

\withOptions transferSemantics:withCallback;

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    selfBalance >= 5 -> \<{ transferToOwner()@TestSuite; }\>(true)
}
