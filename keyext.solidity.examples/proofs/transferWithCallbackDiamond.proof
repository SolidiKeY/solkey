\profile "Solidity Profile";

\settings // Proof-Settings-Config-File
{
    "Choice": {
        "integerSimplificationRules": "integerSimplificationRules:full",
        "programRules": "programRules:Solidity",
        "transferSemantics": "transferSemantics:withCallback"
    },
    "Strategy": {
        "ActiveStrategy": "Modular SolidityDL Strategy",
        "MaximumNumberOfAutomaticApplications": 10000,
        "Timeout": -1,
        "options": {
            "AUTO_INDUCTION_OPTIONS_KEY": "AUTO_INDUCTION_OFF",
            "FUNCTION_OPTIONS_KEY": "FUNCTION_CONTRACT",
            "LOOP_OPTIONS_KEY": "LOOP_INVARIANT",
            "NON_LIN_ARITH_OPTIONS_KEY": "NON_LIN_ARITH_NONE",
            "QUANTIFIERS_OPTIONS_KEY": "QUANTIFIERS_NON_SPLITTING_WITH_PROGS",
            "SPLITTING_OPTIONS_KEY": "SPLITTING_DELAYED",
            "STOPMODE_OPTIONS_KEY": "STOPMODE_DEFAULT",
            "USER_TACLETS_OPTIONS_KEY1": "USER_TACLETS_OFF",
            "USER_TACLETS_OPTIONS_KEY2": "USER_TACLETS_OFF",
            "USER_TACLETS_OPTIONS_KEY3": "USER_TACLETS_OFF"
        }
    }
} 

\programSource "../TestSuite.sol";

\withOptions transferSemantics:withCallback;

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}
\problem {
\<{
  transferToOwner()@TestSuite;
}\> true
}

\proof {
(branch "dummy ID"
(rule "functionBodyExpand" (formula "1"))
(rule "localValueDeclInitDrop" (formula "1") (newnames "to"))
(rule "storageRootReadSelect" (formula "1"))
(rule "transferWithCallbackDiamond" (formula "1") (term "1") (inst "storageSk=storageSk_0") (inst "netSk=netSk_0"))
(branch
   (rule "leq_literals" (formula "1") (term "1"))
   (rule "closeTrue" (formula "1"))
)
(branch
   (rule "leq_literals" (formula "1") (term "0,1"))
   (rule "concrete_impl_1" (formula "1") (term "1"))
   (rule "polySimp_elimSub" (formula "1") (term "2,2,0,0,1"))
   (rule "mul_literals" (formula "1") (term "1,2,2,0,0,1"))
   (rule "sequentialToParallel2" (formula "1"))
   (rule "simplifyUpdate2" (formula "1"))
   (rule "applyOnElementary" (formula "1") (term "0"))
   (rule "polySimp_addComm0" (formula "1") (term "2,2,1,0,0"))
   (rule "insertCInv" (formula "1") (term "1"))
   (rule "closeTrue" (formula "1"))
)
(branch
   (rule "leq_literals" (formula "1") (term "0,1"))
   (rule "concrete_impl_1" (formula "1") (term "1"))
   (rule "simplifyUpdate2" (formula "1"))
   (rule "impRight" (formula "1"))
   (rule "simplifyUpdate2" (formula "2"))
   (rule "applyOnRigidFormula" (formula "1"))
   (rule "simplifyUpdate1" (formula "1") (term "1"))
   (rule "simplifyUpdate1" (formula "1") (term "0"))
   (rule "applyOnPV" (formula "1") (term "1"))
   (rule "applyOnPV" (formula "1") (term "0"))
   (rule "insertCInv" (formula "1"))
   (rule "true_left" (formula "1"))
   (rule "functionFrameEmpty" (formula "1") (term "1"))
   (rule "emptyModality" (formula "1") (term "1"))
   (rule "closeTrue" (formula "1"))
)
)
}
