// Showcase: function-body expansion with parameters, a field write and a return value.
//
// expFctBdy(x, y) assigns its first parameter to field f and returns 3. The call
//   res = expFctBdy(a, b)@C;
// is inlined by functionBodyExpand into the parameter bindings, the body and the result
// assignment res = r. The made-up runExpFctBdy rule then discharges that inlined body by its
// net effect (f := a, res := 3) as an update; selectIntOnStore and arithmetic close the goal.
// runExpFctBdy is a visualization (no committed execution semantics), like the other showcases.

\programSource "C.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FunctionBody fbs;
    \formula post;
}

\programVariables {
    int a, b, res;
}

\rules {
    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Execute the inlined body of expFctBdy(a, b): the first argument ends up in field f and the
    // result variable res receives the returned 3. The bound program variables x, y, r match the
    // fresh variables introduced for the parameters and the named return.
    runExpFctBdy {
        \schemaVar \formula post;
        \find(\modality{#mod}{
            uint256 x = a;
            uint256 y = b;
            uint256 r;
            { f = x; r = 3; }
            res = r;
        }\endmodality(post))
        \replacewith({storage := storeSt(storage, C$f, a) || res := 3} post)
        \heuristics(simplify_prog)
    };
}

// With a = 5, after the call field f equals a (= 5) and the result res is 3.
\problem {
    a = 5 & b = 3 ->
    \<{ res = expFctBdy(a,b)@C; }\>(res = 3 & selectSt<[int]>(storage, C$f) = 5)
}
