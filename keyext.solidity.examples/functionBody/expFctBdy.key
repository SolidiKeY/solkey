// Showcase: function-body expansion with parameters, a field write and a return value,
// executed one statement at a time.
//
// expFctBdy(x, y) assigns its first parameter to field f and returns 3. The call
//   res = expFctBdy(a, b)@C;
// is inlined by functionBodyExpand into the parameter bindings, the body and the result
// assignment res = r. The body is then executed statement by statement through context blocks
// (c# ... #c): the parameter declarations become updates, the field write becomes a save
// update and the return/result assignments propagate the value, so res = 3 and field f = a (= 5).
//
// The execution rules below are visualizations (no committed storage/execution semantics), but
// they are general schematic rules: declarations, assignments and field writes are matched with
// program schema variables rather than the concrete program.

\programSource "C.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FunctionBody fbs;
    \program Variable v;
    \program SimpleExpression se;
    \program FieldReference fr;
    \formula post;
}

\programVariables {
    int a, b, res;
}

\rules {
    // local variable declaration with initialiser: T v = se;  -->  {v := se}
    execDeclInit {
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \formula post;
        \find(\modality{#mod}{c# uint256 s#v = s#se; #c}\endmodality(post))
        \replacewith({v := se}\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // declaration without initialiser (the named return r): T v;  -->  (drop)
    execDeclNoInit {
        \schemaVar \program Variable v;
        \schemaVar \formula post;
        \find(\modality{#mod}{c# uint256 s#v; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // field assignment: f = se;  -->  save update on contract storage
    fieldAssign {
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \formula post;
        \find(\modality{#mod}{c# s#fr = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, fr, se)}\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // local variable assignment: v = se;  -->  {v := se}
    varAssign {
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \formula post;
        \find(\modality{#mod}{c# s#v = s#se; #c}\endmodality(post))
        \replacewith({v := se}\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // drop the body block once all its statements have been executed
    execEmptyBlock {
        \schemaVar \formula post;
        \find(\modality{#mod}{c# {} #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

// With a = 5, after the call field f equals a (= 5) and the result res is 3.
\problem {
    a = 5 & b = 3 ->
    \<{ res = expFctBdy(a,b)@C; }\>(res = 3 & find<[int]>(storage, cons(C$f, nil)) = 5)
}
