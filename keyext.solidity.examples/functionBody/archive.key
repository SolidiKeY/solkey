// Showcase: prove a contract field-copy (archived = balance) by inlining the function
// body with functionBodyExpand and discharging it. fieldCopy is a made-up storeSt
// visualization, not a committed storage semantics.

\programSource "Ledger.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FunctionBody fbs;
    \program FieldReference lhs;
    \program FieldReference rhs;
    \formula post;
}

\rules {
    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };

    fieldCopy {
        \schemaVar \program FieldReference lhs;
        \schemaVar \program FieldReference rhs;
        \schemaVar \formula post;
        \find(\modality{#mod}{ { s#lhs = s#rhs; } }\endmodality(post))
        \replacewith({storage := storeSt(storage, lhs, selectSt<[int]>(storage, rhs))} post)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ archive()@Ledger; }\>
        (selectSt<[int]>(storage, Ledger$archived) = selectSt<[int]>(storage, Ledger$balance))
}
