\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int other;
}

// transferNoCallbackBox terminal rule (docs/net.md, Step 3): payTo(a) transfers 5 to its
// parameter, booking net(to) = net(to) - 5 on the empty ledger while any untouched
// address keeps net(other) = 0 (selectSt on mtSt is defaultValue<[int]> = 0). The body is
// loaded from the .sol source and inlined by functionBodyExpand. The box books the debit
// unconditionally; selfBalance = 12 only pins the arithmetic so the debit to 7 is
// checkable, not a funding requirement (net-transfer-unfunded.key drops it entirely; the
// diamond twin owing the funding check is net-transfer-diamond-funded.key).
\problem {
    net = mtSt & !(to = other) & selfBalance = 12 ->
    \[{ payTo(to)@PiggyBankNet; }\]
        (selectSt<[int]>(net, at(to)) = -5 & selectSt<[int]>(net, at(other)) = 0
         & selfBalance = 7)
}
