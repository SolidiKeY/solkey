\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int other;
}

// transferNoCallback terminal rule (docs/net.md, Step 3): payTo(a) transfers 5 to its
// parameter, booking net(to) = net(to) - 5 on the empty ledger while any untouched
// address keeps net(other) = 0 (selectSt on mtSt is defaultValue<[int]> = 0). The body is
// loaded from the .sol source and inlined by functionBodyExpand. The diamond needs the
// contract funded (5 <= selfBalance): an unbacked transfer reverts, and the transfer
// debits the balance.
\problem {
    net = mtSt & !(to = other) & selfBalance = 12 ->
    \<{ payTo(to)@PiggyBankNet; }\>
        (selectSt<[int]>(net, at(to)) = -5 & selectSt<[int]>(net, at(other)) = 0
         & selfBalance = 7)
}
