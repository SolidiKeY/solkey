\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int ownerAddr;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(find<[int]>(s, cons1(PiggyBankNet$balance))
                     = selectSt<[int]>(n, at(ownerAddr)))
        \heuristics(simplify)
    };
}

// The course PiggyBank invariant, "the recorded balance is backed by the owner's net
// deposits" (balance = net(owner)), proven across breakPiggyBank's payout under
// transferSemantics:withCallback. The body - loaded from the .sol source - follows the
// transfer-last discipline (ISoLA 2020, Fig. 5): the balance is zeroed before control
// can leave, so "invariant on exit" closes with 0 = 5 - 5, and "resume after callback"
// closes by assuming the invariant over the havocked storage and ledger. Moving the
// transfer before the storage write reopens the exit branch - the re-entrancy bug of
// Fig. 4.
\problem {
    find<[int]>(storage, cons1(PiggyBankNet$balance)) = 5 &
    find<[int]>(storage, cons1(PiggyBankNet$owner)) = ownerAddr &
    selectSt<[int]>(net, at(ownerAddr)) = 5 ->
    \[{ breakPiggyBank()@PiggyBankNet; }\] CInv(storage, net)
}
