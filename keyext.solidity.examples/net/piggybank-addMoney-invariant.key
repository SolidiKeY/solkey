\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(find<[int]>(s, cons1(PiggyBankNet$balance))
                     = selectSt<[int]>(n, at(msgSender)))
        \heuristics(simplify)
    };
}

// The paper's proof-obligation schema (ISoLA 2020, eq. 4) for addMoney with the
// depositor as owner: assuming msg.value >= 0 and the invariant
// balance = net(msgSender), the calculus first books the incoming payment
// (net(msgSender) += msgValue - funds move before the body runs), then the body
// (balance = balance + msg.value, loaded from the .sol source) adds the same amount to
// the recorded balance, restoring the invariant. Box modality: reverting runs are
// trivially correct.
\problem {
    geq(msgValue, 0) &
    find<[int]>(storage, cons1(PiggyBankNet$balance))
        = selectSt<[int]>(net, at(msgSender)) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)}
    \[{ addMoney()@PiggyBankNet; }\] CInv(storage, net)
}
