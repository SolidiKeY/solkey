\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(selectSt<[int]>(n, at(to)) <= 0)
        \heuristics(simplify)
    };
}

// transferWithCallbackDiamond: on top of the box branches ("invariant on exit" after the
// booking, "resume after callback" over the havocked state) the diamond owes the
// "sufficient funds" goal, closed by the 5 <= selfBalance antecedent. The box twin
// (net-transfer-withcallback-simple.key) needs no funding premise.
\problem {
    selectSt<[int]>(net, at(to)) <= 0 & 5 <= selfBalance ->
    \<{ payTo(to)@PiggyBankNet; }\> CInv(storage, net)
}
