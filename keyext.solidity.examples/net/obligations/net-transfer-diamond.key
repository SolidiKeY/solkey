\programSource "../PiggyBankNet.sol";

\programVariables {
    int to;
}

// transferNoCallbackDiamond: a diamond transfer owes the "non-negative amount" goal,
// closed by the literal 5, and the "transfer succeeds" goal, closed only by the assumed
// transferSucceeds(to, 5) since the calculus tracks neither the contract's balance nor
// whether the receiver accepts; the "transfer booked" goal then debits the ledger. The
// box twin (net-transfer-simple.key) owes nothing.
\problem {
    net = mtSt & !(to = self) & transferSucceeds(to, 5) ->
    \<{ payTo(to)@PiggyBankNet; }\>(selectSt<[int]>(net, at(to)) = -5)
}
