\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
}

// The EVM balance check on transferNoCallback: payTo(to) transfers 5, so a contract
// holding less than 5 reverts. The box discharges the reverting run against any
// postcondition -- false closes exactly because no run survives.
\problem {
    selfBalance < 5 ->
    \[{ payTo(to)@PiggyBankNet; }\](false)
}
