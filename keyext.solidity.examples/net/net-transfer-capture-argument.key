\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int x;
}

// transfer_unfold_rightSndArgument: payToPlus(a, x) transfers a.transfer(x + 2), so the
// nonsimple amount is captured into a fresh value local before transferNoCallback fires.
\problem {
    net = mtSt & x = 3 ->
    \<{ payToPlus(to, x)@PiggyBankNet; }\>(selectSt<[int]>(net, at(to)) = -5)
}
