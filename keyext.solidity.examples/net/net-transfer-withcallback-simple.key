\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(selectSt<[int]>(n, at(to)) <= 0)
        \heuristics(simplify)
    };
}

// transferWithCallbackBox (docs/net.md, Step 4) on a real function: payTo(to) transfers
// 5 with no funding premise. "invariant on exit" proves the invariant after booking
// net(to) -= 5 (net(to) <= 0 stays <= 0 under a debit of 5); "resume after callback"
// havocs storage, net, and selfBalance, assumes the invariant, and closes the empty
// continuation against that assumption. The diamond twin owing the funding check is
// net-transfer-withcallback-diamond-funded.key.
\problem {
    selectSt<[int]>(net, at(to)) <= 0 ->
    \[{ payTo(to)@PiggyBankNet; }\] CInv(storage, net)
}
