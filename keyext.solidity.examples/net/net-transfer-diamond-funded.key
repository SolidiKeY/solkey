\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
}

// transferNoCallbackDiamond: a diamond transfer owes the EVM funding check as the
// "sufficient funds" goal, discharged here by the selfBalance = 12 antecedent; the
// "transfer booked" goal then debits the balance and the ledger. The box twin
// (net-transfer-simple.key) carries no funding requirement.
\problem {
    net = mtSt & selfBalance = 12 ->
    \<{ payTo(to)@PiggyBankNet; }\>
        (selectSt<[int]>(net, at(to)) = -5 & selfBalance = 7)
}
