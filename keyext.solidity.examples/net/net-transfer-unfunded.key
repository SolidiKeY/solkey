\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
}

// transferNoCallbackBox needs no funding: selfBalance is fully symbolic (possibly < 5),
// yet the box books net(to) -= 5 unconditionally - under partial correctness an unfunded
// transfer reverts on the EVM and the run is trivially correct, so the calculus does not
// owe the balance check. The check is the diamond's obligation instead: the negative
// twins under keyext.solidity.core/src/test/resources/.../examples/open/ must stay open.
\problem {
    net = mtSt ->
    \[{ payTo(to)@PiggyBankNet; }\](selectSt<[int]>(net, at(to)) = -5)
}
