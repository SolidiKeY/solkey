\programSource "CasinoNet.sol";

\programVariables {
    int g;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            (!(find<[int]>(s, cons1(CasinoNet$state)) = 2)
             -> selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$operator))))
                + selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$player))))
                  = find<[int]>(s, cons1(CasinoNet$pot)))
            & (find<[int]>(s, cons1(CasinoNet$state)) = 2
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$operator))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$player))))
                    = find<[int]>(s, cons1(CasinoNet$pot))
                      + find<[int]>(s, cons1(CasinoNet$bet))))
        \heuristics(simplify)
    };
}

// Money-conservation PO for placeBet: the player's stake enters the ledger and is
// recorded in bet, moving the conservation equation from the idle to the bet-placed
// shape (sum = pot + bet).
\problem {
    geq(msgValue, 0)
    & !(find<[int]>(storage, cons1(CasinoNet$operator))
        = find<[int]>(storage, cons1(CasinoNet$player)))
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)}
    \[{ placeBet(g)@CasinoNet; }\]
        (CInv(storage, net)
         & find<[int]>(storage, cons1(CasinoNet$state)) = 2
         & find<[int]>(storage, cons1(CasinoNet$bet)) = msgValue)
}
