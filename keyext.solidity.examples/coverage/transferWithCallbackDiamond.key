\programSource "../taclets/Payments.sol";

\withOptions transferSemantics:withCallback;

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    transferSucceeds(select<[int]>(storage, Payments$owner), 5) ->
    \<{ transferToOwner()@Payments; }\>(true)
}
