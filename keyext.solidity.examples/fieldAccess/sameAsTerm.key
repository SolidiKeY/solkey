// ----------------------------------------------------------------------------
// Showcase: the \sameAsTerm variable condition.
//
// Program schema variables may only occur *inside a modality* in \find / \assumes. To refer to
// the value of such a variable as a *term* elsewhere, you declare a \term schema variable and
// tie it to the program schema variable with \sameAsTerm.
//
// Here the field access `fr` lives inside the modality (program side), while `s` is a \term
// schema variable standing for the field's logic constant (term side). The condition
// \sameAsTerm(fr, s) binds `s` to the by-name conversion of `fr` (here Bank$balance), so the
// replacewith can phrase the storage update purely in terms of `s`.
//
// As in the other field example this stays theory-agnostic: the storeSt/selectSt round-trip is
// only a visualization, and the existing struct rule selectIntOnStore closes the goal.
// ----------------------------------------------------------------------------

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \term Field s;
    \formula post;
}

\rules {
    fieldWriteThenReadViaTerm {
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field s;
        \schemaVar \formula post;

        \find(\modality{#mod}{ s#fr = s#se; }\endmodality(post))
        // s is the term form of the program-side field access fr:
        \varcond(\sameAsTerm(fr, s))
        \replacewith({storage := storeSt(storage, s, se)} selectSt<[int]>(storage, s) = se)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ balance = 42; }\>(true)
}
