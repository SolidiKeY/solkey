// Showcase: the \sameAsTerm varcond ties a \term schema variable (path) to a program-side
// field access (fr) so the replacewith can use its term form. Since global roots are now
// represented as single-element Lists (cons(field, nil)), the schema variable is List-sorted.
// save/find are used for storage operations.

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \term List path;
    \formula post;
}

\rules {
    fieldWriteThenReadViaTerm {
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List path;
        \schemaVar \formula post;

        \find(\modality{#mod}{ s#fr = s#se; }\endmodality(post))
        \varcond(\sameAsTerm(fr, path))
        \replacewith({storage := save(storage, path, se)} find<[int]>(storage, path) = se)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ balance = 42; }\>(true)
}
