// Showcase: the \sameAsTerm varcond ties a \term schema variable (s) to a program-side
// field access (fr) so the replacewith can use its term form. storeSt/selectSt here is
// only a visualization.

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \term Field s;
    \formula post;
}

\rules {
    fieldWriteThenReadViaTerm {
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field s;
        \schemaVar \formula post;

        \find(\modality{#mod}{ s#fr = s#se; }\endmodality(post))
        \varcond(\sameAsTerm(fr, s))
        \replacewith({storage := storeSt(storage, s, se)} selectSt<[int]>(storage, s) = se)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ balance = 42; }\>(true)
}
