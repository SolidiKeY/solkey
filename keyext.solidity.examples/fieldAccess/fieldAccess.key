// Showcase: a contract field access (balance) flowing into the logic via the by-name
// field symbol. Since global roots are now represented as single-element List paths
// (cons(field, nil)), the rule uses save/find operations.

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \formula post;
}

\rules {
    fieldAssignStoreThenRead {
        \schemaVar \formula post;
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{ s#fr = s#se; }\endmodality(post))
        \replacewith({storage := save(storage, fr, se)} find<[int]>(storage, fr) = se)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ balance = 42; }\>(true)
}
