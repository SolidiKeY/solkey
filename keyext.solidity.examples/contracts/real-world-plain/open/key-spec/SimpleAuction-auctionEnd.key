// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/SimpleAuction.sol -f auctionEnd --print-problem
\programSource "../../../real-world/SimpleAuction.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // highestBid >= 0 :
            (find<[int]>(s, cons1(SimpleAuction$highestBid)) >= 0)
            // \forall address a; pendingReturns[a] >= 0 :
            & (\forall int a; (find<[int]>(s, cons2(SimpleAuction$pendingReturns, at(a))) >= 0))
            // beneficiary != address(this) :
            & !(find<[int]>(s, cons1(SimpleAuction$beneficiary)) = self))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    // timeNow >= auctionEndTime && !ended :
    & ((find<[int]>(storage, cons1(SimpleAuction$timeNow)) >= find<[int]>(storage, cons1(SimpleAuction$auctionEndTime))) & !(find<[bool]>(storage, cons1(SimpleAuction$ended)) = TRUE))
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ auctionEnd()@SimpleAuction; }\]
        (CInv(storage, net)
         // ended && net(beneficiary) == \old(net(beneficiary)) - \old(highestBid) :
         & ((find<[bool]>(storage, cons1(SimpleAuction$ended)) = TRUE) & (selectSt<[int]>(net, at(find<[int]>(storage, cons1(SimpleAuction$beneficiary)))) = (selectSt<[int]>(oldNet, at(find<[int]>(old, cons1(SimpleAuction$beneficiary)))) - find<[int]>(old, cons1(SimpleAuction$highestBid))))))
}
