// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/SimpleAuction.sol -f withdraw --print-problem
\programSource "../../../real-world/SimpleAuction.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // highestBid >= 0 :
            (find<[int]>(s, cons1(SimpleAuction$highestBid)) >= 0)
            // \forall address a; pendingReturns[a] >= 0 :
            & (\forall int a; (find<[int]>(s, cons2(SimpleAuction$pendingReturns, at(a))) >= 0))
            // beneficiary != address(this) :
            & !(find<[int]>(s, cons1(SimpleAuction$beneficiary)) = self))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw()@SimpleAuction; }\]
        (CInv(storage, net)
         // pendingReturns[msg.sender] == 0 :
         & (find<[int]>(storage, cons2(SimpleAuction$pendingReturns, at(msgSender))) = 0)
         // net(msg.sender) == \old(net(msg.sender)) - \old(pendingReturns[msg.sender]) :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) - find<[int]>(old, cons2(SimpleAuction$pendingReturns, at(msgSender))))))
}
