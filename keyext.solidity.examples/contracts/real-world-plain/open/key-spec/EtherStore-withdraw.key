// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/EtherStore.sol -f withdraw --print-problem
\programSource "../../../real-world/EtherStore.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // \forall address a; balances[a] >= 0 && balances[a] == net(a) :
            (\forall int a; ((find<[int]>(s, cons2(EtherStore$balances, at(a))) >= 0) & (find<[int]>(s, cons2(EtherStore$balances, at(a))) = selectSt<[int]>(n, at(a))))))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw()@EtherStore; }\]
        (CInv(storage, net)
         // \old(balances[msg.sender]) > 0 && balances[msg.sender] == 0 :
         & ((find<[int]>(old, cons2(EtherStore$balances, at(msgSender))) > 0) & (find<[int]>(storage, cons2(EtherStore$balances, at(msgSender))) = 0))
         // net(msg.sender) == \old(net(msg.sender)) - \old(balances[msg.sender]) :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) - find<[int]>(old, cons2(EtherStore$balances, at(msgSender))))))
}
