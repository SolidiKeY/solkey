// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/Purchase.sol -f refundSeller --print-problem
\programSource "../../../real-world/Purchase.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // value >= 0 && seller != buyer :
            ((find<[int]>(s, cons1(Purchase$value)) >= 0) & !(find<[int]>(s, cons1(Purchase$seller)) = find<[int]>(s, cons1(Purchase$buyer))))
            // state == State.Created -> net(seller) == 2 * value && net(buyer) == 0 :
            & ((find<[int]>(s, cons1(Purchase$state)) = 0) -> ((selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$seller)))) = (2 * find<[int]>(s, cons1(Purchase$value)))) & (selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$buyer)))) = 0)))
            // state == State.Locked -> net(seller) == 2 * value && net(buyer) == 2 * value :
            & ((find<[int]>(s, cons1(Purchase$state)) = 1) -> ((selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$seller)))) = (2 * find<[int]>(s, cons1(Purchase$value)))) & (selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$buyer)))) = (2 * find<[int]>(s, cons1(Purchase$value))))))
            // state == State.Release -> net(seller) == 2 * value && net(buyer) == value :
            & ((find<[int]>(s, cons1(Purchase$state)) = 2) -> ((selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$seller)))) = (2 * find<[int]>(s, cons1(Purchase$value)))) & (selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$buyer)))) = find<[int]>(s, cons1(Purchase$value)))))
            // state == State.Inactive -> net(seller) + net(buyer) == 0 :
            & ((find<[int]>(s, cons1(Purchase$state)) = 3) -> ((selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$seller)))) + selectSt<[int]>(n, at(find<[int]>(s, cons1(Purchase$buyer))))) = 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender == seller && state == State.Release :
    & ((msgSender = find<[int]>(storage, cons1(Purchase$seller))) & (find<[int]>(storage, cons1(Purchase$state)) = 2))
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ refundSeller()@Purchase; }\]
        (CInv(storage, net)
         // state == State.Inactive && net(seller) == -value && net(buyer) == value :
         & (((find<[int]>(storage, cons1(Purchase$state)) = 3) & (selectSt<[int]>(net, at(find<[int]>(storage, cons1(Purchase$seller)))) = neg(find<[int]>(storage, cons1(Purchase$value))))) & (selectSt<[int]>(net, at(find<[int]>(storage, cons1(Purchase$buyer)))) = find<[int]>(storage, cons1(Purchase$value)))))
}
