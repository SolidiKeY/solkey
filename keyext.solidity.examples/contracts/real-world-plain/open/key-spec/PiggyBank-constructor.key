// Generated by ./run-key.sh keyext.solidity.examples/contracts/solidikey/PiggyBank.sol -f constructor --print-problem
\programSource "../../../solidikey/PiggyBank.sol";

\programVariables {
    int _owner;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != PiggyBankState.Broken -> balance == net(owner) :
            (!(find<[int]>(s, cons1(PiggyBank$state)) = 2) -> (find<[int]>(s, cons1(PiggyBank$balance)) = selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBank$owner))))))
            // state == PiggyBankState.Broken -> net(owner) == 0 :
            & ((find<[int]>(s, cons1(PiggyBank$state)) = 2) -> (selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBank$owner)))) = 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self) ->
    {storage := mtSt
     || net := storeSt(mtSt, at(msgSender), (selectSt<[int]>(mtSt, at(msgSender)) + msgValue))
     || selfBalance := msgValue}
    \[{ constructor(_owner)@PiggyBank; }\](CInv(storage, net))
}
