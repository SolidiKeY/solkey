// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/TimeLock.sol -f withdraw --print-problem
\programSource "../../../real-world/TimeLock.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // timeNow >= 0 :
            (find<[int]>(s, cons1(TimeLock$timeNow)) >= 0)
            // \forall address a; balances[a] >= 0 && lockTime[a] >= 0 :
            & (\forall int a; ((find<[int]>(s, cons2(TimeLock$balances, at(a))) >= 0) & (find<[int]>(s, cons2(TimeLock$lockTime, at(a))) >= 0))))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw()@TimeLock; }\]
        (CInv(storage, net)
         // \old(balances[msg.sender]) > 0 && timeNow > \old(lockTime[msg.sender]) && balances[msg.sender] == 0 :
         & (((find<[int]>(old, cons2(TimeLock$balances, at(msgSender))) > 0) & (find<[int]>(storage, cons1(TimeLock$timeNow)) > find<[int]>(old, cons2(TimeLock$lockTime, at(msgSender))))) & (find<[int]>(storage, cons2(TimeLock$balances, at(msgSender))) = 0))
         // lockTime[msg.sender] == \old(lockTime[msg.sender]) :
         & (find<[int]>(storage, cons2(TimeLock$lockTime, at(msgSender))) = find<[int]>(old, cons2(TimeLock$lockTime, at(msgSender))))
         // net(msg.sender) == \old(net(msg.sender)) - \old(balances[msg.sender]) :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) - find<[int]>(old, cons2(TimeLock$balances, at(msgSender))))))
}
