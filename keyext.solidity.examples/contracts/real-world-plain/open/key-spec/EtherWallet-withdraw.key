// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/EtherWallet.sol -f withdraw --print-problem
\programSource "../../../real-world/EtherWallet.sol";

\programVariables {
    int _amount;
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & geq(_amount, 0)
    // _amount >= 0 :
    & (_amount >= 0)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw(_amount)@EtherWallet; }\]
        (CInv(storage, net)
         // msg.sender == owner && owner == \old(owner) :
         & ((msgSender = find<[int]>(storage, cons1(EtherWallet$owner))) & (find<[int]>(storage, cons1(EtherWallet$owner)) = find<[int]>(old, cons1(EtherWallet$owner))))
         // net(owner) == \old(net(owner)) - _amount :
         & (selectSt<[int]>(net, at(find<[int]>(storage, cons1(EtherWallet$owner)))) = (selectSt<[int]>(oldNet, at(find<[int]>(old, cons1(EtherWallet$owner)))) - _amount)))
}
