\programVariables {
    int _to;
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ sendViaCall(_to)@SendEther; }\]
        (CInv(storage, net)
         // _to != msg.sender && _to != address(this) -> net(_to) == \old(net(_to)) - msg.value && net(msg.sender) == \old(net(msg.sender)) + msg.value :
         & ((!(_to = msgSender) & !(_to = self)) -> ((selectSt<[int]>(net, at(_to)) = (selectSt<[int]>(oldNet, at(_to)) - msgValue)) & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) + msgValue))))
         // _to == msg.sender -> net(_to) == \old(net(_to)) :
         & ((_to = msgSender) -> (selectSt<[int]>(net, at(_to)) = selectSt<[int]>(oldNet, at(_to))))
         // _to == address(this) -> net(_to) == \old(net(_to)) && net(msg.sender) == \old(net(msg.sender)) + msg.value :
         & ((_to = self) -> ((selectSt<[int]>(net, at(_to)) = selectSt<[int]>(oldNet, at(_to))) & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) + msgValue)))))
}
