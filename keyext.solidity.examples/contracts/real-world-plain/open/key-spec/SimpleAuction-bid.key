// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/SimpleAuction.sol -f bid --print-problem
\programSource "../../../real-world/SimpleAuction.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // highestBid >= 0 :
            (find<[int]>(s, cons1(SimpleAuction$highestBid)) >= 0)
            // \forall address a; pendingReturns[a] >= 0 :
            & (\forall int a; (find<[int]>(s, cons2(SimpleAuction$pendingReturns, at(a))) >= 0))
            // beneficiary != address(this) :
            & !(find<[int]>(s, cons1(SimpleAuction$beneficiary)) = self))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // msg.sender != this :
    & !(msgSender = self)
    // timeNow <= auctionEndTime && msg.value > highestBid :
    & ((find<[int]>(storage, cons1(SimpleAuction$timeNow)) <= find<[int]>(storage, cons1(SimpleAuction$auctionEndTime))) & (msgValue > find<[int]>(storage, cons1(SimpleAuction$highestBid))))
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ bid()@SimpleAuction; }\]
        (CInv(storage, net)
         // highestBidder == msg.sender && highestBid == msg.value :
         & ((find<[int]>(storage, cons1(SimpleAuction$highestBidder)) = msgSender) & (find<[int]>(storage, cons1(SimpleAuction$highestBid)) = msgValue))
         // \old(highestBid) != 0 -> pendingReturns[\old(highestBidder)] == \old(pendingReturns[highestBidder]) + \old(highestBid) :
         & (!(find<[int]>(old, cons1(SimpleAuction$highestBid)) = 0) -> (find<[int]>(storage, cons2(SimpleAuction$pendingReturns, at(find<[int]>(old, cons1(SimpleAuction$highestBidder))))) = (find<[int]>(old, cons2(SimpleAuction$pendingReturns, at(find<[int]>(old, cons1(SimpleAuction$highestBidder))))) + find<[int]>(old, cons1(SimpleAuction$highestBid))))))
}
