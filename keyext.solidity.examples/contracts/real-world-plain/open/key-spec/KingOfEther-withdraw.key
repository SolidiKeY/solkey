// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/KingOfEther.sol -f withdraw --print-problem
\programSource "../../../real-world/KingOfEther.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // balance >= 0 :
            (find<[int]>(s, cons1(KingOfEther$balance)) >= 0)
            // \forall address a; balances[a] >= 0 :
            & (\forall int a; (find<[int]>(s, cons2(KingOfEther$balances, at(a))) >= 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw()@KingOfEther; }\]
        (CInv(storage, net)
         // msg.sender != king && king == \old(king) && balance == \old(balance) :
         & ((!(msgSender = find<[int]>(storage, cons1(KingOfEther$king))) & (find<[int]>(storage, cons1(KingOfEther$king)) = find<[int]>(old, cons1(KingOfEther$king)))) & (find<[int]>(storage, cons1(KingOfEther$balance)) = find<[int]>(old, cons1(KingOfEther$balance))))
         // balances[msg.sender] == 0 :
         & (find<[int]>(storage, cons2(KingOfEther$balances, at(msgSender))) = 0)
         // net(msg.sender) == \old(net(msg.sender)) - \old(balances[msg.sender]) :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) - find<[int]>(old, cons2(KingOfEther$balances, at(msgSender))))))
}
