// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/WETH9.sol -f withdraw --print-problem
\programSource "../../../real-world/WETH9.sol";

\programVariables {
    int wad;
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & geq(wad, 0)
    // wad >= 0 :
    & (wad >= 0)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw(wad)@WETH9; }\]
        (CInv(storage, net)
         // balanceOf[msg.sender] == \old(balanceOf[msg.sender]) - wad :
         & (find<[int]>(storage, cons2(WETH9$balanceOf, at(msgSender))) = (find<[int]>(old, cons2(WETH9$balanceOf, at(msgSender))) - wad))
         // net(msg.sender) == \old(net(msg.sender)) - wad :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) - wad)))
}
