// Generated by ./run-key.sh keyext.solidity.examples/contracts/solidikey/PiggyBank.sol -f addMoney --print-problem
\programSource "../../../solidikey/PiggyBank.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != PiggyBankState.Broken -> balance == net(owner) :
            (!(find<[int]>(s, cons1(PiggyBank$state)) = 2) -> (find<[int]>(s, cons1(PiggyBank$balance)) = selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBank$owner))))))
            // state == PiggyBankState.Broken -> net(owner) == 0 :
            & ((find<[int]>(s, cons1(PiggyBank$state)) = 2) -> (selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBank$owner)))) = 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender == owner && state != PiggyBankState.Broken :
    & ((msgSender = find<[int]>(storage, cons1(PiggyBank$owner))) & !(find<[int]>(storage, cons1(PiggyBank$state)) = 2))
    // state == PiggyBankState.Unused || state == PiggyBankState.InUse :
    & ((find<[int]>(storage, cons1(PiggyBank$state)) = 0) | (find<[int]>(storage, cons1(PiggyBank$state)) = 1))
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ addMoney()@PiggyBank; }\]
        (CInv(storage, net)
         // balance == net(owner) && state == PiggyBankState.InUse :
         & ((find<[int]>(storage, cons1(PiggyBank$balance)) = selectSt<[int]>(net, at(find<[int]>(storage, cons1(PiggyBank$owner))))) & (find<[int]>(storage, cons1(PiggyBank$state)) = 1)))
}
