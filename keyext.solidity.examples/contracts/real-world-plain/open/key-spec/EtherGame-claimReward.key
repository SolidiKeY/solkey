// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/EtherGame.sol -f claimReward --print-problem
\programSource "../../../real-world/EtherGame.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // balance >= 0 && balance <= TARGET_AMOUNT :
            (find<[int]>(s, cons1(EtherGame$balance)) >= 0)
            & (find<[int]>(s, cons1(EtherGame$balance)) <= 7000000000000000000))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ claimReward()@EtherGame; }\]
        (CInv(storage, net)
         // msg.sender == winner && winner == \old(winner) && balance == 0 :
         & (((msgSender = find<[int]>(storage, cons1(EtherGame$winner))) & (find<[int]>(storage, cons1(EtherGame$winner)) = find<[int]>(old, cons1(EtherGame$winner)))) & (find<[int]>(storage, cons1(EtherGame$balance)) = 0))
         // net(msg.sender) == \old(net(msg.sender)) - \old(balance) :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) - find<[int]>(old, cons1(EtherGame$balance)))))
}
