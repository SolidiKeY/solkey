// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/KingOfEther.sol -f claimThrone --print-problem
\programSource "../../../real-world/KingOfEther.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // balance >= 0 :
            (find<[int]>(s, cons1(KingOfEther$balance)) >= 0)
            // \forall address a; balances[a] >= 0 :
            & (\forall int a; (find<[int]>(s, cons2(KingOfEther$balances, at(a))) >= 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ claimThrone()@KingOfEther; }\]
        (CInv(storage, net)
         // msg.value > \old(balance) && king == msg.sender && balance == msg.value :
         & (((msgValue > find<[int]>(old, cons1(KingOfEther$balance))) & (find<[int]>(storage, cons1(KingOfEther$king)) = msgSender)) & (find<[int]>(storage, cons1(KingOfEther$balance)) = msgValue))
         // balances[\old(king)] == \old(balances[king]) + \old(balance) :
         & (find<[int]>(storage, cons2(KingOfEther$balances, at(find<[int]>(old, cons1(KingOfEther$king))))) = (find<[int]>(old, cons2(KingOfEther$balances, at(find<[int]>(old, cons1(KingOfEther$king))))) + find<[int]>(old, cons1(KingOfEther$balance))))
         // \forall address a; a != \old(king) -> balances[a] == \old(balances[a]) :
         & (\forall int a; (!(a = find<[int]>(old, cons1(KingOfEther$king))) -> (find<[int]>(storage, cons2(KingOfEther$balances, at(a))) = find<[int]>(old, cons2(KingOfEther$balances, at(a))))))
         // net(msg.sender) == \old(net(msg.sender)) + msg.value :
         & (selectSt<[int]>(net, at(msgSender)) = (selectSt<[int]>(oldNet, at(msgSender)) + msgValue)))
}
