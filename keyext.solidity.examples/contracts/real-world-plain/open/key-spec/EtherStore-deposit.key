// Generated by ./run-key.sh keyext.solidity.examples/contracts/real-world/EtherStore.sol -f deposit --print-problem
\programSource "../../../real-world/EtherStore.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(n))
        \replacewith(
            // \forall address a; balances[a] >= 0 && balances[a] == net(a) :
            (\forall int a; ((find<[int]>(s, cons2(EtherStore$balances, at(a))) >= 0) & (find<[int]>(s, cons2(EtherStore$balances, at(a))) = selectSt<[int]>(n, at(a))))))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // msg.sender != this :
    & !(msgSender = self)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ deposit()@EtherStore; }\]
        (CInv(storage, net)
         // balances[msg.sender] == \old(balances[msg.sender]) + msg.value :
         & (find<[int]>(storage, cons2(EtherStore$balances, at(msgSender))) = (find<[int]>(old, cons2(EtherStore$balances, at(msgSender))) + msgValue)))
}
