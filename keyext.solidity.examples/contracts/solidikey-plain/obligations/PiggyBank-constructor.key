// Generated by ./run-key.sh keyext.solidity.examples/contracts/solidikey/PiggyBank.sol -f constructor --print-problem
\programSource "../../solidikey/PiggyBank.sol";

\programVariables {
    int _owner;
}

\rules {
    insertCInv {
        \schemaVar \term Struct cinv$s, cinv$n;
        \find(CInv(cinv$s, cinv$n))
        \replacewith(
            // state != PiggyBankState.Broken -> balance == net(owner) :
            (!(find<[int]>(cinv$s, cons1(PiggyBank$state)) = 2) -> (find<[int]>(cinv$s, cons1(PiggyBank$balance)) = selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(PiggyBank$owner))))))
            // state == PiggyBankState.Broken -> net(owner) == 0 :
            & ((find<[int]>(cinv$s, cons1(PiggyBank$state)) = 2) -> (selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(PiggyBank$owner)))) = 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender is an address :
    & ((0 <= msgSender) & (msgSender <= 1461501637330902918203684832716283019655932542975))
    & ((0 <= _owner) & (_owner <= 1461501637330902918203684832716283019655932542975)) ->
    {storage := mtSt
     || net := storeSt(mtSt, at(msgSender), (selectSt<[int]>(mtSt, at(msgSender)) + msgValue))
     || selfBalance := msgValue}
    \[{ constructor(_owner)@PiggyBank; }\](CInv(storage, net))
}
