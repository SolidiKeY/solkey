// Generated by ./run-key.sh keyext.solidity.examples/contracts/solidikey/Escrow.sol -f constructor --print-problem
\programSource "../../solidikey/Escrow.sol";

\programVariables {
    int _sender;
    int _receiver;
    int _delayUntilRelease;
}

\rules {
    insertCInv {
        \schemaVar \term Struct cinv$s, cinv$n;
        \find(CInv(cinv$s, cinv$n))
        \replacewith(
            // sender != receiver :
            !(find<[int]>(cinv$s, cons1(Escrow$sender)) = find<[int]>(cinv$s, cons1(Escrow$receiver)))
            // amountInEscrow == net(sender) + net(receiver) :
            & (find<[int]>(cinv$s, cons1(Escrow$amountInEscrow)) = (selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(Escrow$sender)))) + selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(Escrow$receiver))))))
            // state != State.AwaitingDeposit || net(sender) == 0 :
            & (!(find<[int]>(cinv$s, cons1(Escrow$state)) = 0) | (selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(Escrow$sender)))) = 0))
            // state == State.DepositPlaced || amountInEscrow == 0 :
            & ((find<[int]>(cinv$s, cons1(Escrow$state)) = 1) | (find<[int]>(cinv$s, cons1(Escrow$amountInEscrow)) = 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender is an address :
    & ((0 <= msgSender) & (msgSender <= 1461501637330902918203684832716283019655932542975))
    & (((0 <= _sender) & (_sender <= 1461501637330902918203684832716283019655932542975)) & ((0 <= _receiver) & (_receiver <= 1461501637330902918203684832716283019655932542975)) & ((0 <= _delayUntilRelease) & (_delayUntilRelease <= 115792089237316195423570985008687907853269984665640564039457584007913129639935))) ->
    {storage := mtSt
     || net := storeSt(mtSt, at(msgSender), (selectSt<[int]>(mtSt, at(msgSender)) + msgValue))
     || selfBalance := msgValue}
    \[{ constructor(_sender, _receiver, _delayUntilRelease)@Escrow; }\](CInv(storage, net))
}
