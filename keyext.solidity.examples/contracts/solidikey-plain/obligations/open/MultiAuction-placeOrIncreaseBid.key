// Generated by ./run-key.sh keyext.solidity.examples/contracts/solidikey/MultiAuction.sol -f placeOrIncreaseBid --print-problem
\programSource "../../../solidikey/MultiAuction.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct cinv$s, cinv$n;
        \find(CInv(cinv$s, cinv$n))
        \varcond(\noFreeVarIn(cinv$s), \noFreeVarIn(cinv$n))
        \replacewith(
            // \exists address hb; \forall address a; balances[hb] >= balances[a] && (a != hb && a != auctionOwner -> balances[a] == net(a)) && (state == State.AUCTION_OPEN -> net(auctionOwner) == 0) && balances[hb] == net(hb) + net(auctionOwner) :
            (\exists int hb; ((0 <= hb) & (\forall int a; ((0 <= a) -> ((((find<[int]>(cinv$s, cons2(MultiAuction$balances, at(hb))) >= find<[int]>(cinv$s, cons2(MultiAuction$balances, at(a)))) & ((!(a = hb) & !(a = find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)))) -> (find<[int]>(cinv$s, cons2(MultiAuction$balances, at(a))) = select<[int]>(cinv$n, at(a))))) & ((find<[int]>(cinv$s, cons1(MultiAuction$state)) = 0) -> (select<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)))) = 0))) & (find<[int]>(cinv$s, cons2(MultiAuction$balances, at(hb))) = (select<[int]>(cinv$n, at(hb)) + select<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)))))))))))
            // state == State.AUCTION_OPEN -> \forall address a; (net(a) > 0 -> bidded[a] == true) && ((\exists uint i; i >= 0 && i < bidders.length && bidders[i] == a) <-> bidded[a] == true) :
            & ((find<[int]>(cinv$s, cons1(MultiAuction$state)) = 0) -> (\forall int a; ((0 <= a) -> (((select<[int]>(cinv$n, at(a)) > 0) -> ((find<[bool]>(cinv$s, cons2(MultiAuction$bidded, at(a))) = TRUE) <-> true)) & ((\exists int i; ((0 <= i) & (((i >= 0) & (i < find<[int]>(cinv$s, cons2(MultiAuction$bidders, size)))) & (find<[int]>(cinv$s, cons2(MultiAuction$bidders, at(i))) = a)))) <-> ((find<[bool]>(cinv$s, cons2(MultiAuction$bidded, at(a))) = TRUE) <-> true))))))
            // !(\exists uint i; i >= 0 && i < bidders.length && bidders[i] == auctionOwner) :
            & !(\exists int i; ((0 <= i) & (((i >= 0) & (i < find<[int]>(cinv$s, cons2(MultiAuction$bidders, size)))) & (find<[int]>(cinv$s, cons2(MultiAuction$bidders, at(i))) = find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner))))))
            // balances[auctionOwner] == 0 :
            & (find<[int]>(cinv$s, cons2(MultiAuction$balances, at(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner))))) = 0)
            // auctionOwner != address(this) :
            & !(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)) = self))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(conforms(fieldType(MultiAuction$bidders), select<[Struct]>(s, MultiAuction$bidders)))
        \heuristics(simplify)
    };
}

\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender is an address :
    & (0 <= msgSender)
    // state == State.AUCTION_OPEN && msg.sender != auctionOwner && msg.value > 0 :
    & (((find<[int]>(storage, cons1(MultiAuction$state)) = 0) & !(msgSender = find<[int]>(storage, cons1(MultiAuction$auctionOwner)))) & (msgValue > 0))
    & lenInv(storage)
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := store(net, at(msgSender), (select<[int]>(net, at(msgSender)) + msgValue))}
    \[{ placeOrIncreaseBid()@MultiAuction; }\]
        (CInv(storage, net)
         // balances[msg.sender] == \old(balances[msg.sender]) + msg.value :
         & (find<[int]>(storage, cons2(MultiAuction$balances, at(msgSender))) = (find<[int]>(old, cons2(MultiAuction$balances, at(msgSender))) + msgValue)))
}
