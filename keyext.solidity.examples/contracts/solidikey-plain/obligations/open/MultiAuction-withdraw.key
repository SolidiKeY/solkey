\programSource "../../../solidikey/MultiAuction.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct cinv$s, cinv$n;
        \find(CInv(cinv$s, cinv$n))
        \varcond(\noFreeVarIn(cinv$s), \noFreeVarIn(cinv$n))
        \replacewith(
            // \exists address hb; \forall address a; balances[hb] >= balances[a] && (a != hb && a != auctionOwner -> balances[a] == net(a)) && (state == State.AUCTION_OPEN -> net(auctionOwner) == 0) && balances[hb] == net(hb) + net(auctionOwner) :
            (\exists int hb; (((0 <= hb) & (hb <= 1461501637330902918203684832716283019655932542975)) & (\forall int a; (((0 <= a) & (a <= 1461501637330902918203684832716283019655932542975)) -> ((((find<[int]>(cinv$s, cons2(MultiAuction$balances, at(hb))) >= find<[int]>(cinv$s, cons2(MultiAuction$balances, at(a)))) & ((!(a = hb) & !(a = find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)))) -> (find<[int]>(cinv$s, cons2(MultiAuction$balances, at(a))) = selectSt<[int]>(cinv$n, at(a))))) & ((find<[int]>(cinv$s, cons1(MultiAuction$state)) = 0) -> (selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)))) = 0))) & (find<[int]>(cinv$s, cons2(MultiAuction$balances, at(hb))) = (selectSt<[int]>(cinv$n, at(hb)) + selectSt<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)))))))))))
            // state == State.AUCTION_OPEN -> \forall address a; (net(a) > 0 -> bidded[a] == true) && ((\exists uint i; i >= 0 && i < bidders.length && bidders[i] == a) <-> bidded[a] == true) :
            & ((find<[int]>(cinv$s, cons1(MultiAuction$state)) = 0) -> (\forall int a; (((0 <= a) & (a <= 1461501637330902918203684832716283019655932542975)) -> (((selectSt<[int]>(cinv$n, at(a)) > 0) -> ((find<[bool]>(cinv$s, cons2(MultiAuction$bidded, at(a))) = TRUE) <-> true)) & ((\exists int i; (((0 <= i) & (i <= 115792089237316195423570985008687907853269984665640564039457584007913129639935)) & (((i >= 0) & (i < find<[int]>(cinv$s, cons2(MultiAuction$bidders, size)))) & (find<[int]>(cinv$s, cons2(MultiAuction$bidders, at(i))) = a)))) <-> ((find<[bool]>(cinv$s, cons2(MultiAuction$bidded, at(a))) = TRUE) <-> true))))))
            // !(\exists uint i; i >= 0 && i < bidders.length && bidders[i] == auctionOwner) :
            & !(\exists int i; (((0 <= i) & (i <= 115792089237316195423570985008687907853269984665640564039457584007913129639935)) & (((i >= 0) & (i < find<[int]>(cinv$s, cons2(MultiAuction$bidders, size)))) & (find<[int]>(cinv$s, cons2(MultiAuction$bidders, at(i))) = find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner))))))
            // balances[auctionOwner] == 0 :
            & (find<[int]>(cinv$s, cons2(MultiAuction$balances, at(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner))))) = 0)
            // auctionOwner != address(this) :
            & !(find<[int]>(cinv$s, cons1(MultiAuction$auctionOwner)) = self))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(conforms(fieldType(MultiAuction$bidders), selectSt<[Struct]>(s, MultiAuction$bidders)))
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender is an address :
    & ((0 <= msgSender) & (msgSender <= 1461501637330902918203684832716283019655932542975))
    // state == State.AUCTION_OPEN :
    & (find<[int]>(storage, cons1(MultiAuction$state)) = 0)
    & lenInv(storage)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender), (selectSt<[int]>(net, at(msgSender)) + msgValue))
     || selfBalance := (selfBalance + msgValue)}
    \[{ withdraw()@MultiAuction; }\]
        (CInv(storage, net)
         // net(msg.sender) == 0 :
         & (selectSt<[int]>(net, at(msgSender)) = 0))
}
