// Generated by ./run-key.sh keyext.solidity.examples/contracts/solidikey/Escrow.sol -f withdrawFromEscrow --print-problem
\programSource "../../solidikey/Escrow.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct cinv$s, cinv$n;
        \find(CInv(cinv$s, cinv$n))
        \replacewith(
            // sender != receiver :
            !(find<[int]>(cinv$s, cons1(Escrow$sender)) = find<[int]>(cinv$s, cons1(Escrow$receiver)))
            // amountInEscrow == net(sender) + net(receiver) :
            & (find<[int]>(cinv$s, cons1(Escrow$amountInEscrow)) = (select<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(Escrow$sender)))) + select<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(Escrow$receiver))))))
            // state != State.AwaitingDeposit || net(sender) == 0 :
            & (!(find<[int]>(cinv$s, cons1(Escrow$state)) = 0) | (select<[int]>(cinv$n, at(find<[int]>(cinv$s, cons1(Escrow$sender)))) = 0))
            // state == State.DepositPlaced || amountInEscrow == 0 :
            & ((find<[int]>(cinv$s, cons1(Escrow$state)) = 1) | (find<[int]>(cinv$s, cons1(Escrow$amountInEscrow)) = 0)))
        \heuristics(simplify)
    };
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    // msg.value == 0 :
    (msgValue = 0)
    // msg.sender != this :
    & !(msgSender = self)
    // msg.sender is an address :
    & (0 <= msgSender)
    // releasedByReceiver && releasedBySender && msg.sender == receiver && state == State.DepositPlaced :
    & ((((find<[bool]>(storage, cons1(Escrow$releasedByReceiver)) = TRUE) & (find<[bool]>(storage, cons1(Escrow$releasedBySender)) = TRUE)) & (msgSender = find<[int]>(storage, cons1(Escrow$receiver)))) & (find<[int]>(storage, cons1(Escrow$state)) = 1))
    & CInv(storage, net) ->
    {net := store(net, at(msgSender), (select<[int]>(net, at(msgSender)) + msgValue))}
    \[{ withdrawFromEscrow()@Escrow; }\]
        (CInv(storage, net)
         // net(receiver) == -net(sender) && state == State.Withdrawn :
         & ((select<[int]>(net, at(find<[int]>(storage, cons1(Escrow$receiver)))) = neg(select<[int]>(net, at(find<[int]>(storage, cons1(Escrow$sender)))))) & (find<[int]>(storage, cons1(Escrow$state)) = 2)))
}
