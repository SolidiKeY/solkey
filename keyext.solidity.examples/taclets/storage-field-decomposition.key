\programSource "../TestSuite.sol";

\programVariables {
    int result;
}

\problem {
    (\<{ storageFieldDecompositionWrite()@TestSuite; }\>
        (find<[int]>(storage,
                cons3(TestSuite$alice, TestSuite$Person$account,
                    TestSuite$Account$balance)) = 34))
    &
    (\<{ result = storageFieldDecompositionRead()@TestSuite; }\>
        (result = find<[int]>(storage,
                cons3(TestSuite$alice, TestSuite$Person$account,
                    TestSuite$Account$balance))))
}
