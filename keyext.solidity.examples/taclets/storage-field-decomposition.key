// Pattern-based storage field decomposition:
//   <a.balance = se;> post  ==>  {st := save(st, a·balance, se)} post
//   <v = a.balance;> post   ==>  {v := find(st, a·balance)} post
//
// The base path `a` is matched structurally by the source pattern
// `s#a.balance`; no Java-side normalization block or generated alias is used.

\include "./commonFields.key";

\programSource "PaperStore.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program Path[name=field.global] a;
    \program SimpleExpression se;
    \program Variable v;
    \term List baseFlds;
}

\rules {
    storageFieldWriteSave_decomposeBalance {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.global] a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List baseFlds;

        \find(\modality{#mod}{c# s#a.balance = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(a, baseFlds))
        \replacewith({st := save(st, consr(baseFlds, balance), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind_decomposeBalance {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.global] a;
        \schemaVar \program Variable v;
        \schemaVar \term List baseFlds;

        \find(\modality{#mod}{c# s#v = s#a.balance; #c}\endmodality(post))
        \varcond(\sameAsTerm(a, baseFlds))
        \replacewith({v := find<[int]>(st, consr(baseFlds, balance))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ alice.account.balance = 34; }\>
        (find<[int]>(st, cons3(PaperStore$alice, account, balance)) = 34)
}
