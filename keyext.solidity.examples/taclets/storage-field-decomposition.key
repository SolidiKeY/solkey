\programSource "PaperStore.sol";

\include "./storageRules.key";

\programVariables {
    int result;
}

\problem {
    (\<{ alice.account.balance = 34; }\>
        (find<[int]>(storage,
                cons3(PaperStore$alice, PaperStore$Person$account,
                    PaperStore$Account$balance)) = 34))
    &
    (\<{ result = alice.account.balance; }\>
        (result = find<[int]>(st,
                cons3(PaperStore$alice, PaperStore$Person$account,
                    PaperStore$Account$balance))))
}
