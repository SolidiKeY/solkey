\programSource "../TestSuite.sol";

\programVariables {
    int to;
}

// transferNoCallback terminal rule (docs/net.md, Step 3): sending 5 to a
// simple address receiver books net(to) = net(to) - 5 on the empty ledger.
\problem {
    net = mtSt ->
    \<{ to.transfer(5); }\>(selectSt<[int]>(net, at(to)) = -5)
}
