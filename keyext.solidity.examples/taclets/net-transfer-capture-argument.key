\programSource "PaperStore.sol";

\programVariables {
    int to;
    int x;
}

// transfer_unfold_rightSndArgument: the nonsimple amount x + 2 is captured
// into a fresh value local before transferNoCallback fires.
\problem {
    net = mtSt & x = 3 ->
    \<{ to.transfer(x + 2); }\>(selectSt<[int]>(net, at(to)) = -5)
}
