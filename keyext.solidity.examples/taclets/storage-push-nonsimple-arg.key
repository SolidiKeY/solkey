\programSource "PaperStore.sol";

\programVariables {
    int x;
    int y;
}

\problem {
    find<[int]>(storage, cons2(PaperStore$values, size)) = 2
    & !(at(2) = size)
    & x = 40 & y = 2 ->
        \<{ values.push(x + y); }\>
            (find<[int]>(storage, cons2(PaperStore$values, at(2))) = 42
             & find<[int]>(storage, cons2(PaperStore$values, size)) = 3)
}
