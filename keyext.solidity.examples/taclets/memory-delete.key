\programSource "PaperStore.sol";

\programVariables {
    int result;
    int aliasBalance;
    int newBalance;
}

\problem {
    memory = mtMem ->
        \<{ Person memory carol;
            Account memory acc = carol.account;
            carol.age = 20;
            acc.balance = 100;
            delete carol.age;
            delete carol.account;
            result = carol.age;
            aliasBalance = acc.balance;
            newBalance = carol.account.balance; }\>
        (result = 0 & aliasBalance = 100 & newBalance = 0)
}
