\programSource "../TestSuite.sol";

\problem {
    (\<{ storageFieldDisjointRoots()@TestSuite; }\>
        (find<[int]>(storage, cons2(TestSuite$alice, TestSuite$Person$age)) = 1))
    &
    (\<{ storageFieldDisjointRoots()@TestSuite; }\>
        (find<[int]>(storage, cons2(TestSuite$bob, TestSuite$Person$age)) = 2))
}
