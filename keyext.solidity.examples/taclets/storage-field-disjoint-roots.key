\programSource "PaperStore.sol";

\problem {
    (\<{ alice.age = 1; bob.age = 2; }\>
        (find<[int]>(storage, cons2(PaperStore$alice, PaperStore$Person$age)) = 1))
    &
    (\<{ alice.age = 1; bob.age = 2; }\>
        (find<[int]>(storage, cons2(PaperStore$bob, PaperStore$Person$age)) = 2))
}
