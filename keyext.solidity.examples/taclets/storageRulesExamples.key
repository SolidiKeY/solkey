\programSource "PaperStore.sol";

// Small proof examples for the runnable subset in storageRules.key.

\include "./storageRules.key";

\programVariables {
    int result;
    int i;
    int a;
}

\problem {
    (\<{ age = 12; balance = age; result = balance; }\>(result = 12))
    &
    (\<{ st.age = 34; }\>
        (find<[int]>(storage, cons1(age)) = 34))
    &
    (\<{ matrix[2][3] = 36; }\>
        (find<[int]>(storage, cons3(PaperStore$matrix, at(2), at(3))) = 36))
}
