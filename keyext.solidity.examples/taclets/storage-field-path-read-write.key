\include "./commonFields.key";

// Starter for README part 3: lower a source-level member path to the logic
// path list used by save/find. The Java bridge currently handles member paths
// whose base and field segment are individually convertible by \sameAsTerm.

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program Expression path;
    \program SimpleExpression se;
    \program Variable v;
    \term List flds;
}

\rules {
    storageFieldWriteSave_path {
        \schemaVar \formula post;
        \schemaVar \program Expression path;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List flds;

        \find(\modality{#mod}{c# s#path = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(path, flds))
        \replacewith({st := save(st, flds, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind_path {
        \schemaVar \formula post;
        \schemaVar \program Expression path;
        \schemaVar \program Variable v;
        \schemaVar \term List flds;

        \find(\modality{#mod}{c# s#v = s#path; #c}\endmodality(post))
        \varcond(\sameAsTerm(path, flds))
        \replacewith({v := find<[int]>(st, flds)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\programVariables {
    int result;
}

\problem {
    \<{ st.age = 34; result = st.age; }\>(result = 34)
}
