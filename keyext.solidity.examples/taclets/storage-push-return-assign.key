\programSource "../TestSuite.sol";

\problem {
    find<[int]>(storage, cons2(TestSuite$values, size)) = 2 ->
        \<{ storagePushReturnAssign()@TestSuite; }\>
            (find<[int]>(storage, cons2(TestSuite$values, at(2))) = 42
             & find<[int]>(storage, cons2(TestSuite$values, size)) = 3)
}
