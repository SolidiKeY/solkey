\programSource "PaperStore.sol";

\problem {
    find<[int]>(storage, cons2(PaperStore$values, size)) = 2
    & !(at(1) = size) ->
        \<{ values.pop(); }\>
            (find<[int]>(storage, cons2(PaperStore$values, at(1))) = 0
             & find<[int]>(storage, cons2(PaperStore$values, size)) = 1)
}
