\programSource "../TestSuite.sol";

\problem {
    find<[int]>(storage, cons2(TestSuite$values, size)) = 2 ->
        \<{ storagePopNonempty()@TestSuite; }\>
            (find<[int]>(storage, cons2(TestSuite$values, at(1))) = 0
             & find<[int]>(storage, cons2(TestSuite$values, size)) = 1)
}
