\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\problem {
    memory = mtMem ->
        \<{ Person memory carol;
            Person memory david;
            Account memory pv = david.account;
            carol.account = pv;
            carol.account.balance = 60;
            result = david.account.balance; }\>(result = 60)
}
