// Runnable subset of the Pre-licenciate-paper storage taclets.

\programSource "PaperStore.sol";

\programVariables {
    Struct st;
}

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    storageRootWriteStore {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List lhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath))
        \replacewith({storage := save(storage, lhsPath, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List lhsPath;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath), \sameAsTerm(rootRhs, rhsPath))
        \replacewith({storage := save(storage, lhsPath, find<[int]>(storage, rhsPath))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#v = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsPath))
        \replacewith({v := find<[int]>(storage, rhsPath)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Field write: sp.a = se (simple path only - depth 1, base is ROOT)
    storageFieldWriteSave {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.simple] fieldPath;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#fieldPath = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(fieldPath, pathFields))
        \replacewith({storage := save(storage, pathFields, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Field read: v = sp.a (simple path only - depth 1, base is ROOT)
    storageFieldReadFind {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.simple] fieldPath;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#v = s#fieldPath; #c}\endmodality(post))
        \varcond(\sameAsTerm(fieldPath, pathFields))
        \replacewith({v := find<[int]>(storage, pathFields)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Unfold deep LHS field write: nsp.a = se => T storage sp = nsp; sp.a = se;
    // For depth-2+ paths like alice.account.balance, unfold to introduce a storage alias.
    storageFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.complex] deepPath;
        \schemaVar \program Path[name=field] basePath;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Field fieldName;

        \find(\modality{#mod}{c# s#deepPath = s#se; #c}\endmodality(post))
        \varcond(\pathBase(deepPath, basePath), \pathField(deepPath, fieldName))
        \replacewith(\modality{#mod}{c#
            s#aliasType storage s#sp = s#basePath;
            s#sp.s#fieldName = s#se;
        #c}\endmodality(post))
        \addprogvars(sp)
        \heuristics(simplify_prog)
    };

    // Unfold deep RHS field read: v = nsp.a => T storage sp = nsp; v = sp.a;
    // For depth-2+ paths like alice.account.balance, unfold to introduce a storage alias.
    storageFieldRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.complex] deepPath;
        \schemaVar \program Path[name=field] basePath;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Field fieldName;

        \find(\modality{#mod}{c# s#v = s#deepPath; #c}\endmodality(post))
        \varcond(\pathBase(deepPath, basePath), \pathField(deepPath, fieldName))
        \replacewith(\modality{#mod}{c#
            s#aliasType storage s#sp = s#basePath;
            s#v = s#sp.s#fieldName;
        #c}\endmodality(post))
        \addprogvars(sp)
        \heuristics(simplify_prog)
    };

    // Index write for mappings at root: matrix[i] = se
    storageIndexWriteMappingSave_root {
        \schemaVar \formula post;
        \schemaVar \program FieldReference indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedRoot[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(indexedRootPath, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Index read for mappings at root: v = matrix[i]
    storageIndexReadMappingFind_root {
        \schemaVar \formula post;
        \schemaVar \program FieldReference indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#v = s#indexedRoot[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith({v := find<[int]>(storage, consr(indexedRootPath, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Index write for mappings on decomposed path: matrix[i][j] = se
    storageIndexWriteMappingSave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=index.array.reference] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedBase[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(pathFields, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Index read for mappings on decomposed path: v = matrix[i][j]
    storageIndexReadMappingFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=index.array.reference] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#v = s#indexedBase[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({v := find<[int]>(storage, consr(pathFields, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Storage-alias rules — direct port of storage.md's calculus.
    //
    // The `s#aliasType` SV is display-only per `StatementVariableDeclaration` line 32,
    // so the rules match any user-defined struct type. Discrimination from int-typed
    // reads happens because they only fire on `T storage` declarations (no `storage`
    // keyword on int locals). `s#lp` is `Variable[name=storage]`, which
    // `SolidityToKeyConverter#asStorageAliasType` resorts to `List` so the path-shaped
    // update type-checks.

    // Split decl+init for any storage path on the RHS: `T storage lp = path;`
    // ⇝ `T storage lp; lp = path;`. Direct port of storage.md's
    // `storageLocalDeclInitSplit`. The split is consumed by `storageLocalDeclSkip`
    // for the decl and by `storageLocalRootRebind` / `storageFieldReadBindLocalRoot`
    // for the assignment (selected by RHS shape).
    storageLocalDeclInitSplit {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program StoragePath path;

        \find(\modality{#mod}{c# s#aliasType storage s#lp = s#path; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#lp; s#lp = s#path; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Standalone rebind: `lp = sp;` (lp a List-sorted local storage alias, sp a global root).
    // Covers `alicePath = bob;`. The pattern shape collides with
    // `storageRootReadSelect`, but auto-mode discriminates by sort: lp here is
    // List-sorted (per `SolidityToKeyConverter#asStorageAliasType`), so the int-valued
    // `selectSt<[int]>(…)` update in `storageRootReadSelect` does not type-check.
    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#lp = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsPath))
        \replacewith({lp := rhsPath}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Companion assignment rule for the split when the RHS is a local-rooted field path:
    // `lp = lp2.b;` ⇝ `{lp := lp2 · b}`. Disjoint from `storageFieldReadFind_local` by the
    // `Variable[name=storage]` sort filter on `lp`.
    storageFieldReadBindLocalRoot_local {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=field.local] localFieldPath;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#lp = s#localFieldPath; #c}\endmodality(post))
        \varcond(\sameAsTerm(localFieldPath, pathFields))
        \replacewith({lp := pathFields}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Uninitialized local storage declaration: `T storage lp;` ⇝ skip.
    // Mirrors the Java `variableDeclaration` rule in
    // `key.core/.../javaRules.key:398` — drop the statement and register the
    // declared name via `\addprogvars` so any later sequent reference to
    // `lp` still resolves through the renaming applied by
    // `TacletExecutor#applyAddProgVars`.
    storageLocalDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;

        \find(\modality{#mod}{c# s#aliasType storage s#lp; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lp)
        \heuristics(simplify_prog)
    };

    // Standalone bind of a local storage alias to a global field path:
    // `lp = sp.b;` ⇝ `{lp := sp · b}`. Companion to
    // `storageLocalDeclInitSplit_globalField`, but for assignment without
    // declaration. Disjoint from `storageFieldReadFind_global` by the
    // `Variable[name=storage]` sort filter on `lp`.
    storageFieldReadBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=field.global] globalFieldPath;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#lp = s#globalFieldPath; #c}\endmodality(post))
        \varcond(\sameAsTerm(globalFieldPath, pathFields))
        \replacewith({lp := pathFields}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Copy the value at a global field path into a global root:
    // `gp = sp.b;` ⇝ `{storage := store(storage, gp, find(storage, sp · b))}`.
    // Restricted here to int-valued fields since `find<[int]>` is the
    // available unfolding direction.
    storageFieldReadStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program Path[name=field] globalFieldPath;
        \schemaVar \term List lhsPath;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#rootLhs = s#globalFieldPath; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath),
            \sameAsTerm(globalFieldPath, pathFields))
        \replacewith({storage := save(storage, lhsPath,
                find<[int]>(storage, pathFields))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}
