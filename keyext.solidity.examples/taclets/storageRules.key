// Runnable subset of the Pre-licenciate-paper storage taclets.

\programSource "PaperStore.sol";

\programVariables {
    Struct st;
}

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program Path[name=storage.simple.global] rootLhs;
    \program Path[name=storage.simple.global] rootRhs;
    \program FieldReference indexedRoot;
    \program Path[name=field.local] localFieldPath;
    \program Path[name=field.global] globalFieldPath;
    \program Path[name=index.array.global.reference] indexedBase;
    \program SimpleExpression indexExpr;
    \program SimpleExpression se;
    \program Variable[name=value] v;
    \program Variable[name=storage] lp;
    \program Type aliasType;
    \term Field lhsField;
    \term Field rhsField;
    \term Field indexedRootField;
    \term List pathFields;
    \term int idx;
    \term any firstIdx;
    \term any secondIdx;
}

\rules {
    storageRootWriteStore {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field lhsField;

        \find(\modality{#mod}{c# s#rootLhs = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsField))
        \replacewith({storage := storeSt(storage, lhsField, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program Path[name=storage.simple.global] rootRhs;
        \schemaVar \term Field lhsField;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#rootLhs = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsField), \sameAsTerm(rootRhs, rhsField))
        \replacewith({storage := storeSt(storage, lhsField, selectSt<[int]>(storage, rhsField))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootRhs;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#v = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsField))
        \replacewith({v := selectSt<[int]>(storage, rhsField)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteSave_local {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.local] localFieldPath;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#localFieldPath = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(localFieldPath, pathFields))
        \replacewith({storage := save(storage, pathFields, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind_local {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.local] localFieldPath;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#v = s#localFieldPath; #c}\endmodality(post))
        \varcond(\sameAsTerm(localFieldPath, pathFields))
        \replacewith({v := find<[int]>(storage, pathFields)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteSave_global {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.global] globalFieldPath;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#globalFieldPath = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(globalFieldPath, pathFields))
        \replacewith({storage := save(storage, pathFields, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind_global {
        \schemaVar \formula post;
        \schemaVar \program Path[name=field.global] globalFieldPath;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#v = s#globalFieldPath; #c}\endmodality(post))
        \varcond(\sameAsTerm(globalFieldPath, pathFields))
        \replacewith({v := find<[int]>(storage, pathFields)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_root {
        \schemaVar \formula post;
        \schemaVar \program FieldReference indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field indexedRootField;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedRoot[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootField), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, cons2(indexedRootField, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_root {
        \schemaVar \formula post;
        \schemaVar \program FieldReference indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term Field indexedRootField;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#v = s#indexedRoot[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootField), \sameAsTerm(indexExpr, idx))
        \replacewith({v := find<[int]>(storage, cons2(indexedRootField, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=index.array.global.reference] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedBase[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(pathFields, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=index.array.global.reference] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] v;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#v = s#indexedBase[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({v := find<[int]>(storage, consr(pathFields, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Storage-alias rules (partial port of the paper rules).
    //
    // What works: the three `storageLocalDeclInit*` taclets consume a
    // `T storage lp = rhs;` declaration-with-initializer and produce an
    // update `{lp := <sub-struct-value>}` binding the alias to the
    // value of the source path. The pattern uses
    // `s#aliasType storage s#lp = s#rhs;`; the `Type` schema-variable
    // position is display-only per `StatementVariableDeclaration` line 32,
    // so the rules match any user-defined struct type. Discrimination
    // from int-typed reads happens because they only fire on `T storage`
    // declarations (no `storage` keyword on int locals).
    //
    // What does not yet work and is gated behind the tripwire test
    // method `TacletStarterExamplesTest.aliasExamplesCurrentlyOpen`:
    //
    //   1. Standalone rebind `lp = sp;` (without declaration). The
    //      pattern `s#lp = s#rootRhs;` collides syntactically with the
    //      existing `storageRootReadSelect` rule (which
    //      writes an int). Auto-mode doesn't pick a non-conflicting
    //      rule for the Struct-typed local in this position.
    //
    //   2. Writes through alias-rooted paths don't reduce. After
    //      `{lp := find<[Struct]>(storage, p)}`, a write `lp.b = v;`
    //      lowers via the existing `storageFieldWriteSave_local`
    //      to `save(storage, cons(<sub-struct>, b), v)`. The `cons` first
    //      element is then a Struct value, not a Field constant, so
    //      `findDefinitionCons` can't unfold the path to a chain of
    //      `selectSt`s rooted at the original contract field. Closing
    //      the alias examples needs either a path-as-List representation
    //      for the alias (requires changing the parser so `T storage lp`
    //      is List-sorted) or an extra axiom that rewrites the
    //      `cons(find<[Struct]>(s, p), q)` shape back into a path. Both
    //      are out of scope of the .key-only subset and need Java- or
    //      logic-side support.
    //
    // A `\replacewith` cannot produce a schematic
    // `StatementVariableDeclaration` (see line 23 of that class), which
    // is why the paper's `storageLocalDeclInitSplit` (decl + separate
    // assignment) is collapsed here into one combined taclet per RHS
    // shape.

    // Combined decl+rebind: `T storage lp = sp;` (sp a simple global path).
    // Covers `Person storage p = alice;`.
    storageLocalDeclInitSplit_rootRebind {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple.global] rootRhs;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#aliasType storage s#lp = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsField))
        \replacewith({lp := cons1(rhsField)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Standalone rebind: `lp = sp;` (lp a List-sorted local storage alias, sp a global root).
    // Covers `alicePath = bob;`. The pattern shape collides with
    // `storageRootReadSelect`, but auto-mode discriminates by sort: lp here is
    // List-sorted (per `SolidityToKeyConverter#asStorageAliasType`), so the int-valued
    // `selectSt<[int]>(…)` update in `storageRootReadSelect` does not type-check.
    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple.global] rootRhs;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#lp = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsField))
        \replacewith({lp := cons1(rhsField)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Combined decl+bind on a global field path: `T storage lp = sp.b;`
    // (sp a simple global path, `.b` a member access).
    // Covers `Account storage acc = alice.account;` and similar.
    storageLocalDeclInitSplit_globalField {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=field.global] globalFieldPath;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#aliasType storage s#lp = s#globalFieldPath; #c}\endmodality(post))
        \varcond(
            \sameAsTerm(globalFieldPath, pathFields))
        \replacewith({lp := pathFields}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Combined decl+bind on a local-rooted field path: `T storage lp = lp2.b;`
    // (lp2 itself a local storage alias).
    // Covers `Account storage acc = p.account;`.
    storageLocalDeclInitSplit_localField {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=field.local] localFieldPath;
        \schemaVar \term List pathFields;

        \find(\modality{#mod}{c# s#aliasType storage s#lp = s#localFieldPath; #c}\endmodality(post))
        \varcond(
            \sameAsTerm(localFieldPath, pathFields))
        \replacewith({lp := pathFields}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    findAfterSaveSameDeepPath {
        \schemaVar \term Struct baseSt;
        \schemaVar \term any firstIdx, secondIdx;
        \schemaVar \term int value;

        \find(find<[int]>(save(baseSt, cons(firstIdx, cons(secondIdx, nil)), value),
            cons(firstIdx, cons(secondIdx, nil))))
        \replacewith(value)
        \heuristics(simplify)
    };

}
