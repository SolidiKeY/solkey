\programSource "PaperStore.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(selectSt<[int]>(n, at(to)) <= 0)
        \heuristics(simplify)
    };
}

// transferWithCallback (docs/net.md, Step 4): "invariant on exit" proves the
// invariant after booking net(to) -= 5; "resume after callback" havocs
// storage and net, assumes the invariant, and closes the empty continuation
// against that assumption.
\problem {
    selectSt<[int]>(net, at(to)) <= 0 ->
    \<{ to.transfer(5); }\> CInv(storage, net)
}
