\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\problem {
    0 < find<[int]>(storage, cons2(PaperStore$matrix, size))
    & find<[int]>(storage, cons3(PaperStore$matrix, at(0), size)) = 0
    & !(at(0) = size) ->
        \<{ matrix[0].push(100); matrix[0][0] = 7; result = matrix[0][0]; }\>(result = 7)
}
