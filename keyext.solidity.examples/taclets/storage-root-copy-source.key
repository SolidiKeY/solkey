// Starter implementation of a storage root copy-source rule:
//
// storageRootWriteCopySource:
//   <gp = sp;> post  ==>  {storage := storeSt(storage, gp, selectSt(storage, sp))} post
//
// This is restricted to contract storage fields because full storage paths do
// not yet lower to logic path terms on the Java side.

\programSource "PaperStore.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference lhs;
    \program FieldReference rhs;
    \program SimpleExpression se;
    \program Variable v;
    \term Field lhsField;
    \term Field rhsField;
}

\rules {
    storageRootWriteStore_field {
        \schemaVar \formula post;
        \schemaVar \program FieldReference lhs;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field lhsField;

        \find(\modality{#mod}{c# s#lhs = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(lhs, lhsField))
        \replacewith({storage := storeSt(storage, lhsField, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource_field {
        \schemaVar \formula post;
        \schemaVar \program FieldReference lhs;
        \schemaVar \program FieldReference rhs;
        \schemaVar \term Field lhsField;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(lhs, lhsField), \sameAsTerm(rhs, rhsField))
        \replacewith({storage := storeSt(storage, lhsField, selectSt<[int]>(storage, rhsField))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect_field {
        \schemaVar \formula post;
        \schemaVar \program FieldReference rhs;
        \schemaVar \program Variable v;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#v = s#rhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rhs, rhsField))
        \replacewith({v := selectSt<[int]>(storage, rhsField)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\programVariables {
    int result;
}

\problem {
    \<{ age = 34; balance = age; result = balance; }\>(result = 34)
}
