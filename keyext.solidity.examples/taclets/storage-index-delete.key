\programSource "PaperStore.sol";

\programVariables {
    int result;
    int iv;
}

\rules {
    defaultUintArrayElement {
        \schemaVar \term int iv;
        \find(defaultF(at(iv)))
        \replacewith((any) 0)
        \heuristics(concrete)
    };
}

\problem {
    \<{ values[1] = 7; delete values[1]; result = values[1]; }\>(result = 0)
}
