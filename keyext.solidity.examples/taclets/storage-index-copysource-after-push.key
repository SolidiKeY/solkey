\programSource "../TestSuite.sol";

\problem {
    find<[int]>(storage, cons2(TestSuite$matrix, size)) = 0 ->
        \<{ storageIndexCopysourceAfterPush()@TestSuite; }\>
            (find<[int]>(storage, cons2(TestSuite$matrix, at(0)))
                = find<[int]>(storage, cons1(TestSuite$values)))
}
