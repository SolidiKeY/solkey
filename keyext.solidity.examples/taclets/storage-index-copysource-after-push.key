\programSource "PaperStore.sol";

\problem {
    find<[int]>(storage, cons2(PaperStore$matrix, size)) = 0
    & !(at(0) = size) ->
        \<{ uint[][] storage m = matrix; m.push(); m[0] = values; }\>
            (find<[int]>(storage, cons2(PaperStore$matrix, at(0)))
                = find<[int]>(storage, cons1(PaperStore$values)))
}
