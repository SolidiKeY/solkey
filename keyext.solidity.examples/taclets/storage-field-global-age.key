\programSource "PaperStore.sol";

\include "./storageRules.key";

\programVariables {
    int result;
}

\problem {
    (\<{ alice.age = 34; }\>
        (find<[int]>(storage, cons2(PaperStore$alice, PaperStore$Person$age)) = 34))
    &
    (\<{ result = alice.age; }\>
        (result = find<[int]>(storage, cons2(PaperStore$alice, PaperStore$Person$age))))
}
