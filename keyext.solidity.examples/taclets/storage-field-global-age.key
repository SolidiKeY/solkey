\programSource "../TestSuite.sol";

\programVariables {
    int result;
}

\problem {
    (\<{ storageFieldGlobalAgeWrite()@TestSuite; }\>
        (find<[int]>(storage, cons2(TestSuite$alice, TestSuite$Person$age)) = 34))
    &
    (\<{ result = storageFieldGlobalAgeRead()@TestSuite; }\>
        (result = find<[int]>(storage, cons2(TestSuite$alice, TestSuite$Person$age))))
}
