\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\problem {
    (\<{ alice.account.token.value = 7; }\>
        (find<[int]>(storage,
                consr(cons3(PaperStore$alice, PaperStore$Person$account,
                        PaperStore$Account$token),
                    PaperStore$Token$value)) = 7))
    &
    (\<{ result = alice.account.token.value; }\>
        (result = find<[int]>(storage,
                consr(cons3(PaperStore$alice, PaperStore$Person$account,
                        PaperStore$Account$token),
                    PaperStore$Token$value))))
}
