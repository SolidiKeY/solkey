\programSource "../TestSuite.sol";

\programVariables {
    int result;
}

\problem {
    (\<{ storageFieldDeepValueWrite()@TestSuite; }\>
        (find<[int]>(storage,
                consr(cons3(TestSuite$alice, TestSuite$Person$account,
                        TestSuite$Account$token),
                    TestSuite$Token$value)) = 7))
    &
    (\<{ result = storageFieldDeepValueRead()@TestSuite; }\>
        (result = find<[int]>(storage,
                consr(cons3(TestSuite$alice, TestSuite$Person$account,
                        TestSuite$Account$token),
                    TestSuite$Token$value))))
}
