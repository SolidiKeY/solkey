\programSource "PaperStore.sol";

\programVariables {
    int i;
    int j;
    int x;
    int y;
}

\problem {
    i = 1 & j = 2 & x = 5 & y = 6 &
    3 < find<[int]>(storage, cons3(PaperStore$matrix, at(2), size)) ->
        \<{ matrix[i+1][j+1] = x + y; }\>
            (find<[int]>(storage, cons3(PaperStore$matrix, at(2), at(3))) = 11)
}
