// Starter implementation of root-level storage rules using the Java-supported
// FieldReference schema sort and \sameAsTerm bridge.
//
// storageRootWriteStore:
//   <gp = se;> post  ==>  {storage := storeSt(storage, gp, se)} post
//
// storageRootReadSelect:
//   <v = gp;> post   ==>  {v := selectSt(storage, gp)} post

\programSource "PaperStore.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \term Field fld;
}

\rules {
    storageRootWriteStore_field {
        \schemaVar \formula post;
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field fld;

        \find(\modality{#mod}{c# s#fr = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(fr, fld))
        \replacewith({storage := storeSt(storage, fld, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect_field {
        \schemaVar \formula post;
        \schemaVar \program FieldReference fr;
        \schemaVar \program Variable v;
        \schemaVar \term Field fld;

        \find(\modality{#mod}{c# s#v = s#fr; #c}\endmodality(post))
        \varcond(\sameAsTerm(fr, fld))
        \replacewith({v := selectSt<[int]>(storage, fld)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\programVariables {
    int result;
}

\problem {
    \<{ age = 34; result = age; }\>(result = 34)
}
