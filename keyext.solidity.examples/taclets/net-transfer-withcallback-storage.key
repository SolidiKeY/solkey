\programSource "PaperStore.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(find<[int]>(s, cons1(PaperStore$balance))
                     = selectSt<[int]>(n, at(to)))
        \heuristics(simplify)
    };
}

// Transfer-last discipline (ISoLA 2020 paper, Fig. 5): the storage write
// happens before control can leave, so "invariant on exit" closes with
// 0 = 5 - 5. Swapping the two statements leaves that branch open - the
// re-entrancy bug of Fig. 4.
\problem {
    find<[int]>(storage, cons1(PaperStore$balance)) = 5 &
    selectSt<[int]>(net, at(to)) = 5 ->
    \[{ balance = 0; to.transfer(5); }\] CInv(storage, net)
}
