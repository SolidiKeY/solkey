\programSource "../TestSuite.sol";

\programVariables {
    int result;
}

\problem {
    (1 < find<[int]>(storage, cons2(TestSuite$values, size)) ->
        \<{ storageIndexRootArrayWrite()@TestSuite; }\>
            (find<[int]>(storage, cons2(TestSuite$values, at(1))) = 42))
    &
    (1 < find<[int]>(storage, cons2(TestSuite$values, size)) ->
        \<{ result = storageIndexRootArrayRead()@TestSuite; }\>
            (result = find<[int]>(storage, cons2(TestSuite$values, at(1)))))
}
