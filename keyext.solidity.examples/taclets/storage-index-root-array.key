\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\problem {
    (1 < find<[int]>(storage, cons2(PaperStore$values, size)) ->
        \<{ values[1] = 42; }\>
            (find<[int]>(storage, cons2(PaperStore$values, at(1))) = 42))
    &
    (1 < find<[int]>(storage, cons2(PaperStore$values, size)) ->
        \<{ result = values[1]; }\>
            (result = find<[int]>(storage, cons2(PaperStore$values, at(1)))))
}
