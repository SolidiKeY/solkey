\programSource "PaperStore.sol";

\include "./storageRules.key";

\programVariables {
    int result;
}

\problem {
    (\<{ balances[2] = 99; }\>
        (find<[int]>(storage, cons2(PaperStore$balances, at(2))) = 99))
    &
    (\<{ result = balances[2]; }\>
        (result = find<[int]>(st, cons2(PaperStore$balances, at(2)))))
}
