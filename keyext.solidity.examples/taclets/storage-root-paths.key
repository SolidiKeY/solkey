// Starter implementation of root-level storage rules using the path-aware
// SimpleStoragePath schema sort plus the existing \sameAsTerm bridge.
//
// storageRootWriteStore:
//   <path = se;> post  ==>  {storage := storeSt(storage, path, se)} post
//
// storageRootWriteCopySource:
//   <lhs = rhs;> post  ==>  {storage := storeSt(storage, lhs, selectSt(storage, rhs))} post
//
// storageRootReadSelect:
//   <v = path;> post   ==>  {v := selectSt(storage, path)} post
//
// SimpleStoragePath can classify broader source path shapes, but \sameAsTerm
// currently lowers only supported program elements such as root contract fields.

\programSource "PaperStore.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program SimpleStoragePath lhs;
    \program SimpleStoragePath rhs;
    \program SimpleExpression se;
    \program Variable v;
    \term Field lhsField;
    \term Field rhsField;
}

\rules {
    storageRootWriteStore_simplePath {
        \schemaVar \formula post;
        \schemaVar \program SimpleStoragePath lhs;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term Field lhsField;

        \find(\modality{#mod}{c# s#lhs = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(lhs, lhsField))
        \replacewith({storage := storeSt(storage, lhsField, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource_simplePath {
        \schemaVar \formula post;
        \schemaVar \program SimpleStoragePath lhs;
        \schemaVar \program SimpleStoragePath rhs;
        \schemaVar \term Field lhsField;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(lhs, lhsField), \sameAsTerm(rhs, rhsField))
        \replacewith({storage := storeSt(storage, lhsField, selectSt<[int]>(storage, rhsField))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect_simplePath {
        \schemaVar \formula post;
        \schemaVar \program SimpleStoragePath rhs;
        \schemaVar \program Variable v;
        \schemaVar \term Field rhsField;

        \find(\modality{#mod}{c# s#v = s#rhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rhs, rhsField))
        \replacewith({v := selectSt<[int]>(storage, rhsField)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\programVariables {
    int result;
}

\problem {
    \<{ age = 34; balance = age; result = balance; }\>(result = 34)
}
