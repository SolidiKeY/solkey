\programSource "PaperStore.sol";

\problem {
    \<{ Person storage p = alice;
        Account storage acc = p.account;
        acc.balance = 100;
        p.account.token.value = 3; }\>
       (find<[int]>(storage,
               cons3(PaperStore$alice, PaperStore$Person$account,
                   PaperStore$Account$balance)) = 100)
}
