\programSource "../TestSuite.sol";

// transfer_unfold_leftFstReceiver: the receiver `owner` is a storage read
// (nonsimple), so it is captured into a fresh address local first; the
// storage root-read rule resolves it, then transferNoCallback fires.
\problem {
    net = mtSt & find<[int]>(storage, cons1(TestSuite$owner)) = 7 ->
    \<{ owner.transfer(5); }\>(selectSt<[int]>(net, at(7)) = -5)
}
