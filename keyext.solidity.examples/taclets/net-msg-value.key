\programSource "PaperStore.sol";

\programVariables {
    int paidBy;
    int paid;
}

// msg.sender / msg.value desugar to the built-in program variables
// msgSender / msgValue (docs/net.md, Step 2), so reading them is an
// ordinary local assignment.
\problem {
    \<{ paid = msg.value; paidBy = msg.sender; }\>
        (paid = msgValue & paidBy = msgSender)
}
