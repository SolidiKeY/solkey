\programSource "PaperStore.sol";

\include "./storageRules.key";

\problem {
    (\<{ alice.account.balance = 1; alice.account.token.value = 2; }\>
        (find<[int]>(storage,
                cons3(PaperStore$alice, PaperStore$Person$account,
                    PaperStore$Account$balance)) = 1))
    &
    (\<{ alice.account.balance = 1; alice.account.token.value = 2; }\>
        (find<[int]>(storage,
                consr(cons3(PaperStore$alice, PaperStore$Person$account,
                        PaperStore$Account$token),
                    PaperStore$Token$value)) = 2))
}
