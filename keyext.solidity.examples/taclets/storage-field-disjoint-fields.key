\programSource "../TestSuite.sol";

\problem {
    (\<{ storageFieldDisjointFields()@TestSuite; }\>
        (find<[int]>(storage,
                cons3(TestSuite$alice, TestSuite$Person$account,
                    TestSuite$Account$balance)) = 1))
    &
    (\<{ storageFieldDisjointFields()@TestSuite; }\>
        (find<[int]>(storage,
                consr(cons3(TestSuite$alice, TestSuite$Person$account,
                        TestSuite$Account$token),
                    TestSuite$Token$value)) = 2))
}
