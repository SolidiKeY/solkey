\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\rules {
    defaultPaperStoreAlice {
        \find(defaultF(PaperStore$alice))
        \replacewith((any) mtSt)
        \heuristics(concrete)
    };
    defaultPaperStorePersonAge {
        \find(defaultF(PaperStore$Person$age))
        \replacewith((any) 0)
        \heuristics(concrete)
    };
}

\problem {
    \<{ alice.age = 30; delete alice; result = alice.age; }\>(result = 0)
}
