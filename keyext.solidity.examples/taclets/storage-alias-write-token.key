\programSource "PaperStore.sol";

\include "./storageRules.key";

\problem {
    \<{ Person storage p = alice;
        Account storage acc = p.account;
        acc.balance = 100;
        p.account.token.value = 3; }\>
       (find<[int]>(storage,
               consr(cons3(PaperStore$alice, PaperStore$Person$account,
                       PaperStore$Account$token),
                   PaperStore$Token$value)) = 3)
}
