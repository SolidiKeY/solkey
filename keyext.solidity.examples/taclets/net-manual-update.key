\programSource "../TestSuite.sol";

// Milestone example for the net ledger (docs/net.md, Step 1): no program
// rules involved. Starting from the empty ledger mtSt, a manual update that
// books a payment of 5 from address 1 must yield net(1) = 5 while any other
// address keeps net(a) = 0 (selectSt on mtSt is defaultValue<[int]> = 0).
\problem {
    net = mtSt ->
    {net := storeSt(net, at(1), selectSt<[int]>(net, at(1)) + 5)}
        (selectSt<[int]>(net, at(1)) = 5 & selectSt<[int]>(net, at(2)) = 0)
}
