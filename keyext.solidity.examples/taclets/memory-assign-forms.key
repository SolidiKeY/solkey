\programSource "PaperStore.sol";

\programVariables {
    int r1;
    int r2;
}

\problem {
    memory = mtMem ->
        \<{ alice.age = 27;
            Person memory carol;
            carol = alice;
            alice.age = 30;
            r1 = carol.age;
            uint[] memory xs;
            xs = new uint[](4);
            xs[1] = 33;
            r2 = xs[1]; }\>(r1 = 27 & r2 = 33)
}
