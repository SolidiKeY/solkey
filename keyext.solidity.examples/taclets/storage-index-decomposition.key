// Pattern-based storage index decomposition:
//   <a[i] = se;> post  ==>  {st := save(st, a·i, se)} post
//   <v = a[i];> post   ==>  {v := find(st, a·i)} post
//
// The base path `a` and index `i` are matched structurally by the source
// pattern `s#a[s#i]`; no Java-side normalization block or generated alias is
// used.

\include "./commonFields.key";

\programSource "PaperStore.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program Path[name=index.array.global.reference] a;
    \program SimpleExpression i;
    \program SimpleExpression se;
    \program Variable v;
    \term List baseFlds;
    \term any idx;
}

\rules {
    storageIndexWriteSave_decomposeArrayIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[name=index.array.global.reference] a;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List baseFlds;
        \schemaVar \term any idx;

        \find(\modality{#mod}{c# s#a[s#i] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(a, baseFlds), \sameAsTerm(i, idx))
        \replacewith({st := save(st, consr(baseFlds, idx), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadFind_decomposeArrayIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[name=index.array.global.reference] a;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable v;
        \schemaVar \term List baseFlds;
        \schemaVar \term any idx;

        \find(\modality{#mod}{c# s#v = s#a[s#i]; #c}\endmodality(post))
        \varcond(\sameAsTerm(a, baseFlds), \sameAsTerm(i, idx))
        \replacewith({v := find<[int]>(st, consr(baseFlds, idx))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    findAfterSaveSameIndexedPath2 {
        \schemaVar \term Struct baseSt;
        \schemaVar \term any firstIdx, secondIdx;
        \schemaVar \term int value;

        \find(find<[int]>(save(baseSt, cons(firstIdx, cons(secondIdx, nil)), value),
            cons(firstIdx, cons(secondIdx, nil))))
        \replacewith(value)
        \heuristics(simplify)
    };
}

\programVariables {
    int result;
}

\problem {
    (\<{ matrix[2][3] = 34; }\>
        (find<[int]>(st, cons3(PaperStore$matrix, 2, 3)) = 34))
    &
    (\<{ result = matrix[2][3]; }\>
        (result = find<[int]>(st, cons3(PaperStore$matrix, 2, 3))))
}
