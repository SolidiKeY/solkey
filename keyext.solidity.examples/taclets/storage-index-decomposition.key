\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\problem {
    (\<{ matrix[2][3] = 34; }\>
        (find<[int]>(storage, cons3(PaperStore$matrix, at(2), at(3))) = 34))
    &
    (\<{ result = matrix[2][3]; }\>
        (result = find<[int]>(storage, cons3(PaperStore$matrix, at(2), at(3)))))
}
