\programSource "../TestSuite.sol";

\programVariables {
    int result;
}

\problem {
    (3 < find<[int]>(storage, cons3(TestSuite$matrix, at(2), size)) ->
        \<{ storageIndexDecompositionWrite()@TestSuite; }\>
            (find<[int]>(storage, cons3(TestSuite$matrix, at(2), at(3))) = 34))
    &
    (3 < find<[int]>(storage, cons3(TestSuite$matrix, at(2), size)) ->
        \<{ result = storageIndexDecompositionRead()@TestSuite; }\>
            (result = find<[int]>(storage, cons3(TestSuite$matrix, at(2), at(3)))))
}
