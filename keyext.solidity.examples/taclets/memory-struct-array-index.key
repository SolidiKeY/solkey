\programSource "PaperStore.sol";

\programVariables {
    int result;
}

\problem {
    memory = mtMem ->
        \<{ Basket memory basket;
            uint[] memory xs = new uint[](4);
            basket.items = xs;
            basket.items[1] = 33;
            result = basket.items[1]; }\>(result = 33)
}
