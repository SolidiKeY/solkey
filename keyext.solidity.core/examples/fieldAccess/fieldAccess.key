// ----------------------------------------------------------------------------
// Showcase: moving a contract field access into the logic.
//
// This example demonstrates the (theory-independent) field-symbol infrastructure:
//
//   * A contract state variable (here `balance`) parses to a *purely syntactic*
//     FieldReference in the program — it carries no logic operator.
//   * When a rule moves the field access into the logic (a schema variable bound to it
//     appears in a term), the field's `Field`-sorted constant is looked up lazily *by
//     name* — the lightweight replacement for KeY-Java's `convertToTerm`.
//
// The rule below is a *made-up visualization* of how field assignment could be handled:
// it turns the field write `balance = se;` into a `storeSt` update on contract storage,
// and as a (placeholder) post asserts that reading the field straight back yields the
// written value. It is NOT a commitment to a particular storage semantics — it just shows
// the field symbol flowing into `storeSt`/`selectSt`. The existing struct rule
// `selectIntOnStore` then collapses the round-trip, so the resulting goal closes.
//
// Note the field reference appears in assignment (write) position, not as a statement of
// its own: a bare `balance;` would be a no-op expression statement, so we do not model it.
// ----------------------------------------------------------------------------

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \formula post;
}

\rules {
    fieldAssignStoreThenRead {
        \schemaVar \formula post;
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{ s#fr = s#se; }\endmodality(post))
        // move the field write into a storeSt update on contract storage, and read it back:
        \replacewith({storage := storeSt(storage, fr, se)} selectSt<[int]>(storage, fr) = se)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ balance = 42; }\>(true)
}
