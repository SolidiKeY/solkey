// ----------------------------------------------------------------------------
// Showcase: proving a property of a contract function via function-body expansion.
//
// `archive()` copies one contract field into another (`archived = balance`). The proof:
//   1. functionBodyExpand inlines the call `archive()@Ledger;` to its body;
//   2. the (made-up) fieldCopy rule executes the field-to-field assignment as a `storeSt`
//      update on contract storage;
//   3. the post reads both fields back with `selectSt`, and the existing struct rule
//      selectIntOnStore collapses the round-trip — so the goal closes.
//
// The fieldCopy rule is a visualization (no committed storage semantics); the point is that a
// non-trivial function body is inlined and discharged. Field constants are named `Ledger$<field>`.
// ----------------------------------------------------------------------------

\programSource "Ledger.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FunctionBody fbs;
    \program FieldReference lhs;
    \program FieldReference rhs;
    \formula post;
}

\rules {
    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };

    // execute a field-to-field assignment (the inlined body) as a storeSt update on storage
    fieldCopy {
        \schemaVar \program FieldReference lhs;
        \schemaVar \program FieldReference rhs;
        \schemaVar \formula post;
        \find(\modality{#mod}{ { s#lhs = s#rhs; } }\endmodality(post))
        \replacewith({storage := storeSt(storage, lhs, selectSt<[int]>(storage, rhs))} post)
        \heuristics(simplify_prog)
    };
}

// After archive(), the archived field equals the balance field.
\problem {
    \<{ archive()@Ledger; }\>
        (selectSt<[int]>(storage, Ledger$archived) = selectSt<[int]>(storage, Ledger$balance))
}
