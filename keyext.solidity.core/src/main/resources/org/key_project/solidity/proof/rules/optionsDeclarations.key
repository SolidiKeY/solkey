/*
 * This file contains the known taclet options (aka choices) as well as their documentation.
 */

 \optionsDecl {
    /*! Rules dealing with Solidity language constructs can be turned off by setting this to 'None'. */
    programRules: {Solidity, /*! @choiceIncomplete */ None};

    /*!
    Loading less commonly used rules for (mathematical) integers,
    such as rules for bounded sums and products, modulo, or polynomials,
    can be disabled. If they are loaded, their application in the strategy
    can still be controlled as usual.

    This option is experimental. Depending of your understanding of 'less common',
    you may experience incompleteness.
    */
    integerSimplificationRules: {full, /*! @choiceIncomplete */ minimal}; // TODO: further refine this option

    /*! Semantics of `a.transfer(v)` (docs/net.md). Under either option the
     *  box rule books the debit unconditionally, while the diamond rule
     *  additionally owes the EVM funding check `0 <= v & v <= selfBalance`
     *  as a "sufficient funds" goal. */
    transferSemantics: {
        /*! Gas-limited transfer cannot call back into the contract: only the
         *  net ledger update remains and symbolic execution continues with all
         *  knowledge intact. This is the default option.
         *  @choiceDefaultOption
         */
        noCallback,
        /*! The callee may call back into the contract: the contract invariant
         *  CInv(storage, net) must be proven when control leaves, storage and
         *  net are havocked, and CInv is assumed on resume. */
        withCallback
    };

    /*! How a write through an index, `recv[idx] = rhs`, hoists its non-simple
     *  constituents (docs/storage.md section 5). Both options evaluate in the EVM's
     *  order - right-hand side, then receiver, then index - and differ only in how
     *  many rule applications and temporaries that takes. */
    indexWriteCapture: {
        /*! Two rules per right-hand-side kind: a complex receiver is aliased and the
         *  index left in place, then a non-simple index is captured against the now
         *  simple receiver. Cheaper on `nsp[se] = rhs`, which emits no index
         *  temporary, at the price of two applications on `nsp[nse] = rhs`.
         *  @choiceDefaultOption
         */
        receiverThenIndex,
        /*! One rule per right-hand-side kind, guarded by `\notAllSimple`: right-hand
         *  side, receiver and index are all captured in a single application
         *  whenever either constituent is non-simple. Half as many taclets, and one
         *  application on `nsp[nse] = rhs`, at the price of a redundant index
         *  temporary on `nsp[se] = rhs`. */
        allAtOnce
    };
 }
