\sorts{
 Struct \extends StValue;
 Field;
 MemberField \extends Field;
 MapField \extends Field;
 MapMemberField \extends MapField, MemberField;
 RefField \extends MemberField;
 FixedField \extends MemberField;
 FixedArray \extends Struct;
 DynamicArray \extends Struct;
 Mapping \extends Struct;
 StructType \extends Struct;
}

\functions {
  \unique Struct mt;
  \unique Field at(Prim);
  \unique MapField atMap(int);
  \unique Field size;

  \unique Struct emptyOf<[alpha]>;
  Struct fieldType(MemberField);
}

\predicates {
  conforms(Struct, Struct);
  lenInv(Struct);
}

\programVariables {
   Struct storage;
}
