\schemaVariables {
    \term int base, exp, exp_2;
    \term numbers iz;
}

\rules {

    \lemma
    powConcrete0 {
        \find(pow(base, 0))
        \replacewith(1)
        \heuristics(simplify)
    };

    \lemma
    powConcrete1 {
        \find(pow(base, 1))
        \replacewith(base)
        \heuristics(simplify)
    };

    \lemma
    powSplitFactor {
        \find(pow(base, exp))
        \replacewith(\if(exp >= 0)
                \then(\if(exp >= 1)
                        \then(base * pow(base, exp - 1))
                        \else(1))
                \else(undefinedPow(base, exp)))
    };

    \lemma
    powSplitFactorLiteral {
        \find(pow(base, Z(iz)))
        \replacewith(\if(Z(iz) >= 0)
                \then(\if(Z(iz) >= 1)
                        \then(base * pow(base, Z(iz) - 1))
                        \else(1))
                \else(undefinedPow(base, Z(iz))))
        \heuristics(simplify)
    };

    \lemma
    powAdd {
        \find(pow(base, exp + exp_2))
        \replacewith(\if(exp >= 0 & exp_2 >= 0)
                \then(pow(base, exp) * pow(base, exp_2))
                \else(pow(base, exp + exp_2)))
    };

    \lemma
    powMono {
        \find(pow(base, exp) <= pow(base, exp_2))
        \add(exp >= 0 & exp_2 >= exp & base >= 1 ->
            pow(base, exp) <= pow(base, exp_2) ==>)
    };

    \lemma
    powMonoConcrete {
        \find(pow(base, exp_2) <= -1 + pow(base, exp) ==>)
        \add( ==> exp >= 0 & exp_2 >= exp & base >= 1)
        \heuristics(simplify)
    };

    \lemma
    powMonoConcreteRight {
        \find( ==> pow(base, exp) <= pow(base, exp_2))
        \add( ==> exp >= 0 & exp_2 >= exp & base >= 1)
        \heuristics(concrete)
    };

    \lemma
    powPositive {
        \find(pow(base, exp))
        \sameUpdateLevel
        \add(exp >= 0 & base >= 1 -> pow(base, exp) >= 1 ==>)
        \heuristics(solidity_remainder_bounds)
    };

    \lemma
    powNonNegative {
        \find(pow(base, exp))
        \sameUpdateLevel
        \add(exp >= 0 & base >= 0 -> pow(base, exp) >= 0 ==>)
        \heuristics(solidity_remainder_bounds)
    };

    \lemma
    powPositiveConcrete {
        \find(pow(base, exp) <= -1 ==>)
        \add( ==> exp >= 0 & base >= 1)
        \heuristics(simplify)
    };

    \lemma
    powGeq1Concrete {
        \find(pow(base, exp) <= 0 ==>)
        \add( ==> exp >= 0 & base >= 1)
        \heuristics(simplify)
    };
}
