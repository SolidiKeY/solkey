/*
 * Casts in the logic.
 *
 * Unlike legacy KeY, which uses a sort-depending cast `(C)x` together with the
 * `instance<[C]>` predicates of the Java type system, the Solidity logic uses a
 * *parametric* cast function
 *
 *     alpha cast<[alpha]>(any)
 *
 * that reinterprets a value of any sort as the type parameter `alpha`. It is the
 * counterpart of the parametric `read<[alpha]>` / `default<[alpha]>` functions
 * (see memoryRules.key) and is meant to be inserted by the taclet-application
 * logic (RewriteTacletExecutor) so that a replacewith result of the top sort
 * `any` is given the concrete sort required by its position — e.g. the `\then`
 * branch `v` (sort any) of `readOnWrite` becomes `cast<[alpha]>(v)`.
 *
 * The taclets below are adapted from the cast family in
 * key.core .../proof/rules/genericRules.key (castDel, nested-cast collapse).
 * They are deliberately conservative; please review for soundness.
 */

\sorts {
    \generic alpha;
    \generic beta;
}

\functions {
    alpha cast<[alpha]>(any);
}

\schemaVariables {
    \term any   castArg;
    \term alpha castAlphaArg;
}

\rules {
    // genericRules.key: castDel
    // A cast to a sort the argument already has is the identity. The generic
    // `alpha` is bound by the cast's type parameter, and `castAlphaArg` only
    // matches an argument whose sort already fits `alpha`, so a genuine
    // narrowing cast (e.g. cast<[Identity]>(v) with v : any) is NOT removed.
    castDel {
        \find(cast<[alpha]>(castAlphaArg))
        \replacewith(castAlphaArg)
        \heuristics(simplify, cast_deletion)
    };

    // genericRules.key: nested-cast collapse
    // Casts are the identity on the underlying value, so the outer cast alone
    // determines the resulting sort.
    castCast {
        \find(cast<[alpha]>(cast<[beta]>(castArg)))
        \replacewith(cast<[alpha]>(castArg))
        \heuristics(simplify, cast_deletion)
    };
}
