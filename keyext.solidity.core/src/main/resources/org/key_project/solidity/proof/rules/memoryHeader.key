\sorts{
    Memory;
    Identity \extends MemValue;
    IdentityPrim;
    Shape;
}

\functions {
  \unique Memory mtMem;

  \unique Shape leaf;
  \unique Shape fixedArr(int, Shape);
  \unique Shape dynArr(Shape);
  \unique Shape mapOf(Shape);
  \unique IdentityPrim shaped(IdentityPrim, Shape);
  int sizeOf(Shape);
  Shape shapeAt(Shape, List);
  Shape idShape(Identity);
}

\programVariables {
   Memory memory;
}
