\functions{
    // Memory to Storage
    Struct copyMem(Struct, Memory, Identity);

    // Storage to Memory
    Memory copySt(Memory, IdentityPrim, any);
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field fld, fld1, fld2;
    \term List fxs, flds, xs;
    \term any x, y, z, v, v0, v1;
    \term int iv;
    \term Memory mem;
    \term Struct st;
}

\rules {
    // Memory To Storage
    findOnCopy {
        \find(find<[alpha]>(copyMem(st, mem, id), flds))
        \replacewith(
            \if (!isEmpty(flds) & isPrimitive(last<[Field]>(flds)))
            \then (readR<[alpha]>(mem, id, flds))
            \else (find<[alpha]>(copyMem(st, mem, id), flds))
        )
        \heuristics(simplify_enlarging)
    };

    // Storage to Memory
    readFromCopyToStorageInt {
        \find( read<[int]>(copySt(mem, idp1, st), idC(idp2, fxs), fld) )
        \replacewith (
            \if (idp1 = idp2)
            \then ( find<[int]>(st, consr(fxs, fld)) )
            \else ( read<[int]>(mem, idC(idp2, fxs), fld) )
        )
        \heuristics(simplify_enlarging)
    };

    readFromCopyToStorageBool {
        \find( read<[bool]>(copySt(mem, idp1, st), idC(idp2, fxs), fld) )
        \replacewith (
            \if (idp1 = idp2)
            \then ( find<[bool]>(st, consr(fxs, fld)) )
            \else ( read<[bool]>(mem, idC(idp2, fxs), fld) )
        )
        \heuristics(simplify_enlarging)
    };

    readFromCopyToStorageIdentity {
        \find( read<[Identity]>(copySt(mem, idp1, st), idC(idp2, fxs), fld) )
        \replacewith (
            \if (idp1 = idp2)
            \then ( idC(idp1, consr(fxs, fld)) )
            \else ( read<[Identity]>(mem, idC(idp2, fxs), fld) )
        )
        \heuristics(simplify_enlarging)
    };
}
