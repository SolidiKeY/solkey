\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    Struct save(Struct, List, StValue);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    \unique Field size;

    Struct delNode(Struct);
    alpha delValue<[alpha]>(alpha);
}

\schemaVariables{
    \term Field fld, fld1, fld2;
    \term MapField mf;
    \term IdField idf;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv;
    \term Struct st;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, fld1, v), fld2))
        \replacewith(
            \if (fld1 = fld2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,fld2))
        )
        \heuristics(simplify_enlarging)
    };

    selectIntOnStore {
        \find(selectSt<[int]>(storeSt(st, fld1, iv), fld2))
        \replacewith(
            \if (fld1 = fld2)
            \then (iv)
            \else (selectSt<[int]>(st,fld2))
        )
        \heuristics(simplify)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, fld))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageEmpty {
        \find(save(mtSt, nil, v))
        \replacewith(v)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorage {
        \find(save(mtSt,cons(fld, flds), v))
        \replacewith( storeSt(mtSt, fld, save(mtSt, flds, v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreEmpty {
        \find(save(storeSt(st, fld, v0), nil, v1))
        \replacewith(v1)
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, fld1, v0), cons(fld2, flds), v1))
        \replacewith(
            \if (fld1 = fld2)
            \then ( storeSt(st, fld1,
                \if ( isEmpty(flds) )
                \then ( v1 )
                \else ( save( (Struct)v0, flds, v1) )
            ))
            \else ( storeSt(save(st, cons(fld2, flds), v1), fld1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionCons {
        \find(find<[alpha]>(st, cons(fld, flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, fld) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, fld), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    // lazy
    saveOnEmpty {
        \find(save(st, nil, v))
        \replacewith(v)
        \heuristics(simplify)
    };

    selectOnSaveEmpty {
        \find(selectSt<[alpha]>(save(st,nil,v), fld))
        \replacewith(selectSt<[alpha]>(save(st,flds,v), fld))
        \heuristics(simplify)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st,cons(fld1, flds),v), fld2))
        \replacewith(
            \if(fld1 = fld2)
            \then( (alpha) save(selectSt<[Struct]>(st,fld1), flds, v) )
            \else( selectSt<[alpha]>(st, fld2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delValueStruct {
        \find(delValue<[Struct]>(st))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    delValueDefault {
        \find(delValue<[alpha]>(x))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), idf))
        \replacewith(delNode(selectSt<[Struct]>(st, idf)))
        \heuristics(simplify)
    };

    selectStDelNodeInt {
        \find(selectSt<[int]>(delNode(st), fld))
        \replacewith(defaultValue<[int]>)
        \heuristics(simplify)
    };

    selectStDelNodeBool {
        \find(selectSt<[bool]>(delNode(st), fld))
        \replacewith(defaultValue<[bool]>)
        \heuristics(simplify)
    };
}
