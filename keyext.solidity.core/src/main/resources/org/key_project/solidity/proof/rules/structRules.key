\sorts {
    \generic alphaSt \extends StValue;
    \generic alphaPrim \extends Prim;
    \generic alphaNode \extends Struct;
    \generic alphaFix \extends FixedArray;
    \generic alphaDyn \extends DynamicArray;
    \generic alphaMap \extends Mapping;
    \generic alphaStr \extends StructType;
}

\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    alpha save<[alpha]>(alpha, List, StValue);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    Struct delNode(Struct);
    Struct delNodeIndex(Struct, int);
    alpha delField<[alpha]>(Struct, Field);
    Struct delAt(Struct, List);
}

\schemaVariables{
    \term Field a, a1, a2;
    \term MapField mf;
    \term RefField rf;
    \term FixedField ff;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv, n;
    \term Struct st, src;
    \term Prim pk, pk2;
    \term Struct sh;
    \term alphaFix tFix;
    \term alphaDyn tDyn;
    \term alphaMap tMap;
    \term alphaStr tStr;
    \term MemberField m;
    \skolemTerm int skx;
    \skolemTerm Prim skp;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, a1, v), a2))
        \replacewith(
            \if (a1 = a2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,a2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, a))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    fieldTypeDef {
        \find(fieldType(m))
        \replacewith(#typeOf(m))
        \heuristics(simplify)
    };

        findOnEmptyStorage {
        \find(find<[Struct]>(mtSt, flds))
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnFixedSortLength {
        \find(selectSt<[int]>(tFix, size))
        \replacewith(#typedSelect(selectSt<[int]>(tFix, size)))
        \heuristics(concrete)
    };

    selectOnFindFixed {
        \find(selectSt<[alpha]>(tFix, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tFix, a)))
        \heuristics(simplify)
    };

    selectOnFindDynamic {
        \find(selectSt<[alpha]>(tDyn, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tDyn, a)))
        \heuristics(simplify)
    };

    selectOnFindMapping {
        \find(selectSt<[alpha]>(tMap, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tMap, a)))
        \heuristics(simplify)
    };

    selectOnFindStruct {
        \find(selectSt<[alpha]>(tStr, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tStr, a)))
        \heuristics(simplify)
    };

    // ---- Length invariant: conforms(emptyOf<[T]>, node) ------------------
    conformsEmpty {
        \find(conforms(mtSt, st))
        \replacewith(true)
        \heuristics(concrete)
    };

    conformsOnEmptyStorage {
        \find(conforms(sh, mtSt))
        \replacewith(true)
        \heuristics(concrete)
    };

    conformsStruct {
        \find(conforms(emptyOf<[alphaStr]>, st))
        \replacewith(#structConforms(emptyOf<[alphaStr]>, st))
        \heuristics(simplify)
    };

    conformsDynSize {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \add(0 <= selectSt<[int]>(st, size) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsFixedElem {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(n)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaFix]>), selectSt<[Struct]>(st, at(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsDynElem {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(iv)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaDyn]>), selectSt<[Struct]>(st, at(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsMapElem {
        \assumes(conforms(emptyOf<[alphaMap]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(pk)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaMap]>), selectSt<[Struct]>(st, at(pk))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsFixedElemMap {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[Struct]>(st, atMap(n)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaFix]>), selectSt<[Struct]>(st, atMap(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsDynElemMap {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[Struct]>(st, atMap(iv)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaDyn]>), selectSt<[Struct]>(st, atMap(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    selectStDelNodeLength {
        \find(selectSt<[int]>(delNode(st), size))
        \replacewith(0)
        \heuristics(simplify)
    };

    selectOnSaveNilLength {
        \find(selectSt<[int]>(save<[alphaNode]>(st, nil, src), size))
        \replacewith(#len(src))
        \heuristics(simplify)
    };

    saveOnEmptyStorage {
        \find(save<[Struct]>(mtSt, cons(a1, cons(a2, flds)), v))
        \replacewith( storeSt(mtSt, a1, save<[Struct]>(mtSt, cons(a2, flds), v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageLastPrim {
        \find(save<[Struct]>(mtSt, cons(a, nil), pk))
        \replacewith( storeSt(mtSt, a, pk) )
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageLastStruct {
        \find(save<[Struct]>(mtSt, cons(a, nil), src))
        \replacewith( storeSt(mtSt, a, save<[Struct]>(#typedChild(mtSt, a, mtSt), nil, src)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save<[Struct]>(storeSt(st, a1, v0), cons(a2, cons(a, flds)), v1))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, save<[Struct]>(cast<[Struct]>(v0), cons(a, flds), v1)) )
            \else ( storeSt(save<[Struct]>(st, cons(a2, cons(a, flds)), v1), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreLastPrim {
        \find(save<[Struct]>(storeSt(st, a1, v0), cons(a2, nil), pk))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, pk) )
            \else ( storeSt(save<[Struct]>(st, cons(a2, nil), pk), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreLastStruct {
        \find(save<[Struct]>(storeSt(st, a1, v0), cons(a2, nil), src))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, save<[Struct]>(#typedChild(st, a1, cast<[Struct]>(v0)), nil, src)) )
            \else ( storeSt(save<[Struct]>(st, cons(a2, nil), src), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionElement {
        \find(find<[alpha]>(st, cons(at(pk), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, at(pk)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, at(pk)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionMapElement {
        \find(find<[alpha]>(st, cons(atMap(iv), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, atMap(iv)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, atMap(iv)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionSize {
        \find(find<[alpha]>(st, cons(size, nil)))
        \replacewith(selectSt<[alpha]>(st, size))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberPrim {
        \find(find<[alphaPrim]>(st, cons(m, nil)))
        \replacewith(selectSt<[alphaPrim]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberValue {
        \find(find<[StValue]>(st, cons(m, nil)))
        \replacewith(selectSt<[StValue]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberStruct {
        \find(find<[Struct]>(st, cons(m, nil)))
        \replacewith(selectSt<[Struct]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberCons {
        \find(find<[alpha]>(st, cons(m, cons(a, flds))))
        \replacewith(find<[alpha]>(selectSt<[Struct]>(st, m), cons(a, flds)))
        \heuristics(simplify_enlarging)
    };

    selectOnSaveNilMap {
        \find(selectSt<[Struct]>(save<[alphaNode]>(st, nil, src), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectOnSaveNilMember {
        \find(selectSt<[alphaSt]>(save<[alphaNode]>(st, nil, src), m))
        \replacewith(save<[alphaSt]>(selectSt<[alphaSt]>(st, m), nil, selectSt<[alphaSt]>(src, m)))
        \heuristics(simplify)
    };

    selectOnSaveNilIndex {
        \find(selectSt<[alphaSt]>(save<[alphaNode]>(st, nil, src), at(iv)))
        \replacewith(
            \if(iv < #len(src))
            \then(save<[alphaSt]>(selectSt<[alphaSt]>(st, at(iv)), nil, selectSt<[alphaSt]>(src, at(iv))))
            \else(\if(iv < #len(st))
                  \then(delField<[alphaSt]>(st, at(iv)))
                  \else(selectSt<[alphaSt]>(st, at(iv)))))
        \heuristics(concrete)
    };

    saveNilPrim {
        \find(save<[alphaPrim]>(x, nil, v))
        \replacewith(cast<[alphaPrim]>(v))
        \heuristics(simplify)
    };

    selectOnSave {
        \find(selectSt<[alphaSt]>(save<[alphaNode]>(st, cons(a1, flds), v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( save<[alphaSt]>(selectSt<[alphaSt]>(st, a1), flds, v) )
            \else( selectSt<[alphaSt]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delFieldRef {
        \find(delField<[Struct]>(st, rf))
        \replacewith(delNode(#typedChild(st, rf, selectSt<[Struct]>(st, rf))))
        \heuristics(simplify)
    };

    delFieldFixed {
        \find(delField<[Struct]>(st, ff))
        \replacewith(delNode(#typedChild(st, ff, selectSt<[Struct]>(st, ff))))
        \heuristics(simplify)
    };

    delFieldMap {
        \find(delField<[Struct]>(st, mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    delFieldIndexStruct {
        \find(delField<[Struct]>(st, at(iv)))
        \replacewith(delNode(#typedChild(st, at(iv), selectSt<[Struct]>(st, at(iv)))))
        \heuristics(simplify)
    };

    delFieldDefault {
        \find(delField<[alphaPrim]>(st, a))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), rf))
        \replacewith(delNode(#typedChild(st, rf, selectSt<[Struct]>(st, rf))))
        \heuristics(simplify)
    };

    selectStDelNodeFixed {
        \find(selectSt<[Struct]>(delNode(st), ff))
        \replacewith(delNode(#typedChild(st, ff, selectSt<[Struct]>(st, ff))))
        \heuristics(simplify)
    };

    selectStDelNodeIndexStruct {
        \find(selectSt<[Struct]>(delNode(st), at(iv)))
        \replacewith(delNodeIndex(st, iv))
        \heuristics(simplify)
    };

    selectStDelNodeIndex {
        \find(selectSt<[alpha]>(delNodeIndex(st, iv), a))
        \replacewith(\if(0 <= iv & iv < #len(st))
                     \then(selectSt<[alpha]>(delNode(#typedChild(st, at(iv), selectSt<[Struct]>(st, at(iv)))), a))
                     \else(selectSt<[alpha]>(selectSt<[Struct]>(st, at(iv)), a)))
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeElement {
        \find(selectSt<[alphaPrim]>(delNode(st), at(iv)))
        \replacewith(\if(0 <= iv & iv < #len(st))
                     \then(defaultValue<[alphaPrim]>)
                     \else(selectSt<[alphaPrim]>(st, at(iv))))
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMember {
        \find(selectSt<[alphaPrim]>(delNode(st), m))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    delAtEmpty {
        \find(delAt(st, nil))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    selectOnDelAtCons {
        \find(selectSt<[alpha]>(delAt(st, cons(a1, flds)), a2))
        \replacewith(
            \if(a1 = a2)
            \then( \if(isEmpty(flds))
                   \then( delField<[alpha]>(st, a1) )
                   \else( (alpha) delAt(selectSt<[Struct]>(st, a1), flds) ) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    findStValueCast {
        \find(cast<[alphaSt]>(find<[StValue]>(st, fxs)))
        \replacewith(find<[alphaSt]>(st, fxs))
        \heuristics(simplify)
    };

    selectStValueCast {
        \find(cast<[alphaSt]>(selectSt<[StValue]>(st, a)))
        \replacewith(selectSt<[alphaSt]>(st, a))
        \heuristics(simplify)
    };

    saveStValueCast {
        \find(cast<[alphaSt]>(save<[StValue]>(x, fxs, v)))
        \replacewith(save<[alphaSt]>(cast<[alphaSt]>(x), fxs, v))
        \heuristics(simplify)
    };

    delFieldStValueCast {
        \find(cast<[alphaSt]>(delField<[StValue]>(st, a)))
        \replacewith(delField<[alphaSt]>(st, a))
        \heuristics(simplify)
    };
}
