\sorts {
    \generic alphaSt \extends StValue;
}

\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    Struct save(Struct, List, StValue);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    \unique Field size;

    Struct delNode(Struct);
    alpha delValue<[alpha]>(alpha);
    StValue delAt(Struct, List);
    StValue valAt(Struct, List);
}

\schemaVariables{
    \term Field a, a1, a2;
    \term MapField mf;
    \term IdField idf;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv;
    \term Struct st;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, a1, v), a2))
        \replacewith(
            \if (a1 = a2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,a2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, a))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageEmpty {
        \find(save(mtSt, nil, v))
        \replacewith(v)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorage {
        \find(save(mtSt,cons(a, flds), v))
        \replacewith( storeSt(mtSt, a, save(mtSt, flds, v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreEmpty {
        \find(save(storeSt(st, a, v0), nil, v1))
        \replacewith(v1)
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, a1, v0), cons(a2, flds), v1))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1,
                \if ( isEmpty(flds) )
                \then ( v1 )
                \else ( save( (Struct)v0, flds, v1) )
            ))
            \else ( storeSt(save(st, cons(a2, flds), v1), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionCons {
        \find(find<[alpha]>(st, cons(a, flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, a) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, a), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    // lazy
    saveOnEmpty {
        \find(save(st, nil, v))
        \replacewith(v)
        \heuristics(simplify)
    };

    selectOnSaveEmpty {
        \find(selectSt<[alpha]>(save(st,nil,v), a))
        \replacewith(selectSt<[alpha]>(save(st,flds,v), a))
        \heuristics(simplify)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st,cons(a1, flds),v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( (alpha) save(selectSt<[Struct]>(st,a1), flds, v) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delValueStruct {
        \find(delValue<[Struct]>(st))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    delValueDefault {
        \find(delValue<[alphaSt]>(x))
        \replacewith(defaultValue<[alphaSt]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), idf))
        \replacewith(delNode(selectSt<[Struct]>(st, idf)))
        \heuristics(simplify)
    };

    selectStDelNodeDefault {
        \find(selectSt<[alphaSt]>(delNode(st), a))
        \replacewith(defaultValue<[alphaSt]>)
        \heuristics(simplify_enlarging)
    };

    delAtStruct {
        \find(cast<[Struct]>(delAt(st, fxs)))
        \replacewith(delNode(find<[Struct]>(st, fxs)))
        \heuristics(simplify)
    };

    delAtPrim {
        \find(cast<[alphaSt]>(delAt(st, fxs)))
        \replacewith(defaultValue<[alphaSt]>)
        \heuristics(simplify_enlarging)
    };

    valAtFind {
        \find(cast<[alphaSt]>(valAt(st, fxs)))
        \replacewith(find<[alphaSt]>(st, fxs))
        \heuristics(simplify)
    };
}
