\sorts {
    \generic alphaSt \extends StValue;
    \generic alphaPrim \extends Prim;
}

\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    Struct save(Struct, List, StValue);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    Struct delNode(Struct);
    Struct delNodeIndex(Struct, int);
    Struct delNodeFixed(Struct);
    alpha delField<[alpha]>(Struct, Field);
    Struct delAt(Struct, List);
}

\schemaVariables{
    \term Field a, a1, a2;
    \term MapField mf;
    \term RefField rf;
    \term FixedField ff;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv, n;
    \term Struct st, src;
    \term Prim pk;
    \term Shape sh, sh1;
    \term MemberField m;
    \skolemTerm int skx;
    \skolemTerm Prim skp;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, a1, v), a2))
        \replacewith(
            \if (a1 = a2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,a2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, a))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    fieldShapeDef {
        \find(fieldShape(m))
        \replacewith(#shapeOf(m))
        \heuristics(simplify)
    };

    // ---- A shape is its own empty node: the constructor's starting storage -----------
    selectOnShapeSize {
        \find(selectSt<[int]>(sh, size))
        \replacewith(sizeOf(sh))
        \heuristics(concrete)
    };

    selectOnShapeStruct {
        \find(selectSt<[Struct]>(sh, a))
        \replacewith(shapeAt(sh, cons(a, nil)))
        \heuristics(simplify)
    };

    selectOnShapeElement {
        \find(selectSt<[alphaPrim]>(sh, at(pk)))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectOnShapeMember {
        \find(selectSt<[alphaPrim]>(sh, m))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    // ---- Layout invariant: shapeInv(shape, node) ------------------------------
    shapeInvLeaf {
        \find(shapeInv(leaf, st))
        \replacewith(true)
        \heuristics(concrete)
    };

    shapeInvSelf {
        \find(shapeInv(sh, sh))
        \replacewith(true)
        \heuristics(concrete)
    };

    shapeInvFixedSize {
        \assumes(shapeInv(fixedArr(iv, sh), st) ==>)
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \replacewith(iv)
        \heuristics(simplify)
    };

    shapeInvDynSize {
        \assumes(shapeInv(dynArr(sh), st) ==>)
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \add(0 <= selectSt<[int]>(st, size) ==>)
        \heuristics(inReachableStateImplication)
    };

    shapeInvFixedElem {
        \assumes(shapeInv(fixedArr(iv, sh), st) ==>)
        \find(selectSt<[Struct]>(st, at(n)))
        \sameUpdateLevel
        \add(shapeInv(sh, selectSt<[Struct]>(st, at(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    shapeInvDynElem {
        \assumes(shapeInv(dynArr(sh), st) ==>)
        \find(selectSt<[Struct]>(st, at(iv)))
        \sameUpdateLevel
        \add(shapeInv(sh, selectSt<[Struct]>(st, at(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    shapeInvMapElem {
        \assumes(shapeInv(mapOf(sh), st) ==>)
        \find(selectSt<[Struct]>(st, at(pk)))
        \sameUpdateLevel
        \add(shapeInv(sh, selectSt<[Struct]>(st, at(pk))) ==>)
        \heuristics(inReachableStateImplication)
    };

    shapeInvFixedElemMap {
        \assumes(shapeInv(fixedArr(iv, sh), st) ==>)
        \find(selectSt<[Struct]>(st, atMap(n)))
        \sameUpdateLevel
        \add(shapeInv(sh, selectSt<[Struct]>(st, atMap(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    shapeInvDynElemMap {
        \assumes(shapeInv(dynArr(sh), st) ==>)
        \find(selectSt<[Struct]>(st, atMap(iv)))
        \sameUpdateLevel
        \add(shapeInv(sh, selectSt<[Struct]>(st, atMap(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    shapeInvSaveRight {
        \find(==> shapeInv(sh, save(st, cons(a, flds), v)))
        \replacewith(==> shapeInv(sh, st)
                        & shapeInvSaveAt(sh, st, cons(a, flds), v, last<[Field]>(cons(a, flds))))
        \heuristics(simplify)
    };

    shapeInvSaveAtSize {
        \find(shapeInvSaveAt(sh, st, flds, v, size))
        \replacewith(0 <= cast<[int]>(v) & !fixed(find<[Struct]>(st, firsts(flds))))
        \heuristics(simplify)
    };

    shapeInvSaveAtIndex {
        \find(shapeInvSaveAt(sh, st, flds, v, at(pk)))
        \replacewith(shapeInv(shapeAt(sh, flds), save(find<[Struct]>(st, flds), nil, v)))
        \heuristics(simplify)
    };

    shapeInvSaveAtMapIndex {
        \find(shapeInvSaveAt(sh, st, flds, v, atMap(iv)))
        \replacewith(shapeInv(shapeAt(sh, flds), save(find<[Struct]>(st, flds), nil, v)))
        \heuristics(simplify)
    };

    shapeInvSaveAtMember {
        \find(shapeInvSaveAt(sh, st, flds, v, m))
        \replacewith(shapeInv(shapeAt(sh, flds), save(find<[Struct]>(st, flds), nil, v)))
        \heuristics(simplify)
    };

    shapeInvSaveLengthRight {
        \find(==> shapeInv(dynArr(sh), save(st, cons(size, nil), iv)))
        \replacewith(==> shapeInv(dynArr(sh), st) & 0 <= iv)
        \heuristics(concrete)
    };

    shapeInvStoreRight {
        \find(==> shapeInv(sh, storeSt(st, a, v)))
        \replacewith(==> !(a = size)
                        & shapeInv(sh, st)
                        & shapeInv(shapeAt(sh, cons(a, nil)), cast<[Struct]>(v)))
        \heuristics(simplify)
    };

    shapeInvDelAtRight {
        \find(==> shapeInv(sh, delAt(st, cons(a, flds))))
        \replacewith(==> shapeInv(sh, st)
                        & (last<[Field]>(cons(a, flds)) = size
                           -> !fixed(find<[Struct]>(st, firsts(cons(a, flds))))))
        \heuristics(simplify)
    };

    shapeInvDelNodeRight {
        \find(==> shapeInv(sh, delNode(st)))
        \replacewith(==> shapeInv(sh, st))
        \heuristics(simplify)
    };

    shapeInvDelNodeFixedRight {
        \find(==> shapeInv(fixedArr(iv, sh), delNodeFixed(st)))
        \replacewith(==> shapeInv(fixedArr(iv, sh), st))
        \heuristics(simplify)
    };

    shapeInvFixedRight {
        \find(==> shapeInv(fixedArr(iv, sh), st))
        \varcond(\newDependingOn(skx, st))
        \replacewith(==> fixed(st)
                        & selectSt<[int]>(st, size) = iv
                        & shapeInv(sh, selectSt<[Struct]>(st, at(skx)))
                        & shapeInv(sh, selectSt<[Struct]>(st, atMap(skx))))
        \heuristics(shapeInvUnfold)
    };

    shapeInvDynRight {
        \find(==> shapeInv(dynArr(sh), st))
        \varcond(\newDependingOn(skx, st))
        \replacewith(==> !fixed(st)
                        & 0 <= selectSt<[int]>(st, size)
                        & shapeInv(sh, selectSt<[Struct]>(st, at(skx)))
                        & shapeInv(sh, selectSt<[Struct]>(st, atMap(skx))))
        \heuristics(shapeInvUnfold)
    };

    shapeInvMapRight {
        \find(==> shapeInv(mapOf(sh), st))
        \varcond(\newDependingOn(skp, st))
        \replacewith(==> shapeInv(sh, selectSt<[Struct]>(st, at(skp))))
        \heuristics(shapeInvUnfold)
    };

    // ---- Which kind of array a node is: decided by its shape -----------------
    fixedSave {
        \find(fixed(save(st, flds, v)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedStore {
        \find(fixed(storeSt(st, a, v)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedDelNode {
        \find(fixed(delNode(st)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedDelNodeFixed {
        \find(fixed(delNodeFixed(st)))
        \replacewith(true)
        \heuristics(simplify)
    };

    fixedDelAt {
        \find(fixed(delAt(st, flds)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedShapeFixed {
        \find(fixed(fixedArr(iv, sh)))
        \replacewith(true)
        \heuristics(simplify)
    };

    fixedShapeDyn {
        \find(fixed(dynArr(sh)))
        \replacewith(false)
        \heuristics(simplify)
    };

    fixedEmpty {
        \find(fixed(mtSt))
        \replacewith(false)
        \heuristics(simplify)
    };

    shapeInvFixedIsFixed {
        \assumes(shapeInv(fixedArr(iv, sh), st) ==>)
        \find(fixed(st))
        \sameUpdateLevel
        \replacewith(true)
        \heuristics(simplify)
    };

    shapeInvDynIsNotFixed {
        \assumes(shapeInv(dynArr(sh), st) ==>)
        \find(fixed(st))
        \sameUpdateLevel
        \replacewith(false)
        \heuristics(simplify)
    };

    selectStDelNodeSize {
        \find(selectSt<[int]>(delNode(st), size))
        \replacewith(\if(fixed(st)) \then(selectSt<[int]>(st, size)) \else(0))
        \heuristics(simplify)
    };

    selectOnSaveEmptySize {
        \find(selectSt<[int]>(save(st, nil, v), size))
        \replacewith(\if(fixed(st))
                     \then(selectSt<[int]>(st, size))
                     \else(selectSt<[int]>(cast<[Struct]>(v), size)))
        \heuristics(simplify)
    };

    saveOnEmptyStorage {
        \find(save(mtSt,cons(a, flds), v))
        \replacewith( storeSt(mtSt, a, save(mtSt, flds, v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, a1, v0), cons(a2, flds), v1))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, save((Struct) v0, flds, v1)) )
            \else ( storeSt(save(st, cons(a2, flds), v1), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionElement {
        \find(find<[alpha]>(st, cons(at(pk), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, at(pk)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, at(pk)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionMapElement {
        \find(find<[alpha]>(st, cons(atMap(iv), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, atMap(iv)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, atMap(iv)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionSize {
        \find(find<[alpha]>(st, cons(size, nil)))
        \replacewith(selectSt<[alpha]>(st, size))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberPrim {
        \find(find<[alphaPrim]>(st, cons(m, nil)))
        \replacewith(selectSt<[alphaPrim]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberValue {
        \find(find<[StValue]>(st, cons(m, nil)))
        \replacewith(selectSt<[StValue]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberStruct {
        \find(find<[Struct]>(st, cons(m, nil)))
        \replacewith(selectSt<[Struct]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberCons {
        \find(find<[alpha]>(st, cons(m, cons(a, flds))))
        \replacewith(find<[alpha]>(selectSt<[Struct]>(st, m), cons(a, flds)))
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyPrim {
        \find(cast<[alphaPrim]>(save(st, nil, v)))
        \replacewith(cast<[alphaPrim]>(v))
        \heuristics(simplify_enlarging)
    };

    selectOnSaveEmptyMap {
        \find(selectSt<[Struct]>(save(st, nil, v), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectOnSaveEmptyRef {
        \find(selectSt<[Struct]>(save(st, nil, v), rf))
        \replacewith(save(selectSt<[Struct]>(st, rf), nil, selectSt<[Struct]>(cast<[Struct]>(v), rf)))
        \heuristics(simplify)
    };

    selectOnSaveEmptyFixed {
        \find(selectSt<[Struct]>(save(st, nil, v), ff))
        \replacewith(save(selectSt<[Struct]>(st, ff), nil,
                         selectSt<[Struct]>(cast<[Struct]>(v), ff)))
        \heuristics(simplify)
    };

    selectOnSaveEmptyIndexStruct {
        \find(selectSt<[Struct]>(save(st, nil, v), at(iv)))
        \replacewith(
            \if(iv < selectSt<[int]>(cast<[Struct]>(v), size))
            \then(save(selectSt<[Struct]>(st, at(iv)), nil,
                       selectSt<[Struct]>(cast<[Struct]>(v), at(iv))))
            \else(\if(iv < selectSt<[int]>(st, size))
                  \then(delNode(selectSt<[Struct]>(st, at(iv))))
                  \else(selectSt<[Struct]>(st, at(iv)))))
        \heuristics(simplify)
    };

    selectOnSaveEmptyIndexPrim {
        \find(selectSt<[alphaPrim]>(save(st, nil, v), at(iv)))
        \replacewith(
            \if(iv < selectSt<[int]>(cast<[Struct]>(v), size))
            \then(selectSt<[alphaPrim]>(cast<[Struct]>(v), at(iv)))
            \else(\if(iv < selectSt<[int]>(st, size))
                  \then(defaultValue<[alphaPrim]>)
                  \else(selectSt<[alphaPrim]>(st, at(iv)))))
        \heuristics(concrete)
    };

    selectOnSaveEmptyMember {
        \find(selectSt<[alphaPrim]>(save(st, nil, v), m))
        \replacewith(selectSt<[alphaPrim]>(cast<[Struct]>(v), m))
        \heuristics(simplify_enlarging)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st,cons(a1, flds),v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( cast<[alpha]>(save(selectSt<[Struct]>(st,a1), flds, v)) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delFieldRef {
        \find(delField<[Struct]>(st, rf))
        \replacewith(delNode(selectSt<[Struct]>(st, rf)))
        \heuristics(simplify)
    };

    delFieldFixed {
        \find(delField<[Struct]>(st, ff))
        \replacewith(delNodeFixed(selectSt<[Struct]>(st, ff)))
        \heuristics(simplify)
    };

    delFieldMap {
        \find(delField<[Struct]>(st, mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    delFieldIndexStruct {
        \find(delField<[Struct]>(st, at(iv)))
        \replacewith(delNode(selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    delFieldDefault {
        \find(delField<[alphaPrim]>(st, a))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), rf))
        \replacewith(delNode(selectSt<[Struct]>(st, rf)))
        \heuristics(simplify)
    };

    selectStDelNodeFixed {
        \find(selectSt<[Struct]>(delNode(st), ff))
        \replacewith(delNodeFixed(selectSt<[Struct]>(st, ff)))
        \heuristics(simplify)
    };

    selectStDelNodeIndexStruct {
        \find(selectSt<[Struct]>(delNode(st), at(iv)))
        \replacewith(delNodeIndex(st, iv))
        \heuristics(simplify)
    };

    selectStDelNodeIndex {
        \find(selectSt<[alpha]>(delNodeIndex(st, iv), a))
        \replacewith(\if(0 <= iv & iv < selectSt<[int]>(st, size))
                     \then(selectSt<[alpha]>(delNode(selectSt<[Struct]>(st, at(iv))), a))
                     \else(selectSt<[alpha]>(selectSt<[Struct]>(st, at(iv)), a)))
        \heuristics(simplify_enlarging)
    };

    fixedDelNodeIndex {
        \find(fixed(delNodeIndex(st, iv)))
        \replacewith(fixed(selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    shapeInvDelNodeIndexRight {
        \find(==> shapeInv(sh, delNodeIndex(st, iv)))
        \replacewith(==> shapeInv(sh, selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    selectStDelNodeElement {
        \find(selectSt<[alphaPrim]>(delNode(st), at(iv)))
        \replacewith(\if(0 <= iv & iv < selectSt<[int]>(st, size))
                     \then(defaultValue<[alphaPrim]>)
                     \else(selectSt<[alphaPrim]>(st, at(iv))))
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMember {
        \find(selectSt<[alphaPrim]>(delNode(st), m))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeFixedMap {
        \find(selectSt<[Struct]>(delNodeFixed(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeFixedElement {
        \find(selectSt<[Struct]>(delNodeFixed(st), at(iv)))
        \replacewith(delNode(selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    selectStDelNodeFixedSize {
        \find(selectSt<[alphaPrim]>(delNodeFixed(st), size))
        \replacewith(selectSt<[alphaPrim]>(st, size))
        \heuristics(simplify)
    };

    selectStDelNodeFixedValue {
        \find(selectSt<[alphaPrim]>(delNodeFixed(st), at(iv)))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    delAtEmpty {
        \find(delAt(st, nil))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    selectOnDelAtCons {
        \find(selectSt<[alpha]>(delAt(st, cons(a1, flds)), a2))
        \replacewith(
            \if(a1 = a2)
            \then( \if(isEmpty(flds))
                   \then( delField<[alpha]>(st, a1) )
                   \else( (alpha) delAt(selectSt<[Struct]>(st, a1), flds) ) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    findStValueCast {
        \find(cast<[alphaSt]>(find<[StValue]>(st, fxs)))
        \replacewith(find<[alphaSt]>(st, fxs))
        \heuristics(simplify)
    };

    selectStValueCast {
        \find(cast<[alphaSt]>(selectSt<[StValue]>(st, a)))
        \replacewith(selectSt<[alphaSt]>(st, a))
        \heuristics(simplify)
    };

    delFieldStValueCast {
        \find(cast<[alphaSt]>(delField<[StValue]>(st, a)))
        \replacewith(delField<[alphaSt]>(st, a))
        \heuristics(simplify)
    };
}
