\sorts {
    \generic alphaSt \extends StValue;
    \generic alphaPrim \extends Prim;
    \generic alphaNode \extends Struct;
    \generic alphaFix \extends FixedArray;
    \generic alphaDyn \extends DynamicArray;
    \generic alphaMap \extends Mapping;
    \generic alphaStr \extends StructType;
}

\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    Struct save(Struct, List, StValue);
    Struct assignSt(Struct, Struct);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    Struct delNode(Struct);
    Struct delNodeIndex(Struct, int);
    alpha delField<[alpha]>(Struct, Field);
    Struct delAt(Struct, List);
}

\schemaVariables{
    \term Field a, a1, a2;
    \term MapField mf;
    \term RefField rf;
    \term FixedField ff;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv, n;
    \term Struct st, src;
    \term Prim pk, pk2;
    \term Struct sh;
    \term alphaFix tFix;
    \term alphaDyn tDyn;
    \term alphaMap tMap;
    \term alphaStr tStr;
    \term MemberField m;
    \skolemTerm int skx;
    \skolemTerm Prim skp;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, a1, v), a2))
        \replacewith(
            \if (a1 = a2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,a2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, a))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    fieldTypeDef {
        \find(fieldType(m))
        \replacewith(#typeOf(m))
        \heuristics(simplify)
    };

        findOnEmptyStorage {
        \find(find<[Struct]>(mtSt, flds))
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnFixedSortLength {
        \find(selectSt<[int]>(tFix, size))
        \replacewith(#typedSelect(selectSt<[int]>(tFix, size)))
        \heuristics(concrete)
    };

    selectOnFindFixed {
        \find(selectSt<[alpha]>(tFix, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tFix, a)))
        \heuristics(simplify)
    };

    selectOnFindDynamic {
        \find(selectSt<[alpha]>(tDyn, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tDyn, a)))
        \heuristics(simplify)
    };

    selectOnFindMapping {
        \find(selectSt<[alpha]>(tMap, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tMap, a)))
        \heuristics(simplify)
    };

    selectOnFindStruct {
        \find(selectSt<[alpha]>(tStr, a))
        \replacewith(#typedSelect(selectSt<[alpha]>(tStr, a)))
        \heuristics(simplify)
    };

    // ---- Length invariant: conforms(emptyOf<[T]>, node) ------------------
    conformsEmpty {
        \find(conforms(mtSt, st))
        \replacewith(true)
        \heuristics(concrete)
    };

    conformsOnEmptyStorage {
        \find(conforms(sh, mtSt))
        \replacewith(true)
        \heuristics(concrete)
    };

    conformsStruct {
        \find(conforms(emptyOf<[alphaStr]>, st))
        \replacewith(#structConforms(emptyOf<[alphaStr]>, st))
        \heuristics(simplify)
    };

    conformsDynSize {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \add(0 <= selectSt<[int]>(st, size) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsFixedElem {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(n)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaFix]>), selectSt<[Struct]>(st, at(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsDynElem {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(iv)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaDyn]>), selectSt<[Struct]>(st, at(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsMapElem {
        \assumes(conforms(emptyOf<[alphaMap]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(pk)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaMap]>), selectSt<[Struct]>(st, at(pk))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsFixedElemMap {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[Struct]>(st, atMap(n)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaFix]>), selectSt<[Struct]>(st, atMap(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsDynElemMap {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[Struct]>(st, atMap(iv)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaDyn]>), selectSt<[Struct]>(st, atMap(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsSaveRight {
        \find(==> conforms(sh, save(st, cons(a, flds), v)))
        \replacewith(==> conforms(sh, st)
                        & conformsSaveAt(sh, st, cons(a, flds), v,
                            last<[Field]>(cons(a, flds))))
        \heuristics(simplify)
    };

    conformsSaveAtSize {
        \find(conformsSaveAt(sh, st, flds, v, size))
        \replacewith(0 <= cast<[int]>(v))
        \heuristics(simplify)
    };

    conformsSaveAtIndex {
        \find(conformsSaveAt(sh, st, flds, src, at(pk)))
        \replacewith(conforms(#typeAt(sh, flds), assignSt(find<[Struct]>(st, flds), src)))
        \heuristics(simplify)
    };

    conformsSaveAtIndexPrim {
        \find(conformsSaveAt(sh, st, flds, pk2, at(pk)))
        \replacewith(true)
        \heuristics(simplify)
    };

    conformsSaveAtMapIndex {
        \find(conformsSaveAt(sh, st, flds, src, atMap(iv)))
        \replacewith(conforms(#typeAt(sh, flds), assignSt(find<[Struct]>(st, flds), src)))
        \heuristics(simplify)
    };

    conformsSaveAtMapIndexPrim {
        \find(conformsSaveAt(sh, st, flds, pk, atMap(iv)))
        \replacewith(true)
        \heuristics(simplify)
    };

    conformsSaveAtMember {
        \find(conformsSaveAt(sh, st, flds, src, m))
        \replacewith(conforms(#typeAt(sh, flds), assignSt(find<[Struct]>(st, flds), src)))
        \heuristics(simplify)
    };

    conformsSaveAtMemberPrim {
        \find(conformsSaveAt(sh, st, flds, pk, m))
        \replacewith(true)
        \heuristics(simplify)
    };

    conformsSaveLengthRight {
        \find(==> conforms(emptyOf<[alphaDyn]>, save(st, cons(size, nil), iv)))
        \replacewith(==> conforms(emptyOf<[alphaDyn]>, st) & 0 <= iv)
        \heuristics(concrete)
    };

    conformsStoreRight {
        \find(==> conforms(sh, storeSt(st, a, v)))
        \replacewith(==> (a = size -> 0 <= cast<[int]>(v))
                        & conforms(sh, st)
                        & conforms(#typeAt(sh, cons(a, nil)), cast<[Struct]>(v)))
        \heuristics(simplify)
    };

    conformsDelAtRight {
        \find(==> conforms(sh, delAt(st, flds)))
        \replacewith(==> conforms(sh, st))
        \heuristics(simplify)
    };

    conformsDelNodeRight {
        \find(==> conforms(sh, delNode(st)))
        \replacewith(==> conforms(sh, st))
        \heuristics(simplify)
    };

    conformsFixedRight {
        \find(==> conforms(emptyOf<[alphaFix]>, st))
        \varcond(\newDependingOn(skx, st))
        \replacewith(==> conforms(#elemOf(emptyOf<[alphaFix]>),
                            selectSt<[Struct]>(st, at(skx)))
                        & conforms(#elemOf(emptyOf<[alphaFix]>),
                            selectSt<[Struct]>(st, atMap(skx))))
        \heuristics(conformsUnfold)
    };

    conformsDynRight {
        \find(==> conforms(emptyOf<[alphaDyn]>, st))
        \varcond(\newDependingOn(skx, st))
        \replacewith(==> 0 <= selectSt<[int]>(st, size)
                        & conforms(#elemOf(emptyOf<[alphaDyn]>),
                            selectSt<[Struct]>(st, at(skx)))
                        & conforms(#elemOf(emptyOf<[alphaDyn]>),
                            selectSt<[Struct]>(st, atMap(skx))))
        \heuristics(conformsUnfold)
    };

    conformsMapRight {
        \find(==> conforms(emptyOf<[alphaMap]>, st))
        \varcond(\newDependingOn(skp, st))
        \replacewith(==> conforms(#elemOf(emptyOf<[alphaMap]>),
                            selectSt<[Struct]>(st, at(skp))))
        \heuristics(conformsUnfold)
    };

    selectStDelNodeLength {
        \find(selectSt<[int]>(delNode(st), size))
        \replacewith(0)
        \heuristics(simplify)
    };

    selectOnAssignStLength {
        \find(selectSt<[int]>(assignSt(st, src), size))
        \replacewith(#len(src))
        \heuristics(simplify)
    };

    saveOnEmptyStorage {
        \find(save(mtSt, cons(a1, cons(a2, flds)), v))
        \replacewith( storeSt(mtSt, a1, save(mtSt, cons(a2, flds), v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageLastPrim {
        \find(save(mtSt, cons(a, nil), pk))
        \replacewith( storeSt(mtSt, a, pk) )
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageLastStruct {
        \find(save(mtSt, cons(a, nil), src))
        \replacewith( storeSt(mtSt, a, assignSt(#typedChild(mtSt, a, mtSt), src)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, a1, v0), cons(a2, cons(a, flds)), v1))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, save(cast<[Struct]>(v0), cons(a, flds), v1)) )
            \else ( storeSt(save(st, cons(a2, cons(a, flds)), v1), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreLastPrim {
        \find(save(storeSt(st, a1, v0), cons(a2, nil), pk))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, pk) )
            \else ( storeSt(save(st, cons(a2, nil), pk), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreLastStruct {
        \find(save(storeSt(st, a1, v0), cons(a2, nil), src))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, assignSt(#typedChild(st, a1, cast<[Struct]>(v0)), src)) )
            \else ( storeSt(save(st, cons(a2, nil), src), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionElement {
        \find(find<[alpha]>(st, cons(at(pk), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, at(pk)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, at(pk)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionMapElement {
        \find(find<[alpha]>(st, cons(atMap(iv), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, atMap(iv)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, atMap(iv)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionSize {
        \find(find<[alpha]>(st, cons(size, nil)))
        \replacewith(selectSt<[alpha]>(st, size))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberPrim {
        \find(find<[alphaPrim]>(st, cons(m, nil)))
        \replacewith(selectSt<[alphaPrim]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberValue {
        \find(find<[StValue]>(st, cons(m, nil)))
        \replacewith(selectSt<[StValue]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberStruct {
        \find(find<[Struct]>(st, cons(m, nil)))
        \replacewith(selectSt<[Struct]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberCons {
        \find(find<[alpha]>(st, cons(m, cons(a, flds))))
        \replacewith(find<[alpha]>(selectSt<[Struct]>(st, m), cons(a, flds)))
        \heuristics(simplify_enlarging)
    };

    selectOnAssignStMap {
        \find(selectSt<[Struct]>(assignSt(st, src), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectOnAssignStRef {
        \find(selectSt<[Struct]>(assignSt(st, src), rf))
        \replacewith(assignSt(#typedChild(st, rf, selectSt<[Struct]>(st, rf)), selectSt<[Struct]>(src, rf)))
        \heuristics(simplify)
    };

    selectOnAssignStFixed {
        \find(selectSt<[Struct]>(assignSt(st, src), ff))
        \replacewith(assignSt(#typedChild(st, ff, selectSt<[Struct]>(st, ff)), selectSt<[Struct]>(src, ff)))
        \heuristics(simplify)
    };

    selectOnAssignStIndexStruct {
        \find(selectSt<[Struct]>(assignSt(st, src), at(iv)))
        \replacewith(
            \if(iv < #len(src))
            \then(assignSt(#typedChild(st, at(iv), selectSt<[Struct]>(st, at(iv))), selectSt<[Struct]>(src, at(iv))))
            \else(\if(iv < #len(st))
                  \then(delNode(#typedChild(st, at(iv), selectSt<[Struct]>(st, at(iv)))))
                  \else(selectSt<[Struct]>(st, at(iv)))))
        \heuristics(simplify)
    };

    selectOnAssignStIndexPrim {
        \find(selectSt<[alphaPrim]>(assignSt(st, src), at(iv)))
        \replacewith(
            \if(iv < #len(src))
            \then(selectSt<[alphaPrim]>(src, at(iv)))
            \else(\if(iv < #len(st))
                  \then(defaultValue<[alphaPrim]>)
                  \else(selectSt<[alphaPrim]>(st, at(iv)))))
        \heuristics(concrete)
    };

    selectOnAssignStMember {
        \find(selectSt<[alphaPrim]>(assignSt(st, src), m))
        \replacewith(selectSt<[alphaPrim]>(src, m))
        \heuristics(simplify_enlarging)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st, cons(a1, cons(a, flds)), v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( cast<[alpha]>(save(selectSt<[Struct]>(st, a1), cons(a, flds), v)) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    selectOnSaveLastPrim {
        \find(selectSt<[alpha]>(save(st, cons(a1, nil), pk), a2))
        \replacewith(
            \if(a1 = a2)
            \then( cast<[alpha]>(pk) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    selectOnSaveLastStruct {
        \find(selectSt<[alpha]>(save(st, cons(a1, nil), src), a2))
        \replacewith(
            \if(a1 = a2)
            \then( cast<[alpha]>(assignSt(#typedChild(st, a1, selectSt<[Struct]>(st, a1)), src)) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delFieldRef {
        \find(delField<[Struct]>(st, rf))
        \replacewith(delNode(#typedChild(st, rf, selectSt<[Struct]>(st, rf))))
        \heuristics(simplify)
    };

    delFieldFixed {
        \find(delField<[Struct]>(st, ff))
        \replacewith(delNode(#typedChild(st, ff, selectSt<[Struct]>(st, ff))))
        \heuristics(simplify)
    };

    delFieldMap {
        \find(delField<[Struct]>(st, mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    delFieldIndexStruct {
        \find(delField<[Struct]>(st, at(iv)))
        \replacewith(delNode(#typedChild(st, at(iv), selectSt<[Struct]>(st, at(iv)))))
        \heuristics(simplify)
    };

    delFieldDefault {
        \find(delField<[alphaPrim]>(st, a))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), rf))
        \replacewith(delNode(#typedChild(st, rf, selectSt<[Struct]>(st, rf))))
        \heuristics(simplify)
    };

    selectStDelNodeFixed {
        \find(selectSt<[Struct]>(delNode(st), ff))
        \replacewith(delNode(#typedChild(st, ff, selectSt<[Struct]>(st, ff))))
        \heuristics(simplify)
    };

    selectStDelNodeIndexStruct {
        \find(selectSt<[Struct]>(delNode(st), at(iv)))
        \replacewith(delNodeIndex(st, iv))
        \heuristics(simplify)
    };

    selectStDelNodeIndex {
        \find(selectSt<[alpha]>(delNodeIndex(st, iv), a))
        \replacewith(\if(0 <= iv & iv < #len(st))
                     \then(selectSt<[alpha]>(delNode(#typedChild(st, at(iv), selectSt<[Struct]>(st, at(iv)))), a))
                     \else(selectSt<[alpha]>(selectSt<[Struct]>(st, at(iv)), a)))
        \heuristics(simplify_enlarging)
    };

    conformsDelNodeIndexRight {
        \find(==> conforms(sh, delNodeIndex(st, iv)))
        \replacewith(==> conforms(sh, selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    selectStDelNodeElement {
        \find(selectSt<[alphaPrim]>(delNode(st), at(iv)))
        \replacewith(\if(0 <= iv & iv < #len(st))
                     \then(defaultValue<[alphaPrim]>)
                     \else(selectSt<[alphaPrim]>(st, at(iv))))
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMember {
        \find(selectSt<[alphaPrim]>(delNode(st), m))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    delAtEmpty {
        \find(delAt(st, nil))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    selectOnDelAtCons {
        \find(selectSt<[alpha]>(delAt(st, cons(a1, flds)), a2))
        \replacewith(
            \if(a1 = a2)
            \then( \if(isEmpty(flds))
                   \then( delField<[alpha]>(st, a1) )
                   \else( (alpha) delAt(selectSt<[Struct]>(st, a1), flds) ) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    findStValueCast {
        \find(cast<[alphaSt]>(find<[StValue]>(st, fxs)))
        \replacewith(find<[alphaSt]>(st, fxs))
        \heuristics(simplify)
    };

    selectStValueCast {
        \find(cast<[alphaSt]>(selectSt<[StValue]>(st, a)))
        \replacewith(selectSt<[alphaSt]>(st, a))
        \heuristics(simplify)
    };

    delFieldStValueCast {
        \find(cast<[alphaSt]>(delField<[StValue]>(st, a)))
        \replacewith(delField<[alphaSt]>(st, a))
        \heuristics(simplify)
    };
}
