\sorts {
    \generic alphaSt \extends StValue;
    \generic alphaPrim \extends Prim;
}

\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    Struct save(Struct, List, StValue);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    \unique Field size;

    Struct delNode(Struct);
    alpha delValue<[alpha]>(alpha);
    Struct delAt(Struct, List);

    Struct copyAt(Struct, List, StValue);
    alpha merge<[alpha]>(alpha, alpha);
}

\schemaVariables{
    \term Field a, a1, a2;
    \term MapField mf;
    \term RefField rf;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv;
    \term Struct st, st1, st2;
    \term alphaPrim p0, p1;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, a1, v), a2))
        \replacewith(
            \if (a1 = a2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,a2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, a))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageEmpty {
        \find(save(mtSt, nil, v))
        \replacewith(v)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorage {
        \find(save(mtSt,cons(a, flds), v))
        \replacewith( storeSt(mtSt, a, save(mtSt, flds, v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreEmpty {
        \find(save(storeSt(st, a, v0), nil, v1))
        \replacewith(v1)
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, a1, v0), cons(a2, flds), v1))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1,
                \if ( isEmpty(flds) )
                \then ( v1 )
                \else ( save( (Struct)v0, flds, v1) )
            ))
            \else ( storeSt(save(st, cons(a2, flds), v1), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionCons {
        \find(find<[alpha]>(st, cons(a, flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, a) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, a), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    // lazy
    saveOnEmpty {
        \find(save(st, nil, v))
        \replacewith(v)
        \heuristics(simplify)
    };

    selectOnSaveEmpty {
        \find(selectSt<[alpha]>(save(st,nil,v), a))
        \replacewith(selectSt<[alpha]>((Struct) v, a))
        \heuristics(simplify)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st,cons(a1, flds),v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( (alpha) save(selectSt<[Struct]>(st,a1), flds, v) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delValueStruct {
        \find(delValue<[Struct]>(st))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    delValueDefault {
        \find(delValue<[alphaPrim]>(x))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), rf))
        \replacewith(delNode(selectSt<[Struct]>(st, rf)))
        \heuristics(simplify)
    };

    selectStDelNodeIndexStruct {
        \find(selectSt<[Struct]>(delNode(st), at(iv)))
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectStDelNodeDefault {
        \find(selectSt<[alphaPrim]>(delNode(st), a))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    delAtEmpty {
        \find(delAt(st, nil))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    selectOnDelAtCons {
        \find(selectSt<[alpha]>(delAt(st, cons(a1, flds)), a2))
        \replacewith(
            \if(a1 = a2)
            \then( \if(isEmpty(flds))
                   \then( delValue<[alpha]>(selectSt<[alpha]>(st, a1)) )
                   \else( (alpha) delAt(selectSt<[Struct]>(st, a1), flds) ) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy copy: mapping members are never copied ---------------------
    copyAtEmpty {
        \find(copyAt(st, nil, v))
        \replacewith(merge<[Struct]>(st, (Struct) v))
        \heuristics(simplify)
    };

    selectOnCopyAtCons {
        \find(selectSt<[alpha]>(copyAt(st, cons(a1, flds), v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( \if(isEmpty(flds))
                   \then( merge<[alpha]>(selectSt<[alpha]>(st, a1), cast<[alpha]>(v)) )
                   \else( (alpha) copyAt(selectSt<[Struct]>(st, a1), flds, v) ) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    mergePrim {
        \find(merge<[alphaPrim]>(p0, p1))
        \replacewith(p1)
        \heuristics(simplify_enlarging)
    };

    selectStMergeMap {
        \find(selectSt<[Struct]>(merge<[Struct]>(st1, st2), mf))
        \replacewith(selectSt<[Struct]>(st1, mf))
        \heuristics(simplify)
    };

    selectStMergeRef {
        \find(selectSt<[Struct]>(merge<[Struct]>(st1, st2), rf))
        \replacewith(merge<[Struct]>(selectSt<[Struct]>(st1, rf), selectSt<[Struct]>(st2, rf)))
        \heuristics(simplify)
    };

    selectStMergeIndexStruct {
        \find(selectSt<[Struct]>(merge<[Struct]>(st1, st2), at(iv)))
        \replacewith(selectSt<[Struct]>(st2, at(iv)))
        \heuristics(simplify)
    };

    selectStMergeDefault {
        \find(selectSt<[alphaPrim]>(merge<[Struct]>(st1, st2), a))
        \replacewith(selectSt<[alphaPrim]>(st2, a))
        \heuristics(simplify_enlarging)
    };

    mergeStValueCast {
        \find(cast<[alphaSt]>(merge<[StValue]>(v0, v1)))
        \replacewith(merge<[alphaSt]>(cast<[alphaSt]>(v0), cast<[alphaSt]>(v1)))
        \heuristics(simplify)
    };

    findStValueCast {
        \find(cast<[alphaSt]>(find<[StValue]>(st, fxs)))
        \replacewith(find<[alphaSt]>(st, fxs))
        \heuristics(simplify)
    };

    selectStValueCast {
        \find(cast<[alphaSt]>(selectSt<[StValue]>(st, a)))
        \replacewith(selectSt<[alphaSt]>(st, a))
        \heuristics(simplify)
    };

    delValueStValueCast {
        \find(cast<[alphaSt]>(delValue<[StValue]>(v)))
        \replacewith(delValue<[alphaSt]>(cast<[alphaSt]>(v)))
        \heuristics(simplify)
    };

    sizeNotNegative {
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \add(0 <= selectSt<[int]>(st, size) ==>)
        \heuristics(inReachableStateImplication)
    };
}
