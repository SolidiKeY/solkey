\sorts {
    \generic alphaSt \extends StValue;
    \generic alphaPrim \extends Prim;
    \generic alphaNode \extends Struct;
    \generic alphaFix \extends FixedArray;
    \generic alphaDyn \extends DynamicArray;
    \generic alphaMap \extends Mapping;
    \generic alphaStr \extends StructType;
}

\functions{
    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, StValue);
    Struct save(Struct, List, StValue);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    Struct delNode(Struct);
    Struct delNodeIndex(Struct, int);
    Struct delNodeFixed(Struct);
    alpha delField<[alpha]>(Struct, Field);
    Struct delAt(Struct, List);
}

\schemaVariables{
    \term Field a, a1, a2;
    \term MapField mf;
    \term RefField rf;
    \term FixedField ff;
    \term List fxs, flds, xs;
    \term any x, y, z;
    \term StValue v, v0, v1;
    \term int iv, n;
    \term Struct st, src;
    \term Prim pk;
    \term Struct sh;
    \term MemberField m;
    \skolemTerm int skx;
    \skolemTerm Prim skp;
}

\rules {
    defaultValueStruct {
        \find(defaultValue<[Struct]>)
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, a1, v), a2))
        \replacewith(
            \if (a1 = a2)
            \then (cast<[alpha]>(v))
            \else (selectSt<[alpha]>(st,a2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, a))
        \replacewith(defaultValue<[alpha]>)
        \heuristics(simplify_enlarging)
    };

    fieldTypeDef {
        \find(fieldType(m))
        \replacewith(#typeOf(m))
        \heuristics(simplify)
    };

    // ---- The empty node of a type: the constructor's starting storage --------
    selectOnTypeFixedSize {
        \find(selectSt<[int]>(emptyOf<[alphaFix]>, size))
        \replacewith(#lengthOf(emptyOf<[alphaFix]>))
        \heuristics(concrete)
    };

    selectOnTypeDynSize {
        \find(selectSt<[int]>(emptyOf<[alphaDyn]>, size))
        \replacewith(0)
        \heuristics(concrete)
    };

    selectOnTypeMapSize {
        \find(selectSt<[int]>(emptyOf<[alphaMap]>, size))
        \replacewith(0)
        \heuristics(concrete)
    };

    selectOnTypeFixedElement {
        \find(selectSt<[Struct]>(emptyOf<[alphaFix]>, at(pk)))
        \replacewith(#elemOf(emptyOf<[alphaFix]>))
        \heuristics(simplify)
    };

    selectOnTypeDynElement {
        \find(selectSt<[Struct]>(emptyOf<[alphaDyn]>, at(pk)))
        \replacewith(#elemOf(emptyOf<[alphaDyn]>))
        \heuristics(simplify)
    };

    selectOnTypeMapElement {
        \find(selectSt<[Struct]>(emptyOf<[alphaMap]>, at(pk)))
        \replacewith(#elemOf(emptyOf<[alphaMap]>))
        \heuristics(simplify)
    };

    selectOnTypeFixedMapElement {
        \find(selectSt<[Struct]>(emptyOf<[alphaFix]>, atMap(iv)))
        \replacewith(#elemOf(emptyOf<[alphaFix]>))
        \heuristics(simplify)
    };

    selectOnTypeDynMapElement {
        \find(selectSt<[Struct]>(emptyOf<[alphaDyn]>, atMap(iv)))
        \replacewith(#elemOf(emptyOf<[alphaDyn]>))
        \heuristics(simplify)
    };

    selectOnTypeMember {
        \find(selectSt<[Struct]>(emptyOf<[alphaNode]>, m))
        \replacewith(#memberOf(emptyOf<[alphaNode]>, m))
        \heuristics(simplify)
    };

    findOnEmptyOf {
        \find(find<[Struct]>(emptyOf<[alphaNode]>, cons(a, flds)))
        \replacewith(find<[Struct]>(selectSt<[Struct]>(emptyOf<[alphaNode]>, a), flds))
        \heuristics(simplify)
    };

    findOnEmptyStorage {
        \find(find<[Struct]>(mtSt, flds))
        \replacewith(mtSt)
        \heuristics(simplify)
    };

    selectOnTypeElementPrim {
        \find(selectSt<[alphaPrim]>(emptyOf<[alphaNode]>, at(pk)))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectOnTypeMemberPrim {
        \find(selectSt<[alphaPrim]>(emptyOf<[alphaNode]>, m))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    // ---- Layout invariant: conforms(emptyOf<[T]>, node) ------------------
    conformsEmpty {
        \find(conforms(mtSt, st))
        \replacewith(true)
        \heuristics(concrete)
    };

    conformsStruct {
        \find(conforms(emptyOf<[alphaStr]>, st))
        \replacewith(#structConforms(emptyOf<[alphaStr]>, st))
        \heuristics(simplify)
    };

    conformsSelf {
        \find(conforms(sh, sh))
        \replacewith(true)
        \heuristics(concrete)
    };

    conformsFixedSize {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \replacewith(#lengthOf(emptyOf<[alphaFix]>))
        \heuristics(simplify)
    };

    conformsDynSize {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[int]>(st, size))
        \sameUpdateLevel
        \add(0 <= selectSt<[int]>(st, size) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsFixedElem {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(n)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaFix]>), selectSt<[Struct]>(st, at(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsDynElem {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(iv)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaDyn]>), selectSt<[Struct]>(st, at(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsMapElem {
        \assumes(conforms(emptyOf<[alphaMap]>, st) ==>)
        \find(selectSt<[Struct]>(st, at(pk)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaMap]>), selectSt<[Struct]>(st, at(pk))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsFixedElemMap {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(selectSt<[Struct]>(st, atMap(n)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaFix]>), selectSt<[Struct]>(st, atMap(n))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsDynElemMap {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(selectSt<[Struct]>(st, atMap(iv)))
        \sameUpdateLevel
        \add(conforms(#elemOf(emptyOf<[alphaDyn]>), selectSt<[Struct]>(st, atMap(iv))) ==>)
        \heuristics(inReachableStateImplication)
    };

    conformsSaveRight {
        \find(==> conforms(sh, save(st, cons(a, flds), v)))
        \replacewith(==> conforms(sh, st)
                        & conformsSaveAt(sh, st, cons(a, flds), v,
                            last<[Field]>(cons(a, flds))))
        \heuristics(simplify)
    };

    conformsSaveAtSize {
        \find(conformsSaveAt(sh, st, flds, v, size))
        \replacewith(0 <= cast<[int]>(v) & !fixed(find<[Struct]>(st, firsts(flds))))
        \heuristics(simplify)
    };

    conformsSaveAtIndex {
        \find(conformsSaveAt(sh, st, flds, v, at(pk)))
        \replacewith(conforms(find<[Struct]>(sh, flds), save(find<[Struct]>(st, flds), nil, v)))
        \heuristics(simplify)
    };

    conformsSaveAtMapIndex {
        \find(conformsSaveAt(sh, st, flds, v, atMap(iv)))
        \replacewith(conforms(find<[Struct]>(sh, flds), save(find<[Struct]>(st, flds), nil, v)))
        \heuristics(simplify)
    };

    conformsSaveAtMember {
        \find(conformsSaveAt(sh, st, flds, v, m))
        \replacewith(conforms(find<[Struct]>(sh, flds), save(find<[Struct]>(st, flds), nil, v)))
        \heuristics(simplify)
    };

    conformsSaveLengthRight {
        \find(==> conforms(emptyOf<[alphaDyn]>, save(st, cons(size, nil), iv)))
        \replacewith(==> conforms(emptyOf<[alphaDyn]>, st) & 0 <= iv)
        \heuristics(concrete)
    };

    conformsStoreRight {
        \find(==> conforms(sh, storeSt(st, a, v)))
        \replacewith(==> !(a = size)
                        & conforms(sh, st)
                        & conforms(selectSt<[Struct]>(sh, a),
                            cast<[Struct]>(v)))
        \heuristics(simplify)
    };

    conformsDelAtRight {
        \find(==> conforms(sh, delAt(st, cons(a, flds))))
        \replacewith(==> conforms(sh, st)
                        & (last<[Field]>(cons(a, flds)) = size
                           -> !fixed(find<[Struct]>(st, firsts(cons(a, flds))))))
        \heuristics(simplify)
    };

    conformsDelNodeRight {
        \find(==> conforms(sh, delNode(st)))
        \replacewith(==> conforms(sh, st))
        \heuristics(simplify)
    };

    conformsDelNodeFixedRight {
        \find(==> conforms(emptyOf<[alphaFix]>, delNodeFixed(st)))
        \replacewith(==> conforms(emptyOf<[alphaFix]>, st))
        \heuristics(simplify)
    };

    conformsFixedRight {
        \find(==> conforms(emptyOf<[alphaFix]>, st))
        \varcond(\newDependingOn(skx, st))
        \replacewith(==> fixed(st)
                        & selectSt<[int]>(st, size) = #lengthOf(emptyOf<[alphaFix]>)
                        & conforms(#elemOf(emptyOf<[alphaFix]>),
                            selectSt<[Struct]>(st, at(skx)))
                        & conforms(#elemOf(emptyOf<[alphaFix]>),
                            selectSt<[Struct]>(st, atMap(skx))))
        \heuristics(conformsUnfold)
    };

    conformsDynRight {
        \find(==> conforms(emptyOf<[alphaDyn]>, st))
        \varcond(\newDependingOn(skx, st))
        \replacewith(==> !fixed(st)
                        & 0 <= selectSt<[int]>(st, size)
                        & conforms(#elemOf(emptyOf<[alphaDyn]>),
                            selectSt<[Struct]>(st, at(skx)))
                        & conforms(#elemOf(emptyOf<[alphaDyn]>),
                            selectSt<[Struct]>(st, atMap(skx))))
        \heuristics(conformsUnfold)
    };

    conformsMapRight {
        \find(==> conforms(emptyOf<[alphaMap]>, st))
        \varcond(\newDependingOn(skp, st))
        \replacewith(==> conforms(#elemOf(emptyOf<[alphaMap]>),
                            selectSt<[Struct]>(st, at(skp))))
        \heuristics(conformsUnfold)
    };

    // ---- Which kind of array a node is: decided by its type ------------------
    fixedSave {
        \find(fixed(save(st, flds, v)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedStore {
        \find(fixed(storeSt(st, a, v)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedDelNode {
        \find(fixed(delNode(st)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedDelNodeFixed {
        \find(fixed(delNodeFixed(st)))
        \replacewith(true)
        \heuristics(simplify)
    };

    fixedDelAt {
        \find(fixed(delAt(st, flds)))
        \replacewith(fixed(st))
        \heuristics(simplify)
    };

    fixedTypeFixed {
        \find(fixed(emptyOf<[alphaFix]>))
        \replacewith(true)
        \heuristics(simplify)
    };

    fixedTypeDyn {
        \find(fixed(emptyOf<[alphaDyn]>))
        \replacewith(false)
        \heuristics(simplify)
    };

    fixedEmpty {
        \find(fixed(mtSt))
        \replacewith(false)
        \heuristics(simplify)
    };

    conformsFixedIsFixed {
        \assumes(conforms(emptyOf<[alphaFix]>, st) ==>)
        \find(fixed(st))
        \sameUpdateLevel
        \replacewith(true)
        \heuristics(simplify)
    };

    conformsDynIsNotFixed {
        \assumes(conforms(emptyOf<[alphaDyn]>, st) ==>)
        \find(fixed(st))
        \sameUpdateLevel
        \replacewith(false)
        \heuristics(simplify)
    };

    selectStDelNodeSize {
        \find(selectSt<[int]>(delNode(st), size))
        \replacewith(\if(fixed(st)) \then(selectSt<[int]>(st, size)) \else(0))
        \heuristics(simplify)
    };

    selectOnSaveEmptySize {
        \find(selectSt<[int]>(save(st, nil, v), size))
        \replacewith(\if(fixed(st))
                     \then(selectSt<[int]>(st, size))
                     \else(selectSt<[int]>(cast<[Struct]>(v), size)))
        \heuristics(simplify)
    };

    saveOnEmptyStorage {
        \find(save(mtSt,cons(a, flds), v))
        \replacewith( storeSt(mtSt, a, save(mtSt, flds, v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, a1, v0), cons(a2, flds), v1))
        \replacewith(
            \if (a1 = a2)
            \then ( storeSt(st, a1, save((Struct) v0, flds, v1)) )
            \else ( storeSt(save(st, cons(a2, flds), v1), a1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionElement {
        \find(find<[alpha]>(st, cons(at(pk), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, at(pk)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, at(pk)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionMapElement {
        \find(find<[alpha]>(st, cons(atMap(iv), flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, atMap(iv)) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, atMap(iv)), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionSize {
        \find(find<[alpha]>(st, cons(size, nil)))
        \replacewith(selectSt<[alpha]>(st, size))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberPrim {
        \find(find<[alphaPrim]>(st, cons(m, nil)))
        \replacewith(selectSt<[alphaPrim]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberValue {
        \find(find<[StValue]>(st, cons(m, nil)))
        \replacewith(selectSt<[StValue]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberStruct {
        \find(find<[Struct]>(st, cons(m, nil)))
        \replacewith(selectSt<[Struct]>(st, m))
        \heuristics(simplify_enlarging)
    };

    findDefinitionMemberCons {
        \find(find<[alpha]>(st, cons(m, cons(a, flds))))
        \replacewith(find<[alpha]>(selectSt<[Struct]>(st, m), cons(a, flds)))
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyPrim {
        \find(cast<[alphaPrim]>(save(st, nil, v)))
        \replacewith(cast<[alphaPrim]>(v))
        \heuristics(simplify_enlarging)
    };

    selectOnSaveEmptyMap {
        \find(selectSt<[Struct]>(save(st, nil, v), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectOnSaveEmptyRef {
        \find(selectSt<[Struct]>(save(st, nil, v), rf))
        \replacewith(save(selectSt<[Struct]>(st, rf), nil, selectSt<[Struct]>(cast<[Struct]>(v), rf)))
        \heuristics(simplify)
    };

    selectOnSaveEmptyFixed {
        \find(selectSt<[Struct]>(save(st, nil, v), ff))
        \replacewith(save(selectSt<[Struct]>(st, ff), nil,
                         selectSt<[Struct]>(cast<[Struct]>(v), ff)))
        \heuristics(simplify)
    };

    selectOnSaveEmptyIndexStruct {
        \find(selectSt<[Struct]>(save(st, nil, v), at(iv)))
        \replacewith(
            \if(iv < selectSt<[int]>(cast<[Struct]>(v), size))
            \then(save(selectSt<[Struct]>(st, at(iv)), nil,
                       selectSt<[Struct]>(cast<[Struct]>(v), at(iv))))
            \else(\if(iv < selectSt<[int]>(st, size))
                  \then(delNode(selectSt<[Struct]>(st, at(iv))))
                  \else(selectSt<[Struct]>(st, at(iv)))))
        \heuristics(simplify)
    };

    selectOnSaveEmptyIndexPrim {
        \find(selectSt<[alphaPrim]>(save(st, nil, v), at(iv)))
        \replacewith(
            \if(iv < selectSt<[int]>(cast<[Struct]>(v), size))
            \then(selectSt<[alphaPrim]>(cast<[Struct]>(v), at(iv)))
            \else(\if(iv < selectSt<[int]>(st, size))
                  \then(defaultValue<[alphaPrim]>)
                  \else(selectSt<[alphaPrim]>(st, at(iv)))))
        \heuristics(concrete)
    };

    selectOnSaveEmptyMember {
        \find(selectSt<[alphaPrim]>(save(st, nil, v), m))
        \replacewith(selectSt<[alphaPrim]>(cast<[Struct]>(v), m))
        \heuristics(simplify_enlarging)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st,cons(a1, flds),v), a2))
        \replacewith(
            \if(a1 = a2)
            \then( cast<[alpha]>(save(selectSt<[Struct]>(st,a1), flds, v)) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    // ---- Lazy delete -------------------------------------------------------
    delFieldRef {
        \find(delField<[Struct]>(st, rf))
        \replacewith(delNode(selectSt<[Struct]>(st, rf)))
        \heuristics(simplify)
    };

    delFieldFixed {
        \find(delField<[Struct]>(st, ff))
        \replacewith(delNodeFixed(selectSt<[Struct]>(st, ff)))
        \heuristics(simplify)
    };

    delFieldMap {
        \find(delField<[Struct]>(st, mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    delFieldIndexStruct {
        \find(delField<[Struct]>(st, at(iv)))
        \replacewith(delNode(selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    delFieldDefault {
        \find(delField<[alphaPrim]>(st, a))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMap {
        \find(selectSt<[Struct]>(delNode(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeRef {
        \find(selectSt<[Struct]>(delNode(st), rf))
        \replacewith(delNode(selectSt<[Struct]>(st, rf)))
        \heuristics(simplify)
    };

    selectStDelNodeFixed {
        \find(selectSt<[Struct]>(delNode(st), ff))
        \replacewith(delNodeFixed(selectSt<[Struct]>(st, ff)))
        \heuristics(simplify)
    };

    selectStDelNodeIndexStruct {
        \find(selectSt<[Struct]>(delNode(st), at(iv)))
        \replacewith(delNodeIndex(st, iv))
        \heuristics(simplify)
    };

    selectStDelNodeIndex {
        \find(selectSt<[alpha]>(delNodeIndex(st, iv), a))
        \replacewith(\if(0 <= iv & iv < selectSt<[int]>(st, size))
                     \then(selectSt<[alpha]>(delNode(selectSt<[Struct]>(st, at(iv))), a))
                     \else(selectSt<[alpha]>(selectSt<[Struct]>(st, at(iv)), a)))
        \heuristics(simplify_enlarging)
    };

    fixedDelNodeIndex {
        \find(fixed(delNodeIndex(st, iv)))
        \replacewith(fixed(selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    conformsDelNodeIndexRight {
        \find(==> conforms(sh, delNodeIndex(st, iv)))
        \replacewith(==> conforms(sh, selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    selectStDelNodeElement {
        \find(selectSt<[alphaPrim]>(delNode(st), at(iv)))
        \replacewith(\if(0 <= iv & iv < selectSt<[int]>(st, size))
                     \then(defaultValue<[alphaPrim]>)
                     \else(selectSt<[alphaPrim]>(st, at(iv))))
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeMember {
        \find(selectSt<[alphaPrim]>(delNode(st), m))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    selectStDelNodeFixedMap {
        \find(selectSt<[Struct]>(delNodeFixed(st), mf))
        \replacewith(selectSt<[Struct]>(st, mf))
        \heuristics(simplify)
    };

    selectStDelNodeFixedElement {
        \find(selectSt<[Struct]>(delNodeFixed(st), at(iv)))
        \replacewith(delNode(selectSt<[Struct]>(st, at(iv))))
        \heuristics(simplify)
    };

    selectStDelNodeFixedSize {
        \find(selectSt<[alphaPrim]>(delNodeFixed(st), size))
        \replacewith(selectSt<[alphaPrim]>(st, size))
        \heuristics(simplify)
    };

    selectStDelNodeFixedValue {
        \find(selectSt<[alphaPrim]>(delNodeFixed(st), at(iv)))
        \replacewith(defaultValue<[alphaPrim]>)
        \heuristics(simplify_enlarging)
    };

    delAtEmpty {
        \find(delAt(st, nil))
        \replacewith(delNode(st))
        \heuristics(simplify)
    };

    selectOnDelAtCons {
        \find(selectSt<[alpha]>(delAt(st, cons(a1, flds)), a2))
        \replacewith(
            \if(a1 = a2)
            \then( \if(isEmpty(flds))
                   \then( delField<[alpha]>(st, a1) )
                   \else( (alpha) delAt(selectSt<[Struct]>(st, a1), flds) ) )
            \else( selectSt<[alpha]>(st, a2) )
        )
        \heuristics(simplify)
    };

    findStValueCast {
        \find(cast<[alphaSt]>(find<[StValue]>(st, fxs)))
        \replacewith(find<[alphaSt]>(st, fxs))
        \heuristics(simplify)
    };

    selectStValueCast {
        \find(cast<[alphaSt]>(selectSt<[StValue]>(st, a)))
        \replacewith(selectSt<[alphaSt]>(st, a))
        \heuristics(simplify)
    };

    delFieldStValueCast {
        \find(cast<[alphaSt]>(delField<[StValue]>(st, a)))
        \replacewith(delField<[alphaSt]>(st, a))
        \heuristics(simplify)
    };
}
