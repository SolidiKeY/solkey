\functions{
    Memory write(Memory, Identity, Field, any);
    Memory addM(Memory, IdentityPrim);
    alpha read<[alpha]>(Memory, Identity, Field);
    alpha readR<[alpha]>(Memory, Identity, List);

    \unique Identity idC(IdentityPrim, List);
    Identity idCC(IdentityPrim);
    alpha default<[alpha]>(Identity, Field);
    alpha defaultValue<[alpha]>;
}

\predicates {
    new(Memory, IdentityPrim);
    isPrimitive(Field);
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field fld, fld1, fld2;
    \term List fxs, flds, xs;
    \term any x, y, z, v, v0, v1;
    \term int iv;
    \term Memory mem;
}

\programVariables {
}

\rules {
    applyUpdateOnMemoryRead {
        \schemaVar \update u;
        \schemaVar \term Memory mem;
        \schemaVar \term Identity id;
        \schemaVar \term Field fld;

        \find({u}read<[alpha]>(mem, id, fld))
        \replacewith(read<[alpha]>({u}mem, {u}id, {u}fld))
        \heuristics(update_apply)
    };

    applyUpdateOnMemoryReadR {
        \schemaVar \update u;
        \schemaVar \term Memory mem;
        \schemaVar \term Identity id;
        \schemaVar \term List flds;

        \find({u}readR<[alpha]>(mem, id, flds))
        \replacewith(readR<[alpha]>({u}mem, {u}id, {u}flds))
        \heuristics(update_apply)
    };

    applyUpdateOnMemoryWrite {
        \schemaVar \update u;
        \schemaVar \term Memory mem;
        \schemaVar \term Identity id;
        \schemaVar \term Field fld;
        \schemaVar \term any v;

        \find({u}write(mem, id, fld, v))
        \replacewith(write({u}mem, {u}id, {u}fld, {u}v))
        \heuristics(update_apply)
    };

    applyUpdateOnMemoryAddM {
        \schemaVar \update u;
        \schemaVar \term Memory mem;
        \schemaVar \term IdentityPrim idp;

        \find({u}addM(mem, idp))
        \replacewith(addM({u}mem, {u}idp))
        \heuristics(update_apply)
    };

    defaultValueInt {
        \find(defaultValue<[int]>)
        \replacewith(0)
        \heuristics(simplify)
    };

    defaultValueBool {
        \find(defaultValue<[bool]>)
        \replacewith(FALSE)
        \heuristics(simplify)
    };

    // Auxiliary
    defaultDefInt {
        \find(default<[int]>(idC(idp, flds), fld))
        \replacewith(defaultValue<[int]>)
        \heuristics(simplify)
    };

    defaultDefBool {
        \find(default<[bool]>(idC(idp, flds), fld))
        \replacewith(defaultValue<[bool]>)
        \heuristics(simplify)
    };

    defaultDefIdentity {
        \find(default<[Identity]>(idC(idp, flds), fld))
        \replacewith(idC(idp, consr(flds, fld)))
        \heuristics(simplify)
    };

    idCCDef {
        \find(idCC(idp))
        \replacewith(idC(idp, nil))
        \heuristics(concrete)
    };

    // Memory
    readOnWrite {
        \find(read<[alpha]>(write(mem, id1, fld1, v), id2, fld2))
        // The written value `v` has the top sort `any`; cast it to the read's sort `alpha` so the
        // \then branch matches the \else branch's sort and the result is `alpha`, not `any`.
        \replacewith( \if ( id1 = id2 & fld1 = fld2)
                      \then (cast<[alpha]>(v))
                      \else (read<[alpha]>(mem, id2, fld2))
                    )
        \heuristics(simplify_enlarging)
    };

    readOnAddM {
        \find(read<[alpha]>(addM(mem, idp1), idC(idp2, flds), fld))
            \replacewith(
                \if (idp1 = idp2) \then (
                        default<[alpha]>(idC(idp2, flds), fld)
                ) \else (
                        read<[alpha]>(mem, idC(idp2, flds), fld)
                )
        )
        \heuristics(simplify_enlarging)
    };

    readFromEmptyMemory {
        \find(read<[alpha]>(mtMem, id, fld))
        \replacewith(default<[alpha]>(id, fld))
        \heuristics(simplify)
    };

    readREmpty {
        \find(readR<[alpha]>(mem, id, cons(fld, nil)))
        \replacewith( read<[alpha]>(mem, id, fld) )
        \heuristics(simplify)
    };

    readRCons {
        \find(readR<[alpha]>(mem, id, cons(fld1, cons(fld2, flds))))
        \replacewith(
            read<[alpha]>(mem, readR<[Identity]>(mem, id, firsts(cons(fld1, cons(fld2, flds)))),
               last<[Field]>(cons(fld1, cons(fld2, flds))))
        )
        \heuristics(simplify)
    };

    newFromAdd {
        \find(new(addM(mem, idp1), idp2))
        \replacewith(
            \if (idp1 = idp2)
            \then (false)
            \else (new(mem, idp2))
        )
        \heuristics(simplify_enlarging)
    };

    newFromWrite {
        \find(new(write(mem, id1, fld1, v), idp2))
        \replacewith(new(mem, idp2))
        \heuristics(simplify_enlarging)
    };

    newFromEmptyMemory {
        \find(new(mtMem, idp1))
        \replacewith(true)
        \heuristics(simplify_enlarging)
    };
}
