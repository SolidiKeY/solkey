\sorts {
    \generic prim \extends Prim;
}

\functions{
    Memory write(Memory, Identity, Field, MemValue);
    Memory addM(Memory, IdentityPrim);
    alpha read<[alpha]>(Memory, Identity, Field);
    alpha readR<[alpha]>(Memory, Identity, List);

    \unique Identity idC(IdentityPrim, List);
    Identity idCC(IdentityPrim);
    alpha default<[alpha]>(Identity, Field);
    alpha defaultValue<[alpha]>;
}

\predicates {
    new(Memory, IdentityPrim);
    isPrimitive(Field);
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field a, a1, a2;
    \term List fxs, flds, xs;
    \term any x, y, z, v0, v1;
    \term MemValue v;
    \term int iv;
    \term Memory mem;
}

\programVariables {
}

\rules {
    defaultValueInt {
        \find(defaultValue<[int]>)
        \replacewith(0)
        \heuristics(simplify)
    };

    defaultValueBool {
        \find(defaultValue<[bool]>)
        \replacewith(FALSE)
        \heuristics(simplify)
    };

    // Auxiliary
    defaultDef {
        \find(default<[prim]>(idC(idp, flds), a))
        \replacewith(defaultValue<[prim]>)
        \heuristics(simplify)
    };

    defaultDefIdentity {
        \find(default<[Identity]>(idC(idp, flds), a))
        \replacewith(idC(idp, consr(flds, a)))
        \heuristics(simplify)
    };

    idCCDef {
        \find(idCC(idp))
        \replacewith(idC(idp, nil))
        \heuristics(concrete)
    };

    // Memory
    readOnWrite {
        \find(read<[alpha]>(write(mem, id1, a1, v), id2, a2))
        // The written value `v` has sort `MemValue`; cast it to the read's sort `alpha` so the
        // \then branch matches the \else branch's sort and the result is `alpha`, not `any`.
        \replacewith( \if ( id1 = id2 & a1 = a2)
                      \then (cast<[alpha]>(v))
                      \else (read<[alpha]>(mem, id2, a2))
                    )
        \heuristics(simplify_enlarging)
    };

    readOnAddM {
        \find(read<[alpha]>(addM(mem, idp1), idC(idp2, flds), a))
            \replacewith(
                \if (idp1 = idp2) \then (
                        default<[alpha]>(idC(idp2, flds), a)
                ) \else (
                        read<[alpha]>(mem, idC(idp2, flds), a)
                )
        )
        \heuristics(simplify_enlarging)
    };

    readFromEmptyMemory {
        \find(read<[alpha]>(mtMem, id, a))
        \replacewith(default<[alpha]>(id, a))
        \heuristics(simplify)
    };

    readREmpty {
        \find(readR<[alpha]>(mem, id, cons(a, nil)))
        \replacewith( read<[alpha]>(mem, id, a) )
        \heuristics(simplify)
    };

    readRCons {
        \find(readR<[alpha]>(mem, id, cons(a1, cons(a2, flds))))
        \replacewith(
            read<[alpha]>(mem, readR<[Identity]>(mem, id, firsts(cons(a1, cons(a2, flds)))),
               last<[Field]>(cons(a1, cons(a2, flds))))
        )
        \heuristics(simplify)
    };

    newFromAdd {
        \find(new(addM(mem, idp1), idp2))
        \replacewith(
            \if (idp1 = idp2)
            \then (false)
            \else (new(mem, idp2))
        )
        \heuristics(simplify_enlarging)
    };

    newFromWrite {
        \find(new(write(mem, id1, a1, v), idp2))
        \replacewith(new(mem, idp2))
        \heuristics(simplify_enlarging)
    };

    newFromEmptyMemory {
        \find(new(mtMem, idp1))
        \replacewith(true)
        \heuristics(simplify_enlarging)
    };
}
