        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nmp.s#a; #c}\endmodality(post))
        \varcond(\newTypeOf(mp, nmp), \newTypeOf(aliasType, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mp = s#nmp;
                                      delete s#mp.s#a; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.complex.array] nmp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=memory] mp;
        \schemaVar \program Type aliasType;

