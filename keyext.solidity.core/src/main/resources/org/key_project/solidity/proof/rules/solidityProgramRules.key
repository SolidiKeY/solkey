        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field a;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field b;

        \find(\modality{#mod}{c# s#sp.s#a = s#mv.s#b; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(b, \sort(alphaId)))
        \replacewith({storage := save(storage, consr(sp, a),
                                      copyMem(mtSt, memory,
                                          read<[Identity]>(memory, mv, b)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Deep-copy a memory struct into an indexed storage slot: sp[i] = mv;
    // split by the receiver's sort like the plain index writes, with the
    // array form carrying the usual bounds/revert goal pair.
    memoryToStorageIndexMappingCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp[s#i] = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, at(i)),
                                      copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageIndexArrayCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp[s#i] = s#mv; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= i & i < find<[int]>(storage, consr(sp, size))
                -> {storage := save(storage, consr(sp, at(i)),
                        copyMem(mtSt, memory, mv))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= i & i < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for value variable declarations
    // ------------------------------------------------------------------------

    // Declarations with initialization are decomposed by localValueDeclInitDrop,
    // storageLocalDeclInitDrop, and memoryLocalDeclInitDrop (one per data location).

    localValueDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#varType s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // Skip bare value variable declaration and add to program variables
    valueDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#varType s#v; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(v)
        \heuristics(simplify_prog)
    };

    storageFieldReadBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field a;

        \find(\modality{#mod}{c# s#lsv = s#sp.s#a; #c}\endmodality(post))
        \replacewith({lsv := consr(sp, a)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field a;

        \find(\modality{#mod}{c# s#gsp = s#sp.s#a; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp,
                find<[StValue]>(storage, consr(sp, a)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for storage compound assignment operators
    // ------------------------------------------------------------------------

    // generalized by: storageCompoundAssign(op=add, loc=root, variant=plain)
    storageRootAddAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#gsp += s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) + se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // generalized by: storageCompoundAssign(op=add, loc=field, variant=unfold)
    storageFieldAddAssign_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#a += s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#a += s#se; #c}\endmodality(post))
