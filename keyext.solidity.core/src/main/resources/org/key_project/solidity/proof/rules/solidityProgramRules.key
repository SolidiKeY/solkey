\schemaVariables {
    \modalOperator {diamond, box} #allmodal;
    \modalOperator {diamond, box} #mod;
    \modalOperator {diamond} #diamond;
    \modalOperator {box} #box;
}

\sorts {
    List;
    \generic alpha;
    \generic alphaPrim \extends Prim;
    \generic alphaSt \extends StValue;
    \generic alphaMem \extends MemValue;
    \generic alphaId \extends Identity;
}


\functions{
}

\predicates {
}

\programVariables {
}

\rules {
}

\rules(programRules:Solidity) {

    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };

    emptyModality {
         \schemaVar \formula post;
         \find(\modality{#allmodal}{}\endmodality (post))
         \replacewith(post)
         \heuristics(simplify_prog)
    };

    blockEmpty {
         \schemaVar \formula post;
         \find(\modality{#mod}{c# {} #c}\endmodality(post))
         \replacewith(\modality{#mod}{c# #c}\endmodality(post))
         \heuristics(simplify_prog)
    };

    revertDiamond {
         \schemaVar \formula post;
         \find(\modality{#diamond}{c# revert(); #c}\endmodality(post))
         \replacewith(false)
         \heuristics(simplify_prog)
    };

    revertBox {
         \schemaVar \formula post;
         \find(\modality{#box}{c# revert(); #c}\endmodality(post))
         \replacewith(true)
         \heuristics(simplify_prog)
    };

    storageRootWriteStore {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#gsp = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[storage,simple] sp;

        \find(\modality{#mod}{c# s#gsp = s#sp; #c}\endmodality(post))
        \replacewith({storage := copyAt(storage, gsp, find<[StValue]>(storage, sp))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,primitive] sp;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#sp; #c}\endmodality(post))
        \varcond(\hasSort(sp, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, sp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp.s#fld = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, fld), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp1;
        \schemaVar \program Field fld;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1.s#fld = s#sp2; #c}\endmodality(post))
        \replacewith({storage := copyAt(storage, consr(sp1, fld),
                find<[StValue]>(storage, sp2))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteCaptureSrc {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp1;
        \schemaVar \program Field fld;
        \schemaVar \program Path[storage,complex,reference] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#sp1.s#fld = s#nsp; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp1.s#fld = s#sp; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nsp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lhs = s#sp.s#fld; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nsp[s#ie]; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lhs = s#sp[s#ie]; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#sp.s#fld; #c}\endmodality(post))
        \varcond(\hasFieldSort(fld, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, consr(sp, fld))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=storage, variant=valueField)
    storageFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#fld = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=storage, variant=valueIndex)
    storageIndexWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nsp[s#ie] = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(sp, nsp), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=storage, variant=refField)
    storageFieldWriteStorageRef_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Path[storage,reference] src;
        \schemaVar \program Variable[storage] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#fld = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#rvType storage s#rv = s#src;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=storage, variant=refIndex)
    storageIndexWriteStorageRef_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Expression ie;
        \schemaVar \program Path[storage,reference] src;
        \schemaVar \program Variable[storage] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nsp[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, nsp), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType storage s#rv = s#src;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=memToStorage, variant=refField)
    memoryToStorageField_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#fld = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=memToStorage, variant=refIndex)
    memoryToStorageIndex_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Expression ie;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nsp[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, nsp), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp[s#ie] = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, at(ie)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping,primitiveElement] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#sp[s#ie]; #c}\endmodality(post))
        \varcond(\hasElementSort(sp, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, consr(sp, at(ie)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#lsv = s#sp[s#ie]; #c}\endmodality(post))
        \replacewith({lsv := consr(sp, at(ie))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#gsp = s#sp[s#ie]; #c}\endmodality(post))
        \replacewith({storage := copyAt(storage, gsp,
                find<[StValue]>(storage, consr(sp, at(ie))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp1;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1[s#ie] = s#sp2; #c}\endmodality(post))
        \replacewith({storage := copyAt(storage, consr(sp1, at(ie)),
                find<[StValue]>(storage, sp2))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteStorageRefRhsCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp1;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Path[storage,complex,reference] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        // evaluation order: Solidity evaluates right hand side first

        \find(\modality{#mod}{c# s#sp1[s#ie] = s#nsp; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp1[s#ie] = s#sp; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };



    storageIndexWriteArraySave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp[s#ie] = s#se; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {storage := save(storage, consr(sp, at(ie)), se)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayFind {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#sp[s#ie]; #c}\endmodality(post))
        \varcond(\hasElementSort(sp, \sort(alphaPrim)))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {v := find<[alphaPrim]>(storage, consr(sp, at(ie)))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };



    storageIndexReadArrayBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#lsv = s#sp[s#ie]; #c}\endmodality(post))
        // Bounds in the post-update storage (see storageIndexReadArrayFind).
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {lsv := consr(sp, at(ie))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#gsp = s#sp[s#ie]; #c}\endmodality(post))
        // Bounds in the post-update storage (see storageIndexReadArrayFind).
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {storage := copyAt(storage, gsp,
                        find<[StValue]>(storage, consr(sp, at(ie))))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArrayCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp1;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1[s#ie] = s#sp2; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp1, size))
                -> {storage := copyAt(storage, consr(sp1, at(ie)),
                        find<[StValue]>(storage, sp2))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp1, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for storage dynamic-array push and pop ----------------
    // ------------------------------------------------------------------------

    storagePushValue_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Expression e;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(s#e); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(s#e); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePush_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePop_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.pop(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.pop(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootPush_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lsv = s#nsp.push(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lsv = s#sp.push(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePushValue_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program NonSimpleExpression[primitive] nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#sp.push(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#sp.push(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };



    storagePushValueSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp.push(s#se); #c}\endmodality(post))
        \replacewith({storage := save(save(storage,
                                      consr(sp, at(find<[int]>(storage,
                                          consr(sp, size)))), se),
                                      consr(sp, size),
                                      find<[int]>(storage, consr(sp, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushValueCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp1;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1.push(s#sp2); #c}\endmodality(post))
        \replacewith({storage := save(copyAt(storage,
                                      consr(sp1, at(find<[int]>(storage,
                                          consr(sp1, size)))),
                                      find<[StValue]>(storage, sp2)),
                                      consr(sp1, size),
                                      find<[int]>(storage, consr(sp1, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushLengthSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;

        \find(\modality{#mod}{c# s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storageLocalRootPushBind {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple,array] sp;

        \find(\modality{#mod}{c# s#lsv = s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, size),
                                      find<[int]>(storage, consr(sp, size)) + 1)
                      || lsv := consr(sp, at(find<[int]>(storage, consr(sp, size))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePopSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;

        \find(\modality{#mod}{c# s#sp.pop(); #c}\endmodality(post))
        "nonEmpty":
            \replacewith(0 < find<[int]>(storage, consr(sp, size))
                -> {storage := save(delAt(storage,
                                         consr(sp, at(find<[int]>(storage,
                                             consr(sp, size)) - 1))),
                                         consr(sp, size),
                                         find<[int]>(storage, consr(sp, size)) - 1)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "empty":
            \replacewith(!(0 < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple] sp;

        \find(\modality{#mod}{c# s#lsv = s#sp; #c}\endmodality(post))
        \replacewith({lsv := sp}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[storage] lsv;

        \find(\modality{#mod}{c# s#aliasType storage s#lsv; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lsv)
        \heuristics(simplify_prog)
    };

    storageLocalDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#aliasType storage s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for memory reference allocation
    // ------------------------------------------------------------------------

    memoryReferenceDeclFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#aliasType memory s#mv; #c}\endmodality(post))
        \replacewith({mv := idC(freshIdp, nil)}
            {memory := addM(memory, freshIdp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>)
        \addprogvars(mv)
        \heuristics(simplify_prog)
    };

    memoryLocalDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#aliasType memory s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    memoryRootDeleteFreshRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# delete s#mv; #c}\endmodality(post))
        \replacewith({mv := idC(freshIdp, nil)}
            {memory := addM(memory, freshIdp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>) // ensures semantic freshness
        \heuristics(simplify_prog)
    };

    memoryRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv1;
        \schemaVar \program Path[memory,simple] mv2;

        \find(\modality{#mod}{c# s#mv1 = s#mv2; #c}\endmodality(post))
        \replacewith({mv1 := mv2}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryArrayFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type arrayType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program SimpleExpression se;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#mv = new s#arrayType(s#se); #c}\endmodality(post))
        \replacewith({mv := idC(freshIdp, nil)}
            {memory := write(addM(memory, freshIdp), idC(freshIdp, nil), size, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>)
        \heuristics(simplify_prog)
    };

    // Deep-copy a simple storage path into a fresh memory struct: m = sp;
    memoryStorageCopy {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#mv = s#sp; #c}\endmodality(post))
        \replacewith({mv := idC(freshIdp, nil)}
            {memory := copySt(addM(memory, freshIdp), freshIdp,
                              find<[Struct]>(storage, sp))}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>)
        \heuristics(simplify_prog)
    };

    // Capture a complex storage path in a local storage pointer first: m = sp;
    memoryStorageCopyUnfold {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#mv = s#nsp; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#mv = s#sp; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldWrite {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld = s#se; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldRead {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# s#lhs = s#mv.s#fld; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(fld, \sort(alpha)))
        \replacewith({lhs := read<[alpha]>(memory, mv, fld)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldRead_unfold_rightFst {
