    };

    // Pre-increment assignment on storage index: result = ++values[i];
    storageIndexPreincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List spPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp = ++s#sp[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(spPath, at(idx)),
                find<[int]>(storage, consr(spPath, at(idx))) + 1)}
            {vp := find<[int]>(storage, consr(spPath, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-increment assignment on storage index: result = values[i]++;
    storageIndexPostincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List spPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp = s#sp[s#indexExpr]++; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(indexExpr, idx))
        \replacewith({vp := find<[int]>(storage, consr(spPath, at(idx)))}
            {storage := save(storage, consr(spPath, at(idx)),
                find<[int]>(storage, consr(spPath, at(idx))) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement assignment on storage index: result = --values[i];
    storageIndexPredecrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List spPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp = --s#sp[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(spPath, at(idx)),
                find<[int]>(storage, consr(spPath, at(idx))) - 1)}
            {vp := find<[int]>(storage, consr(spPath, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-decrement assignment on storage index: result = values[i]--;
    storageIndexPostdecrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
