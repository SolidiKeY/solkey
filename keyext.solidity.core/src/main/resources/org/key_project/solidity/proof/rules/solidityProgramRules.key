    assertSimple {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# assert(s#se); #c}\endmodality(post))
        "Holds":
            \replacewith(\modality{#mod}{c# #c}\endmodality(post))
            \add(se = TRUE ==>);
        "Violated":
            \replacewith(se = TRUE)
        \heuristics(simplify_prog)
    };

    requireConditionCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# require(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      require(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    requireSimple {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# require(s#se); #c}\endmodality(post))
        "Holds":
            \replacewith(se = FALSE | \modality{#mod}{c# #c}\endmodality(post));
        "Reverts":
            \replacewith(se = TRUE | \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for address payments: sadr.transfer(se) (docs/net.md)
    // ------------------------------------------------------------------------

    transfer_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nadr;
        \schemaVar \program Expression e;
        \schemaVar \program Variable sadr;
        \schemaVar \program Type sadrType;

        \find(\modality{#mod}{c# s#nadr.transfer(s#e); #c}\endmodality(post))
        \varcond(\newTypeOf(sadr, nadr))
        \replacewith(\modality{#mod}{c# s#sadrType s#sadr = s#nadr;
                                      s#sadr.transfer(s#e); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    transfer_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable se;
        \schemaVar \program Type seType;

        \find(\modality{#mod}{c# s#sadr.transfer(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(se, nse))
        \replacewith(\modality{#mod}{c# s#seType s#se = s#nse;
                                      s#sadr.transfer(s#se); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

}

\rules(transferSemantics:noCallback) {

    // Box (partial correctness): an unfunded transfer reverts on the EVM and a
    // reverting run is trivially correct, so the box books the debit
    // unconditionally - no balance check, no revert branch.
    transferNoCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#box}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        \replacewith({selfBalance := selfBalance - se
                      || net := storeSt(net, at(sadr),
                                        selectSt<[int]>(net, at(sadr)) - se)}
            \modality{#box}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Diamond (total correctness): the EVM value-transfer check is owed as a
    // proof obligation - a diamond over an unfunded transfer must not close.
    // A negative amount is unrepresentable in the EVM's unsigned value field
    // and is folded into the same obligation.
    transferNoCallbackDiamond {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#diamond}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        "sufficient funds":
            \replacewith(0 <= se & se <= selfBalance);
        "transfer booked":
            \replacewith({selfBalance := selfBalance - se
                          || net := storeSt(net, at(sadr),
                                            selectSt<[int]>(net, at(sadr)) - se)}
                \modality{#diamond}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

}

\rules(transferSemantics:withCallback) {

    // The callback havoc quantifies over the balance alongside storage and the
    // ledger: the callee may move funds in or out before control returns.
    // Box: no funds check - the reverting run is vacuous; the exit invariant
    // and the resumed continuation are owed unconditionally.
    transferWithCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;
        \schemaVar \skolemTerm int selfBalanceSk;

        \find(\modality{#box}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        "invariant on exit":
            \replacewith({selfBalance := selfBalance - se
                          || net := storeSt(net, at(sadr),
                                            selectSt<[int]>(net, at(sadr)) - se)}
                CInv(storage, net));
        "resume after callback":
            \replacewith({storage := storageSk || net := netSk
                          || selfBalance := selfBalanceSk}
                (CInv(storage, net) -> \modality{#box}{c# #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

    // Diamond: additionally owes the EVM funding check; the guard stays as an
    // assumption on the other branches (proven in "sufficient funds" but not
    // visible across goals).
    transferWithCallbackDiamond {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;
        \schemaVar \skolemTerm int selfBalanceSk;

        \find(\modality{#diamond}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        "sufficient funds":
            \replacewith(0 <= se & se <= selfBalance);
        "invariant on exit":
            \replacewith(0 <= se & se <= selfBalance
                -> {selfBalance := selfBalance - se
                    || net := storeSt(net, at(sadr),
                                      selectSt<[int]>(net, at(sadr)) - se)}
                   CInv(storage, net));
        "resume after callback":
            \replacewith(0 <= se & se <= selfBalance
                -> {storage := storageSk || net := netSk
                    || selfBalance := selfBalanceSk}
                   (CInv(storage, net) -> \modality{#diamond}{c# #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

}
