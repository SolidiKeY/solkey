                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= indexExpr & indexExpr < read<[int]>(memory, mp, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= indexExpr & indexExpr < read<[int]>(memory, mp, size))
        \heuristics(simplify_prog)
