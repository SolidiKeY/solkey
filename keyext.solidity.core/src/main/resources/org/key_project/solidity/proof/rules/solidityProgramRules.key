    // ------------------------------------------------------------------------
    // ----------- Rules for prefix and postfix increment and decrement operators
    // ------------------------------------------------------------------------

    // Pre-increment on storage root: ++age;
    storageRootPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] sp;

        \find(\modality{#mod}{c# ++s#sp; #c}\endmodality(post))
        \replacewith({storage := save(storage, sp, find<[int]>(storage, sp) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement on storage root: --age;
    storageRootPredecrement {
