        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=memory, variant=valueField)
    memoryFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nmp.s#fld = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType memory s#mv = s#nmp;
                                      s#mv.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=memory, variant=refField)
    memoryFieldWriteMemRef_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nmp.s#fld = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType memory s#mv = s#nmp;
                                      s#mv.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexWriteArray {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array] mv;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv[s#ie] = s#se; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(memory, mv, at(ie), se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryIndexReadArrayValue {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \schemaVar \program Path[memory,simple,array,primitiveElement] mv;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#lhs = s#mv[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\hasMemoryElementSort(mv, \sort(alpha)))
        "inBounds":
            \replacewith({lhs := read<[alpha]>(memory, mv, at(ie))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryIndexReadArrayMemory {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv1;
        \schemaVar \program Path[memory,simple,array,referenceElement] mv2;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#mv1 = s#mv2[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({mv1 := read<[Identity]>(memory, mv2, at(ie))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv2, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv2, size))
        \heuristics(simplify_prog)
    };

    memoryIndexRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nmp[s#ie]; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      s#lhs = s#mv[s#ie]; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=memory, variant=valueIndex)
    memoryIndexWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nmp[s#ie] = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(mv, nmp), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType memory s#mv = s#nmp;
                                      s#pvType s#pv = s#ie;
                                      s#mv[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalized by: receiverCapture(op=memory, variant=refIndex)
    memoryIndexWriteMemRef_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Expression ie;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nmp[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(mv, nmp), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType memory s#mv = s#nmp;
                                      s#pvType s#pv = s#ie;
                                      s#mv[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldDeletePrimitive {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# delete s#mv.s#fld; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(fld, \sort(alphaPrim)))
        \replacewith({memory := write(memory, mv, fld, defaultValue<[alphaPrim]>)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldDeleteReference {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# delete s#mv.s#fld; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\hasMemoryFieldSort(fld, \sort(alphaId)))
        "freshen":
            \replacewith({memory := write(addM(memory, freshIdp), mv, fld,
                                          idC(freshIdp, nil))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(new(memory, freshIdp) ==>)
        \heuristics(simplify_prog)
    };

    memoryIndexDeletePrimitive {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array,primitiveElement] mv;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# delete s#mv[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(memory, mv, at(ie), defVal)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryIndexDeleteReference {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array,referenceElement] mv;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# delete s#mv[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(addM(memory, freshIdp), mv, at(ie),
                                          idC(freshIdp, nil))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size)
                 & new(memory, freshIdp) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryFieldDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nmp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      delete s#mv.s#fld; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Expression ie;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nmp[s#ie]; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      delete s#mv[s#ie]; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[memory,simple] mv;

        \find(\modality{#mod}{c# s#gsp = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageFieldCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp.s#fld = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, fld),
                                      copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageFieldCopyField {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field srcFld;

        \find(\modality{#mod}{c# s#sp.s#fld = s#mv.s#srcFld; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(srcFld, \sort(alphaId)))
        \replacewith({storage := save(storage, consr(sp, fld),
                                      copyMem(mtSt, memory,
                                          read<[Identity]>(memory, mv, srcFld)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageIndexMappingCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp[s#ie] = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, at(ie)),
                                      copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageIndexArrayCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp[s#ie] = s#mv; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {storage := save(storage, consr(sp, at(ie)),
                        copyMem(mtSt, memory, mv))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for value variable declarations
    // ------------------------------------------------------------------------

    // Declarations with initialization are decomposed by localValueDeclInitDrop,
    // storageLocalDeclInitDrop, and memoryLocalDeclInitDrop (one per data location).

    localValueDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#varType s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // Skip bare value variable declaration and add to program variables
    valueDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#varType s#v; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(v)
        \heuristics(simplify_prog)
    };

    storageFieldReadBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# s#lsv = s#sp.s#fld; #c}\endmodality(post))
        \replacewith({lsv := consr(sp, fld)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
