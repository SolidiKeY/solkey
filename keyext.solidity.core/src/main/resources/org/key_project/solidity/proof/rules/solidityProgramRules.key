    memoryFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.complex] nmp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[name=memory] mp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nmp.s#a = s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(mp, nmp), \newTypeOf(aliasType, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mp = s#nmp;
                                      s#mp.s#a = s#se; #c}\endmodality(post))
