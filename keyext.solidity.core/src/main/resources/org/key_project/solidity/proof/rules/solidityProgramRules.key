    };

    memoryIndexWriteArray {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple.array] mp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#mp[s#indexExpr] = s#se; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\sameAsTerm(indexExpr, idx))
        "inBounds":
            \replacewith({memory := write(memory, mp, at(idx), se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= idx & idx < read<[int]>(memory, mp, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= idx & idx < read<[int]>(memory, mp, size))
        \heuristics(simplify_prog)
    };

    memoryIndexReadArrayValue {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] lhs;
