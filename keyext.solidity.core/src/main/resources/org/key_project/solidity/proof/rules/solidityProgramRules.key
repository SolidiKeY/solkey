    // delete sp;  -- save the storage path type's default value.
    storageRootDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;

        \find(\modality{#mod}{c# delete s#gsp; #c}\endmodality(post))
        \replacewith({storage := delAt(storage, gsp)}
