        \find(\modality{#mod}{c# s#vp = s#sp[s#indexExpr]--; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(indexExpr, idx))
        \replacewith({vp := find<[int]>(storage, consr(spPath, at(idx)))}
            {storage := save(storage, consr(spPath, at(idx)),
                find<[int]>(storage, consr(spPath, at(idx))) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // ------------------------------------------------------------------------
    // ----------- Unfold rules for complex paths in increment/decrement
    // ------------------------------------------------------------------------

    // Unfold pre-increment on complex field path: ++nsp.a;
    storageFieldPreincrement_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# ++s#nsp.s#a; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      ++s#sp.s#a; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Unfold post-increment on complex field path: nsp.a++;
    storageFieldPostincrement_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program Variable[name=storage] sp;
