\schemaVariables {
    \modalOperator {diamond, box} #allmodal;
    \modalOperator {diamond, box} #mod;
}

\sorts {
    List;
    \generic alpha;
}


\functions{
}

\predicates {
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field fld, fld1, fld2;
    \term List fxs, flds, xs;
    \term any x, y, z, v, v0, v1;
    \term int iv;
    \term Memory mem;
    \term Struct st;
}

\programVariables {
}

\rules {
}

\rules(programRules:Solidity) {
    emptyModality {
         \schemaVar \formula post;
         \find(\modality{#allmodal}{}\endmodality (post))
         \replacewith(post)
         \heuristics(simplify_prog)
    };

    storageRootWriteStore {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List lhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath))
        \replacewith({storage := save(storage, lhsPath, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List lhsPath;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath), \sameAsTerm(rootRhs, rhsPath))
        \replacewith({storage := save(storage, lhsPath, find<[int]>(storage, rhsPath))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#vp =s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsPath))
        \replacewith({vp := find<[int]>(storage, rhsPath)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteSave {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# s#sp.s#a = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(a, fieldA))
        \replacewith({storage := save(storage, consr(spPath, fieldA), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nsp.s#a; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lhs = s#sp.s#a; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field a;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# s#vp = s#sp.s#a; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(a, fieldA))
        \replacewith({vp := find<[int]>(storage, consr(spPath, fieldA))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#a = s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#a = s#se; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_root {
        \schemaVar \formula post;
        \schemaVar \program FieldReference indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedRoot[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(indexedRootPath, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_root {
        \schemaVar \formula post;
        \schemaVar \program FieldReference indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp =s#indexedRoot[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith({vp := find<[int]>(storage, consr(indexedRootPath, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedBase[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(pathFields, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp =s#indexedBase[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({vp := find<[int]>(storage, consr(pathFields, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclInitSplit {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program StoragePath path;

        \find(\modality{#mod}{c# s#aliasType storage s#lp = s#path; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#lp; s#lp = s#path; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#lp = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsPath))
        \replacewith({lp := rhsPath}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;

        \find(\modality{#mod}{c# s#aliasType storage s#lp; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lp)
        \heuristics(simplify_prog)
    };

    storageFieldReadBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field b;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldB;

        \find(\modality{#mod}{c# s#lp = s#sp.s#b; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(b, fieldB))
        \replacewith({lp := consr(spPath, fieldB)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] gp;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field b;
        \schemaVar \term List gpPath;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldB;

        \find(\modality{#mod}{c# s#gp = s#sp.s#b; #c}\endmodality(post))
        \varcond(\sameAsTerm(gp, gpPath), \sameAsTerm(sp, spPath),
            \sameAsTerm(b, fieldB))
        \replacewith({storage := save(storage, gpPath,
                find<[int]>(storage, consr(spPath, fieldB)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for prefix and postfix increment and decrement operators
    // ------------------------------------------------------------------------

    // Pre-increment: ++x; -> x = x + 1;
    preincrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;

        \find(\modality{#mod}{c# ++s#lhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#lhs + 1; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement: --x; -> x = x - 1;
    predecrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;

        \find(\modality{#mod}{c# --s#lhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#lhs - 1; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-increment: x++; -> x = x + 1;
    postincrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;

        \find(\modality{#mod}{c# s#lhs++; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#lhs + 1; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-decrement: x--; -> x = x - 1;
    postdecrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;

        \find(\modality{#mod}{c# s#lhs--; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#lhs - 1; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-increment assignment: y = ++x; -> x = x + 1; y = x;
    preincrement_assignment {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs0;
        \schemaVar \program Variable lhs1;

        \find(\modality{#mod}{c# s#lhs0 = ++s#lhs1; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs1 = s#lhs1 + 1; s#lhs0 = s#lhs1; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement assignment: y = --x; -> x = x - 1; y = x;
    predecrement_assignment {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs0;
        \schemaVar \program Variable lhs1;

        \find(\modality{#mod}{c# s#lhs0 = --s#lhs1; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs1 = s#lhs1 - 1; s#lhs0 = s#lhs1; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-increment assignment: y = x++; -> T pv = x; x = x + 1; y = pv;
    postincrement_assignment {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs0;
        \schemaVar \program Variable lhs1;
        \schemaVar \program Variable pv;
        \schemaVar \program Type lhsType;

        \find(\modality{#mod}{c# s#lhs0 = s#lhs1++; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, lhs0), \newTypeOf(lhsType, lhs0))
        \replacewith(\modality{#mod}{c# s#lhsType s#pv = s#lhs1;
            s#lhs1 = s#lhs1 + 1; s#lhs0 = s#pv; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-decrement assignment: y = x--; -> T pv = x; x = x - 1; y = pv;
    postdecrement_assignment {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs0;
        \schemaVar \program Variable lhs1;
        \schemaVar \program Variable pv;
        \schemaVar \program Type lhsType;

        \find(\modality{#mod}{c# s#lhs0 = s#lhs1--; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, lhs0), \newTypeOf(lhsType, lhs0))
        \replacewith(\modality{#mod}{c# s#lhsType s#pv = s#lhs1;
            s#lhs1 = s#lhs1 - 1; s#lhs0 = s#pv; #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

}
