    memoryFieldDeletePrimitive {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple] mp;
        \schemaVar \program Field a;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# delete s#mp.s#a; #c}\endmodality(post))
        \varcond(\sameAsTerm(a, fieldA), \hasMemoryFieldSort(a, \sort(alpha)),
                 \not\isMemoryReferenceField(a))
        \replacewith({memory := write(memory, mp, fieldA, defaultValue<[alpha]>)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldDeleteReference {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple] mp;
        \schemaVar \program Field a;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# delete s#mp.s#a; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\sameAsTerm(a, fieldA), \isMemoryReferenceField(a))
        "freshen":
            \replacewith({memory := write(addM(memory, freshIdp), mp, fieldA,
                                          idC(freshIdp, nil))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(new(memory, freshIdp) ==>)
        \heuristics(simplify_prog)
    };

