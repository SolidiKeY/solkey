        \find(\modality{#mod}{c# s#sp /= s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath))
        \replacewith(\if(se != 0)
            \then({storage := save(storage, spPath, find<[int]>(storage, spPath) / se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
