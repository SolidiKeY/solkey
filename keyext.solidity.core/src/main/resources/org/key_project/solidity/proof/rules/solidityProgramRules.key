    // ------------------------------------------------------------------------
    // ----------- Rules for value variable declarations
    // ------------------------------------------------------------------------

    // Declarations with initialization are decomposed by localValueDeclInitDrop,
    // storageLocalDeclInitDrop, and memoryLocalDeclInitDrop (one per data location).

    localValueDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#varType s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // Skip bare value variable declaration and add to program variables
    valueDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
