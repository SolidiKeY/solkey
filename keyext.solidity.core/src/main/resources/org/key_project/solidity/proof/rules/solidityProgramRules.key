    // ------------------------------------------------------------------------
    // ----------- Rules for value variable declarations
    // ------------------------------------------------------------------------

    // Split declaration with initialization: T vp = e; => T vp; vp = e;
    valueDeclInitSplit {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program Expression e;

        \find(\modality{#mod}{c# s#varType s#vp = s#e; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#varType s#vp; s#vp = s#e; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Skip bare value variable declaration and add to program variables
    valueDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable[name=value] vp;

        \find(\modality{#mod}{c# s#varType s#vp; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(vp)
        \heuristics(simplify_prog)
    };

