        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#se1 >= s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#se1 >= s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterEqualAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 >= s#se2; #c}\endmodality(post))
        \replacewith({v := \if(geq(se1, se2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── logical operators (&&, ||, !) ───────────────────────────────────────

    // --- logical and (&&) ---
    logicalAndCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#nse && s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#pv && s#e; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalAndAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 && s#se2; #c}\endmodality(post))
        \replacewith({v := \if(se1 = TRUE)\then(\if(se2 = TRUE)\then(TRUE)\else(FALSE))\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalAndShortCircuitRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# s#v = s#se && s#nse; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#v = s#nse; else s#v = false; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- logical or (||) ---
    logicalOrCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#nse || s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#pv || s#e; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalOrAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 || s#se2; #c}\endmodality(post))
        \replacewith({v := \if(se1 = TRUE)\then(TRUE)\else(\if(se2 = TRUE)\then(TRUE)\else(FALSE))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalOrShortCircuitRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# s#v = s#se || s#nse; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#v = true; else s#v = s#nse; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- logical not (!) ---
    logicalNotCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = !s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = !s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalNotAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#v = !s#se; #c}\endmodality(post))
        \replacewith({v := \if(se = TRUE)\then(FALSE)\else(TRUE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── conditional operator (?:) ───────────────────────────────────────────

    ternaryCaptureCond {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e1;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#nse ? s#e1 : s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#pv ? s#e1 : s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    ternaryToIf {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Expression e1;
        \schemaVar \program Expression e2;

        \find(\modality{#mod}{c# s#v = s#se ? s#e1 : s#e2; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#v = s#e1; else s#v = s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // The twin of ternaryToIf for a storage-path target, which is not a Variable.
    ternaryToIfStorage {
        \schemaVar \formula post;
        \schemaVar \program Path[storage] sp;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Expression e1;
        \schemaVar \program Expression e2;

        \find(\modality{#mod}{c# s#sp = s#se ? s#e1 : s#e2; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#sp = s#e1; else s#sp = s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── if / if-else statements ─────────────────────────────────────────────

    ifUnfold {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Statement s0;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# if (s#nse) s#s0 #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      if (s#pv) s#s0 #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    ifElseUnfold {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Statement s0;
        \schemaVar \program Statement s1;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# if (s#nse) s#s0 else s#s1 #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      if (s#pv) s#s0 else s#s1 #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    ifSplit {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Statement s0;

        \find( ==> \modality{#mod}{c# if (s#se) s#s0 #c}\endmodality(post))
        "if s#se true":
            \replacewith( ==> \modality{#mod}{c# s#s0 #c}\endmodality(post))
            \add(se = TRUE ==>);
        "if s#se false":
            \replacewith( ==> \modality{#mod}{c# #c}\endmodality(post))
            \add(se = FALSE ==>)
        \heuristics(simplify_prog)
    };

    ifElseSplit {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Statement s0;
        \schemaVar \program Statement s1;

        \find( ==> \modality{#mod}{c# if (s#se) s#s0 else s#s1 #c}\endmodality(post))
        "if s#se true":
            \replacewith( ==> \modality{#mod}{c# s#s0 #c}\endmodality(post))
            \add(se = TRUE ==>);
        "if s#se false":
            \replacewith( ==> \modality{#mod}{c# s#s1 #c}\endmodality(post))
            \add(se = FALSE ==>)
        \heuristics(simplify_prog)
    };

    // ── unary minus (-x) ────────────────────────────────────────────────────

    unaryMinusCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = -s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = -s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    unaryMinusAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#v = -s#se; #c}\endmodality(post))
        \replacewith({v := -se}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    assertSimple {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;

        \find(\modality{#mod}{c# assert(s#pv); #c}\endmodality(post))
        "Holds":
            \replacewith(\modality{#mod}{c# #c}\endmodality(post))
            \add(pv = TRUE ==>);
        "Violated":
            \replacewith(pv = TRUE)
        \heuristics(simplify_prog)
    };

    requireConditionCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# require(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      require(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    requireSimple {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;

        \find(\modality{#mod}{c# require(s#pv); #c}\endmodality(post))
        "Holds":
            \replacewith(pv = FALSE | \modality{#mod}{c# #c}\endmodality(post));
        "Reverts":
            \replacewith(pv = TRUE | \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for address payments: a.transfer(v) (docs/net.md)
    // ------------------------------------------------------------------------

    transfer_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nse.transfer(s#e); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#pv.transfer(s#e); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    transfer_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] a;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#a.transfer(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#a.transfer(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

}

\rules(transferSemantics:noCallback) {

    // The EVM value-transfer check: a transfer that the contract's own funds
    // cannot cover reverts. A negative amount is unrepresentable in the EVM's
    // unsigned value field and is folded into the same revert branch.
    transferNoCallback {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] a;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#a.transfer(s#se); #c}\endmodality(post))
        \replacewith(\if(0 <= se & se <= selfBalance)
            \then({selfBalance := selfBalance - se
                   || net := storeSt(net, at(a),
                                     selectSt<[int]>(net, at(a)) - se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

}

\rules(transferSemantics:withCallback) {

    // The callback havoc quantifies over the balance alongside storage and the
    // ledger: the callee may move funds in or out before control returns.
    transferWithCallback {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] a;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;
        \schemaVar \skolemTerm int selfBalanceSk;

        \find(\modality{#mod}{c# s#a.transfer(s#se); #c}\endmodality(post))
        "insufficient funds":
            \replacewith(!(0 <= se & se <= selfBalance)
                -> \modality{#mod}{c# revert(); #c}\endmodality(post));
        "invariant on exit":
            \replacewith(0 <= se & se <= selfBalance
                -> {selfBalance := selfBalance - se
                    || net := storeSt(net, at(a),
                                      selectSt<[int]>(net, at(a)) - se)}
                   CInv(storage, net));
        "resume after callback":
            \replacewith(0 <= se & se <= selfBalance
                -> {storage := storageSk || net := netSk
                    || selfBalance := selfBalanceSk}
                   (CInv(storage, net) -> \modality{#mod}{c# #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

}
