\schemaVariables {
    \modalOperator {diamond, box} #allmodal;
}

\sorts {
    Field;
    List;

    \generic alpha;
}


\functions{
    // Core
    \unique List nil;
    \unique List cons(any, List);
    List consr(List, any);

    alpha head<[alpha]>(List);
    List tail(List);

    List firsts(List);
    alpha last<[alpha]>(List);

    Memory write(Memory, Identity, Field, any);
    Memory addM(Memory, IdentityPrim);
    alpha read<[alpha]>(Memory, Identity, Field);
    alpha readR<[alpha]>(Memory, Identity, List);

    \unique Identity idC(IdentityPrim, List);
    Identity idCC(IdentityPrim);
    alpha default<[alpha]>(Identity, Field);
    alpha defaultF<[alpha]>(Field);

    // Storage
    \unique Struct mtSt;

    Struct storeSt(Struct, Field, any);
    Struct save(Struct, List, any);
    alpha selectSt<[alpha]>(Struct, Field);
    alpha find<[alpha]>(Struct, List);

    \unique Field size;

    // Memory to Storage
    Struct copyMem(Struct, Memory, Identity);

    // Storage to Memory
    Memory copySt(Memory, IdentityPrim, any);

    // Helpers
    List cons1(any);
    List cons2(any, any);
    List cons3(any, any, any);
}

\predicates {
    new(Memory, IdentityPrim);
    isPrimitive(Field);
    sizeLE1(List);
    isEmpty(List);
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field fld, fld1, fld2;
    \term List fxs, flds, xs;
    \term any x, y, z, v, v0, v1;
    \term int iv;
    \term Memory mem;
    \term Struct st;
}

\programVariables {
}

\rules {
}

\rules(programRules:Solidity) {
   emptyModality {
     \schemaVar \formula post;
     \find(\modality{#allmodal}{}\endmodality (post))
     \replacewith(post)
     \heuristics(simplify_prog)
   };


    // Core
    headDefinition {
        \find(head<[alpha]>(cons(x, xs)))
        \replacewith(x)
        \heuristics(simplify)
    };

    tailDefinition {
        \find(tail(cons(x, xs)))
        \replacewith(xs)
        \heuristics(simplify)
    };

    lastConsNil {
        \find(last<[alpha]>(cons(x, nil)))
        \replacewith(x)
        \heuristics(simplify)
    };

    lastConsRest {
        \find(last<[alpha]>(cons(x, cons(y, xs))))
        \replacewith(last<[alpha]>(cons(y, xs)))
        \heuristics(simplify)
    };

    firstsConsNil {
        \find(firsts(cons(x, nil)))
        \replacewith(nil)
        \heuristics(simplify)
    };

    firstsConsRest {
        \find(firsts(cons(x, cons(y, xs))))
        \replacewith(cons(x, firsts(cons(y, xs))))
        \heuristics(simplify)
    };

    isEmptyEmpty {
        \find(isEmpty(nil))
        \replacewith(true)
        \heuristics(concrete)
    };

    isEmptyCons {
        \find(isEmpty(cons(x, xs)))
        \replacewith(false)
        \heuristics(concrete)
    };

    sizeLE1Empty {
        \find(sizeLE1(nil))
        \replacewith(true)
        \heuristics(concrete)
    };

    sizeLE1Cons {
        \find(sizeLE1(cons(x, nil)))
        \replacewith(true)
        \heuristics(concrete)
    };

    sizeLE1ConsCons {
        \find(sizeLE1(cons(x, cons(y, xs))))
        \replacewith(false)
        \heuristics(concrete)
    };

    consREmpty {
        \find(consr(nil, x))
        \replacewith(cons(x,nil))
        \heuristics(simplify)
    };

    consRcons {
        \find(consr(cons(x, xs), y))
        \replacewith(cons(x, consr(xs, y)))
        \heuristics(simplify)
    };

    // Auxiliary
    defaultDef {
        \find(default<[alpha]>(idC(idp, flds), fld))
        \replacewith(
            \if(isPrimitive(fld))
            \then(defaultF<[alpha]>(fld))
            \else(idC(idp, consr(flds,fld)))
        )
        \heuristics(simplify)
    };

    idCCDef {
        \find(idCC(idp))
        \replacewith(idC(idp, nil))
        \heuristics(concrete)
    };

    // Memory
    readOnWrite {
        \find(read<[alpha]>(write(mem, id1, fld1, v), id2, fld2))
        \replacewith( \if ( id1 = id2 & fld1 = fld2)
                      \then (v)
                      \else (read<[alpha]>(mem, id2, fld2))
                    )
        \heuristics(simplify_enlarging)
    };

    readOnAddM {
        \find(read<[alpha]>(addM(mem, idp1), idC(idp2, flds), fld))
            \replacewith(
                \if (idp1 = idp2) \then (
                        default<[alpha]>(idC(idp2, flds), fld)
                ) \else (
                        read<[alpha]>(mem, idC(idp2, flds), fld)
                )
        )
        \heuristics(simplify_enlarging)
    };

    readFromEmptyMemory {
        \find(read<[alpha]>(mtMem, id, fld))
        \replacewith(default<[alpha]>(id, fld))
        \heuristics(simplify)
    };

    readREmpty {
        \find(readR<[alpha]>(mem, id, cons(fld, nil)))
        \replacewith( read<[alpha]>(mem, id, fld) )
        \heuristics(simplify)
    };

    readRCons {
        \find(readR<[alpha]>(mem, id, cons(fld1, cons(fld2, flds))))
        \replacewith(
            read<[alpha]>(mem, readR<[Identity]>(mem, id, firsts(cons(fld1, cons(fld2, flds)))),
               last<[Field]>(cons(fld1, cons(fld2, flds))))
        )
        \heuristics(simplify)
    };

    newFromAdd {
        \find(new(addM(mem, idp1), idp2))
        \replacewith(
            \if (idp1 = idp2)
            \then (false)
            \else (new(mem, idp2))
        )
        \heuristics(simplify_enlarging)
    };

    newFromWrite {
        \find(new(write(mem, id1, fld1, v), idp2))
        \replacewith(new(mem, idp2))
        \heuristics(simplify_enlarging)
    };

    newFromEmptyMemory {
        \find(new(mtMem, idp1))
        \replacewith(true)
        \heuristics(simplify_enlarging)
    };

    // Storage
    selectOnStore {
        \find(selectSt<[alpha]>(storeSt(st, fld1, v), fld2))
        \replacewith(
            \if (fld1 = fld2)
            \then (v)
            \else (selectSt<[alpha]>(st,fld2))
        )
        \heuristics(simplify_enlarging)
    };

    selectIntOnStore {
        \find(selectSt<[int]>(storeSt(st, fld1, iv), fld2))
        \replacewith(
            \if (fld1 = fld2)
            \then (iv)
            \else (selectSt<[int]>(st,fld2))
        )
        \heuristics(simplify)
    };

    selectOnEmptyStorage {
        \find(selectSt<[alpha]>(mtSt, fld))
        \replacewith(defaultF<[alpha]>(fld) )
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorageEmpty {
        \find(save(mtSt, nil, v))
        \replacewith(v)
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorage {
        \find(save(mtSt,cons(fld, flds), v))
        \replacewith( storeSt(mtSt, fld, save(mtSt, flds, v)) )
        \heuristics(simplify_enlarging)
    };

    saveOnStoreEmpty {
        \find(save(storeSt(st, fld, v0), nil, v1))
        \replacewith(v1)
        \heuristics(simplify_enlarging)
    };

    saveOnStoreCons {
        \find(save(storeSt(st, fld1, v0), cons(fld2, flds), v1))
        \replacewith(
            \if (fld1 = fld2)
            \then ( storeSt(st, fld1,
                \if ( isEmpty(flds) )
                \then ( v1 )
                \else ( save( (Struct)v0, flds, v1) )
            ))
            \else ( storeSt(save(st, cons(fld2, flds), v1), fld1, v0) )
        )
        \heuristics(simplify_enlarging)
    };

    findDefinitionEmpty {
        \find(find<[alpha]>(st, nil))
        \replacewith( (alpha) st )
        \heuristics(simplify_enlarging)
    };

    findDefinitionCons {
        \find(find<[alpha]>(st, cons(fld, flds)))
        \replacewith(
            \if(isEmpty(flds))
            \then( selectSt<[alpha]>(st, fld) )
            \else( find<[alpha]>(selectSt<[Struct]>(st, fld), flds) )
        )
        \heuristics(simplify_enlarging)
    };

    // lazy
    saveOnEmpty {
        \find(save(st, nil, v))
        \replacewith(v)
        \heuristics(simplify)
    };

    selectOnSaveEmpty {
        \find(selectSt<[alpha]>(save(st,nil,v), fld))
        \replacewith(selectSt<[alpha]>(save(st,flds,v), fld))
        \heuristics(simplify)
    };

    selectOnSaveCons {
        \find(selectSt<[alpha]>(save(st,cons(fld1, flds),v), fld2))
        \replacewith(
            \if(fld1 = fld2)
            \then( (alpha) save(selectSt<[Struct]>(st,fld1), flds, v) )
            \else( selectSt<[alpha]>(st, fld2) )
        )
        \heuristics(simplify)
    };

    // Memory To Storage

    findOnCopy {
        \find(find<[alpha]>(copyMem(st, mem, id), flds))
        \replacewith(
            \if (!isEmpty(flds) & isPrimitive(last<[Field]>(flds)))
            \then (readR<[alpha]>(mem, id, flds))
            \else (find<[alpha]>(copyMem(st, mem, id), flds))
        )
        \heuristics(simplify_enlarging)
    };

    // Storage to Memory

    readFromCopyToStorage {
        \find( read<[alpha]>(copySt(mem, idp1, st), idC(idp2, fxs), fld) )
        \replacewith (
            \if (idp1 = idp2)
            \then (
                \if ( isPrimitive(fld) )
                \then ( find<[alpha]>(st, consr(fxs, fld)) )
                \else ( idC(idp1, consr(fxs, fld)) )
            )
            \else ( read<[alpha]>(mem, idC(idp2, fxs), fld) )
        )
        \heuristics(simplify_enlarging)
    };

    // Helpers
    cons1Def {
        \find(cons1(x))
        \replacewith(cons(x, nil))
        \heuristics(concrete)
    };

    cons2Def {
        \find(cons2(x, y))
        \replacewith(cons(x, cons(y, nil)))
        \heuristics(concrete)
    };

    cons3Def {
        \find(cons3(x, y, z))
        \replacewith(cons(x, cons(y, cons(z, nil))))
        \heuristics(concrete)
    };
}
