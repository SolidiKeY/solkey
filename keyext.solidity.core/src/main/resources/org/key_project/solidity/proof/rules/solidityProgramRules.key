\schemaVariables {
    \modalOperator {diamond, box} #allmodal;
    \modalOperator {diamond, box} #mod;
    \modalOperator {diamond} #diamond;
    \modalOperator {box} #box;
}

\sorts {
    List;
    \generic alpha;
}


\functions{
}

\predicates {
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field fld, fld1, fld2;
    \term List fxs, flds, xs;
    \term any x, y, z, v, v0, v1;
    \term int iv;
    \term Memory mem;
    \term Struct st;
    \skolemTerm IdentityPrim freshIdp;
}

\programVariables {
}

\rules {
}

\rules(programRules:Solidity) {
    emptyModality {
         \schemaVar \formula post;
         \find(\modality{#allmodal}{}\endmodality (post))
         \replacewith(post)
         \heuristics(simplify_prog)
    };

    revertDiamond {
         \schemaVar \formula post;
         \find(\modality{#diamond}{c# revert(); #c}\endmodality(post))
         \replacewith(false)
         \heuristics(simplify_prog)
    };

    revertBox {
         \schemaVar \formula post;
         \find(\modality{#box}{c# revert(); #c}\endmodality(post))
         \replacewith(true)
         \heuristics(simplify_prog)
    };

    storageRootWriteStore {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program SimpleExpression[name=value] se;
        \schemaVar \term List lhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath))
        \replacewith({storage := save(storage, lhsPath, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List lhsPath;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath), \sameAsTerm(rootRhs, rhsPath))
        \replacewith({storage := save(storage, lhsPath, find<[int]>(storage, rhsPath))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource_struct {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] rootLhs;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List lhsPath;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#rootLhs = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootLhs, lhsPath), \sameAsTerm(rootRhs, rhsPath))
        \replacewith({storage := save(storage, lhsPath, find<[Struct]>(storage, rhsPath))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#vp =s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsPath))
        \replacewith({vp := find<[int]>(storage, rhsPath)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteSave {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression[name=value] se;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# s#sp.s#a = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(a, fieldA))
        \replacewith({storage := save(storage, consr(spPath, fieldA), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp1;
        \schemaVar \program Field a;
        \schemaVar \program Path[name=storage.simple] sp2;
        \schemaVar \term List sp1Path;
        \schemaVar \term List sp2Path;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# s#sp1.s#a = s#sp2; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp1, sp1Path), \sameAsTerm(a, fieldA),
            \sameAsTerm(sp2, sp2Path))
        \replacewith({storage := save(storage, consr(sp1Path, fieldA),
                find<[Struct]>(storage, sp2Path))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nsp.s#a; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lhs = s#sp.s#a; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field a;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# s#vp = s#sp.s#a; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(a, fieldA))
        \replacewith({vp := find<[int]>(storage, consr(spPath, fieldA))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#a = s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#a = s#se; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_root {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global.mapping] indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedRoot[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(indexedRootPath, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_root {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global.mapping] indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp =s#indexedRoot[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith({vp := find<[int]>(storage, consr(indexedRootPath, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple.mapping] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \term List spPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#lp = s#sp[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(indexExpr, idx))
        \replacewith({lp := consr(spPath, at(idx))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.mapping] sp1;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Path[name=storage.simple] sp2;
        \schemaVar \term List sp1Path;
        \schemaVar \term List sp2Path;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#sp1[s#indexExpr] = s#sp2; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp1, sp1Path), \sameAsTerm(indexExpr, idx),
            \sameAsTerm(sp2, sp2Path))
        \replacewith({storage := save(storage, consr(sp1Path, at(idx)),
                find<[Struct]>(storage, sp2Path))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMapRefRhsCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.mapping] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=storage] src;
        \schemaVar \program Type srcType;

        \find(\modality{#mod}{c# s#sp[s#indexExpr] = s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(src, nse), \newTypeOf(srcType, nse))
        \replacewith(\modality{#mod}{c# s#srcType storage s#src = s#nse;
                                      s#sp[s#indexExpr] = s#src; #c}\endmodality(post))
        \addprogvars(src)
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.mapping] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedBase[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({storage := save(storage, consr(pathFields, at(idx)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.mapping] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp =s#indexedBase[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        \replacewith({vp := find<[int]>(storage, consr(pathFields, at(idx)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArraySave_root {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global.array] indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedRoot[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        // The bounds must be checked against the CURRENT storage, i.e. after any
        // preceding mutation (push/write) recorded in the pending update U in front of
        // this modality. Emitting them via \add would add them OUTSIDE U, reading the
        // pre-update storage length (so e.g. `a.push(100); a[0] = 7;` would check 0 <
        // len(empty array) and wrongly revert). Instead the bound is the antecedent of an
        // implication inside \replacewith, so {U} distributes onto it and the length is
        // read from the post-mutation storage. The two branches keep the revert split that
        // makes the rule modality-generic: in `[·]`, the out-of-bounds branch is
        // `!bound -> [revert] = true` (vacuous); in `<·>` it is `!bound -> <revert> =
        // false`, i.e. the index must be proven in bounds.
        "inBounds":
            \replacewith(0 <= idx & idx < find<[int]>(storage, consr(indexedRootPath, size))
                -> {storage := save(storage, consr(indexedRootPath, at(idx)), se)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= idx & idx < find<[int]>(storage, consr(indexedRootPath, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayFind_root {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global.array] indexedRoot;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List indexedRootPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp =s#indexedRoot[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedRoot, indexedRootPath), \sameAsTerm(indexExpr, idx))
        \replacewith(0 <= idx & idx < find<[int]>(storage, consr(indexedRootPath, size))
                & {vp := find<[int]>(storage, consr(indexedRootPath, at(idx)))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArraySave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.array] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#indexedBase[s#indexExpr] = s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        "inBounds":
            \replacewith(0 <= idx & idx < find<[int]>(storage, consr(pathFields, size))
                -> {storage := save(storage, consr(pathFields, at(idx)), se)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= idx & idx < find<[int]>(storage, consr(pathFields, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.array] indexedBase;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \term List pathFields;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#vp =s#indexedBase[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(indexedBase, pathFields), \sameAsTerm(indexExpr, idx))
        // Bounds in the post-update storage (see storageIndexReadArrayFind_root).
        \replacewith(0 <= idx & idx < find<[int]>(storage, consr(pathFields, size))
                & {vp := find<[int]>(storage, consr(pathFields, at(idx)))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \term List spPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#lp = s#sp[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(indexExpr, idx))
        // Bounds in the post-update storage (see storageIndexReadArrayFind_root).
        \replacewith(0 <= idx & idx < find<[int]>(storage, consr(spPath, size))
                & {lp := consr(spPath, at(idx))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] gp;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \term List gpPath;
        \schemaVar \term List spPath;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#gp = s#sp[s#indexExpr]; #c}\endmodality(post))
        \varcond(\sameAsTerm(gp, gpPath), \sameAsTerm(sp, spPath),
            \sameAsTerm(indexExpr, idx))
        // Bounds in the post-update storage (see storageIndexReadArrayFind_root).
        \replacewith(0 <= idx & idx < find<[int]>(storage, consr(spPath, size))
                & {storage := save(storage, gpPath,
                        find<[int]>(storage, consr(spPath, at(idx))))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArrayCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.array] sp1;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \program Path[name=storage.simple] sp2;
        \schemaVar \term List sp1Path;
        \schemaVar \term List sp2Path;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# s#sp1[s#indexExpr] = s#sp2; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp1, sp1Path), \sameAsTerm(indexExpr, idx),
            \sameAsTerm(sp2, sp2Path))
        "inBounds":
            \replacewith(0 <= idx & idx < find<[int]>(storage, consr(sp1Path, size))
                -> {storage := save(storage, consr(sp1Path, at(idx)),
                        find<[int]>(storage, sp2Path))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= idx & idx < find<[int]>(storage, consr(sp1Path, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for storage dynamic-array push and pop ----------------
    // ------------------------------------------------------------------------

    storagePushValue_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.array] nsp;
        \schemaVar \program SimpleExpression[name=value] se;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(s#se); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(s#se); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePush_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.array] nsp;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePop_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.array] nsp;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.pop(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.pop(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootPush_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.complex.array] nsp;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lp = s#nsp.push(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lp = s#sp.push(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePushValue_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#sp.push(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#sp.push(s#pv); #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };


    storagePushValueCopySource_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.complex.array] nsp;
        \schemaVar \program Path[name=storage.simple] sp2;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(s#sp2); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp), \newTypeOf(aliasType, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(s#sp2); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePushValueSave {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \program SimpleExpression[name=value] se;
        \schemaVar \term List spPath;

        \find(\modality{#mod}{c# s#sp.push(s#se); #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath))
        \replacewith({storage := save(save(storage,
                                      consr(spPath, at(find<[int]>(storage,
                                          consr(spPath, size)))), se),
                                      consr(spPath, size),
                                      find<[int]>(storage, consr(spPath, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Push a copy of the struct referenced by the simple storage path sp2 onto sp1.
    // Mirrors storageFieldWriteCopySource / storageRootWriteCopySource_struct: a
    // copy-source push always copies a reference-typed (struct) payload, so the
    // value is read with find<[Struct]> directly rather than a generic sort.
    storagePushValueCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.array] sp1;
        \schemaVar \program Path[name=storage.simple] sp2;
        \schemaVar \term List sp1Path;
        \schemaVar \term List sp2Path;

        \find(\modality{#mod}{c# s#sp1.push(s#sp2); #c}\endmodality(post))
        \varcond(\sameAsTerm(sp1, sp1Path), \sameAsTerm(sp2, sp2Path))
        \replacewith({storage := save(save(storage,
                                      consr(sp1Path, at(find<[int]>(storage,
                                          consr(sp1Path, size)))),
                                      find<[Struct]>(storage, sp2Path)),
                                      consr(sp1Path, size),
                                      find<[int]>(storage, consr(sp1Path, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushLengthSave {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \term List spPath;

        \find(\modality{#mod}{c# s#sp.push(); #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath))
        \replacewith({storage := save(storage, consr(spPath, size),
                                      find<[int]>(storage, consr(spPath, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storageLocalRootPushBind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \term List spPath;

        \find(\modality{#mod}{c# s#lp = s#sp.push(); #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath))
        // The storage bump and the alias bind must be parallel: the new element's
        // index is the *pre-push* length find(storage, sp·size). Emitting these as a
        // sequential {storage := ...}{lp := ...} would apply the bump to lp's index,
        // wrongly binding lp to at(post-push length) instead of at(pre-push length).
        \replacewith({storage := save(storage, consr(spPath, size),
                                      find<[int]>(storage, consr(spPath, size)) + 1)
                      || lp := consr(spPath, at(find<[int]>(storage, consr(spPath, size))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePopSave {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.array] sp;
        \schemaVar \term List spPath;

        \find(\modality{#mod}{c# s#sp.pop(); #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \hasElementSort(sp, \sort(alpha)))
        "nonEmpty":
            \replacewith(0 < find<[int]>(storage, consr(spPath, size))
                -> {storage := save(save(storage,
                                         consr(spPath, at(find<[int]>(storage,
                                             consr(spPath, size)) - 1)),
                                         defaultValue<[alpha]>),
                                         consr(spPath, size),
                                         find<[int]>(storage, consr(spPath, size)) - 1)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "empty":
            \replacewith(!(0 < find<[int]>(storage, consr(spPath, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclInitSplit {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program StoragePath path;

        \find(\modality{#mod}{c# s#aliasType storage s#lp = s#path; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#lp; s#lp = s#path; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=storage] lp;
        \schemaVar \program Path[name=storage.simple] rootRhs;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#lp = s#rootRhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rootRhs, rhsPath))
        \replacewith({lp := rhsPath}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=storage] lp;

        \find(\modality{#mod}{c# s#aliasType storage s#lp; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lp)
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for memory reference allocation
    // ------------------------------------------------------------------------

    memoryReferenceDeclFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=memory] mp;

        \find(\modality{#mod}{c# s#aliasType memory s#mp; #c}\endmodality(post))
        "alloc":
            \replacewith({mp := idC(freshIdp, nil)}
                {memory := addM(memory, freshIdp)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(new(memory, freshIdp) ==>)
            \addprogvars(mp);
        "fresh":
            \add( ==> new(memory, freshIdp))
        \heuristics(simplify_prog)
    };

    memoryRootDeleteFreshRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=memory] mp;

        \find(\modality{#mod}{c# delete s#mp; #c}\endmodality(post))
        "rebind":
            \replacewith({mp := idC(freshIdp, nil)}
                {memory := addM(memory, freshIdp)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(new(memory, freshIdp) ==>);
        "fresh":
            \add( ==> new(memory, freshIdp))
        \heuristics(simplify_prog)
    };

    memoryLocalDeclInitRootAlias {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=memory] lhs;
        \schemaVar \program Path[name=memory.simple] rhs;

        \find(\modality{#mod}{c# s#aliasType memory s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith({lhs := rhs}
            \modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    memoryRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=memory] lhs;
        \schemaVar \program Path[name=memory.simple] rhs;

        \find(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith({lhs := rhs}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryArrayDeclFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type arrayType;
        \schemaVar \program Variable[name=memory] mp;
        \schemaVar \program SimpleExpression lenExpr;
        \schemaVar \term int len;

        \find(\modality{#mod}{c# s#arrayType memory s#mp = new s#arrayType(s#lenExpr);
                             #c}\endmodality(post))
        \varcond(\sameAsTerm(lenExpr, len))
        \replacewith({mp := idC(freshIdp, nil)}
            {memory := write(addM(memory, freshIdp), idC(freshIdp, nil), size, len)}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>)
        \addprogvars(mp)
        \heuristics(simplify_prog)
    };

    memoryLocalDeclInitStorageCopy {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[name=memory] lhs;
        \schemaVar \program Path[name=storage.simple] rhs;
        \schemaVar \term List rhsPath;

        \find(\modality{#mod}{c# s#aliasType memory s#lhs = s#rhs; #c}\endmodality(post))
        \varcond(\sameAsTerm(rhs, rhsPath))
        \replacewith({lhs := idC(freshIdp, nil)}
            {memory := copySt(addM(memory, freshIdp), freshIdp,
                              find<[Struct]>(storage, rhsPath))}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>)
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    memoryLocalDeclInitStorageCopyUnfold {
        \schemaVar \formula post;
