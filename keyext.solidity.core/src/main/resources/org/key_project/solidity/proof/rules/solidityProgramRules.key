        \schemaVar \program Variable[name=memory] lhs;
        \schemaVar \program Path[name=storage.complex] rhs;
        \schemaVar \program Variable[name=storage] sp;
        \schemaVar \program Type spType;

        \find(\modality{#mod}{c# s#aliasType memory s#lhs = s#rhs; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, rhs), \newTypeOf(spType, rhs))
        \replacewith(\modality{#mod}{c# s#spType storage s#sp = s#rhs;
                                      s#aliasType memory s#lhs = s#sp; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldWrite {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple] mp;
