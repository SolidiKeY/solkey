    // ------------------------------------------------------------------------
    // ----------- Rules for `delete` (storage, primitive targets) -------------
    // ------------------------------------------------------------------------

    // delete sp;  -- save the storage path type's default value.
    storageRootDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global] sp;
        \schemaVar \term List spPath;

        \find(\modality{#mod}{c# delete s#sp; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \hasSort(sp, \sort(alpha)))
        \replacewith({storage := save(storage, spPath,
                                      delValue<[alpha]>(find<[alpha]>(storage, spPath)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // delete sp.a;  -- field write of the field's default value
    storageFieldDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
        \schemaVar \program Field a;
        \schemaVar \term List spPath;
        \schemaVar \term Field fieldA;

        \find(\modality{#mod}{c# delete s#sp.s#a; #c}\endmodality(post))
        \varcond(\sameAsTerm(sp, spPath), \sameAsTerm(a, fieldA),
                 \hasFieldSort(a, \sort(alpha)))
        \replacewith({storage := save(storage, consr(spPath, fieldA),
                                      delValue<[alpha]>(find<[alpha]>(storage,
                                          consr(spPath, fieldA))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // delete sp[i];  -- indexed write of the element/value default value.
    storageIndexDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple] sp;
