    memoryIndexWriteArray {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array] mp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mp[s#i] = s#se; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(memory, mp, at(i), se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= i & i < read<[int]>(memory, mp, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= i & i < read<[int]>(memory, mp, size))
        \heuristics(simplify_prog)
