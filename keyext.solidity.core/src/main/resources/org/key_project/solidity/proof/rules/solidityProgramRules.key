        \schemaVar \program Variable v;
        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# s#v = s#lv--; #c}\endmodality(post))
        \replacewith({v := lv} {lv := lv - 1}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── increment / decrement of a local as a statement of its own ──────────

    localPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# ++s#lv; #c}\endmodality(post))
        \replacewith({lv := lv + 1}
