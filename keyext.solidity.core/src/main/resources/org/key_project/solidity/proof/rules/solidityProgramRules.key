    memoryIndexWriteMemRefRhsCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple.array] mp;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=memory] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#mp[s#e] = s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType memory s#pv = s#nse;
                                      s#mp[s#e] = s#pv; #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };

    // Step 1 (RHS-before-LHS): capture a non-simple right-hand side of a storage
    // array index write into a fresh value temp, EMITTED FIRST. Solidity evaluates the
    // RHS before the LHS index, so `a[++i] = ++i;` must bind the RHS `++i` before the
    // index `++i`. The storage array analogue of memoryIndexWriteMemRefRhsCapture /
    // storageIndexWriteMapRefRhsCapture. Ordering is self-enforcing by SV kind: while the
    // RHS is non-simple this rule fires (storageIndexWriteNonSimpleIndexCapture needs a
    // SimpleExpression RHS, so it cannot fire first); once the RHS is the simple temp,
    // only the index-capture rule applies. The index `e` is left as an arbitrary
    // Expression so a non-simple index is captured afterwards by the index-capture rule.
    storageIndexWriteNonSimpleRhsCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global.array] sp;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#sp[s#e] = s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#sp[s#e] = s#pv; #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };

    storageIndexWriteNonSimpleIndexCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[name=storage.simple.global.array] sp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#sp[s#nse] = s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#sp[s#pv] = s#se; #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };

    memoryIndexWriteNonSimpleIndexCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple.array] mp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#mp[s#nse] = s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#mp[s#pv] = s#se; #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };

    // ── assert rules ────────────────────────────────────────────────────────

    // Step 1: Hoist non-simple condition into a bool temp.
    // assert(nse);  →  bool pv = nse; assert(pv);
    assertConditionCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# assert(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      assert(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Normalize non-simple LHS of equality: vp = nse == e2;  →  T pv = nse; vp = pv == e2;
    boolEqualityCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse == s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv == s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Step 2: Assign the result of a simple equality comparison to a bool var.
    // vp = se1 == se2;  →  {vp := \if(t1=t2)\then(TRUE)\else(FALSE)}
    boolEqualityAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term any t1;
        \schemaVar \term any t2;

        \find(\modality{#mod}{c# s#vp = s#se1 == s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(t1 = t2)\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── relational operators (!=, <, >, <=, >=) ─────────────────────────────

    // --- inequality (!=) ---
    boolInequalityCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse != s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv != s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    boolInequalityCaptureRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#se1 != s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#se1 != s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    boolInequalityAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term any t1;
        \schemaVar \term any t2;

        \find(\modality{#mod}{c# s#vp = s#se1 != s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(t1 = t2)\then(FALSE)\else(TRUE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- less-than (<) ---
    lessThanCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse < s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv < s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    lessThanCaptureRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#se1 < s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#se1 < s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    lessThanAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term int t1;
        \schemaVar \term int t2;

        \find(\modality{#mod}{c# s#vp = s#se1 < s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(lt(t1, t2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- greater-than (>) ---
    greaterThanCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse > s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv > s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterThanCaptureRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#se1 > s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#se1 > s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterThanAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term int t1;
        \schemaVar \term int t2;

        \find(\modality{#mod}{c# s#vp = s#se1 > s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(gt(t1, t2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- less-or-equal (<=) ---
    lessEqualCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse <= s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv <= s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    lessEqualCaptureRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#se1 <= s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#se1 <= s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    lessEqualAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term int t1;
        \schemaVar \term int t2;

        \find(\modality{#mod}{c# s#vp = s#se1 <= s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(leq(t1, t2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- greater-or-equal (>=) ---
    greaterEqualCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse >= s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv >= s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterEqualCaptureRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#se1 >= s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#se1 >= s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterEqualAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term int t1;
        \schemaVar \term int t2;

        \find(\modality{#mod}{c# s#vp = s#se1 >= s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(geq(t1, t2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── logical operators (&&, ||, !) ───────────────────────────────────────
    // Mirror Java compound_assignment_{3,5}_{simple,mixed} and
    // compound_assignment_1_new/_2. Operands are bool, lowered to bool terms.
    // The terminal _simple variants and the left-capture (_mixed) variants are
    // implemented now; the right-operand short-circuit (Java _nonsimple, which
    // expands to an if-statement) lands with the Tier-3 if rule.

    // --- logical and (&&) ---
    logicalAndCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse && s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv && s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalAndAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term bool t1;
        \schemaVar \term bool t2;

        \find(\modality{#mod}{c# s#vp = s#se1 && s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(t1 = TRUE)\then(\if(t2 = TRUE)\then(TRUE)\else(FALSE))\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- logical or (||) ---
    logicalOrCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse || s#e2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv || s#e2; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalOrAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \term bool t1;
        \schemaVar \term bool t2;

        \find(\modality{#mod}{c# s#vp = s#se1 || s#se2; #c}\endmodality(post))
        \varcond(\sameAsTerm(se1, t1), \sameAsTerm(se2, t2))
        \replacewith({vp := \if(t1 = TRUE)\then(TRUE)\else(\if(t2 = TRUE)\then(TRUE)\else(FALSE))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- logical not (!) ---
    logicalNotCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = !s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = !s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalNotAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term bool t;

        \find(\modality{#mod}{c# s#vp = !s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(se, t))
        \replacewith({vp := \if(t = TRUE)\then(FALSE)\else(TRUE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── unary minus (-x) ────────────────────────────────────────────────────
    // Mirror Java unaryMinusInt, using plain neg (-t); no overflow branch.

    unaryMinusCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = -s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse), \newTypeOf(pvType, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = -s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    unaryMinusAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term int t;

        \find(\modality{#mod}{c# s#vp = -s#se; #c}\endmodality(post))
        \varcond(\sameAsTerm(se, t))
        \replacewith({vp := -t}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Step 3: Split on a simple bool variable.
    // "Holds": pv = TRUE assumed, drop assert and continue.
    // "Violated": prove that pv = TRUE holds (closes when storage entails it).
    assertSimple {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \term bool pvTerm;

        \find(\modality{#mod}{c# assert(s#pv); #c}\endmodality(post))
        \varcond(\sameAsTerm(pv, pvTerm))
        "Holds":
            \replacewith(\modality{#mod}{c# #c}\endmodality(post))
            \add(pvTerm = TRUE ==>);
        "Violated":
            \replacewith(pvTerm = TRUE)
        \heuristics(simplify_prog)
    };

}
