\schemaVariables {
    \modalOperator {diamond, box} #allmodal;
    \modalOperator {diamond, box} #mod;
    \modalOperator {diamond} #diamond;
    \modalOperator {box} #box;
}

\sorts {
    List;
    \generic alpha;
    \generic alphaPrim \extends Prim;
    \generic alphaSt \extends StValue;
    \generic alphaMem \extends MemValue;
}


\functions{
}

\predicates {
}

\programVariables {
}

\rules {
}

\rules(programRules:Solidity) {

    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };

    emptyModality {
         \schemaVar \formula post;
         \find(\modality{#allmodal}{}\endmodality (post))
         \replacewith(post)
         \heuristics(simplify_prog)
    };

    blockEmpty {
         \schemaVar \formula post;
         \find(\modality{#mod}{c# {} #c}\endmodality(post))
         \replacewith(\modality{#mod}{c# #c}\endmodality(post))
         \heuristics(simplify_prog)
    };

    revertDiamond {
         \schemaVar \formula post;
         \find(\modality{#diamond}{c# revert(); #c}\endmodality(post))
         \replacewith(false)
         \heuristics(simplify_prog)
    };

    revertBox {
         \schemaVar \formula post;
         \find(\modality{#box}{c# revert(); #c}\endmodality(post))
         \replacewith(true)
         \heuristics(simplify_prog)
    };

    storageRootWriteStore {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gp;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#gp = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, gp, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gp;
        \schemaVar \program Path[storage,simple] sp;

        \find(\modality{#mod}{c# s#gp = s#sp; #c}\endmodality(post))
        \replacewith({storage := save(storage, gp, find<[StValue]>(storage, sp))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageRootReadSelect {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,primitive] sp;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#sp; #c}\endmodality(post))
        \varcond(\hasSort(sp, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, sp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp.s#a = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, a), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp1;
        \schemaVar \program Field a;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1.s#a = s#sp2; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp1, a),
                find<[Struct]>(storage, sp2))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWriteCaptureSrc {
        \schemaVar \formula post;
        \schemaVar \program Path[storage] sp;
        \schemaVar \program Field a;
        \schemaVar \program Path[storage,complex,reference] nsp;
        \schemaVar \program Variable[storage] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#sp.s#a = s#nsp; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nsp))
        \replacewith(\modality{#mod}{c# s#pvType storage s#pv = s#nsp;
                                      s#sp.s#a = s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nsp.s#a; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lhs = s#sp.s#a; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadFind {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field[primitive] a;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#sp.s#a; #c}\endmodality(post))
        \varcond(\hasFieldSort(a, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, consr(sp, a))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field a;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#a = s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#a = s#se; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_root {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp[s#i] = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, at(i)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_root {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping,primitiveElement] sp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#sp[s#i]; #c}\endmodality(post))
        \varcond(\hasElementSort(sp, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, consr(sp, at(i)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lp;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression i;

        \find(\modality{#mod}{c# s#lp = s#sp[s#i]; #c}\endmodality(post))
        \replacewith({lp := consr(sp, at(i))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gp;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression i;

        \find(\modality{#mod}{c# s#gp = s#sp[s#i]; #c}\endmodality(post))
        \replacewith({storage := save(storage, gp,
                find<[StValue]>(storage, consr(sp, at(i))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp1;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1[s#i] = s#sp2; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp1, at(i)),
                find<[StValue]>(storage, sp2))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteStorageRefRhsCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[storage] sp;
        \schemaVar \program Expression e;
        \schemaVar \program Path[storage,complex,reference] nsp;
        \schemaVar \program Variable[storage] pv;
        \schemaVar \program Type pvType;

        // evaluation order: Solidity evaluates right hand side first

        \find(\modality{#mod}{c# s#sp[s#e] = s#nsp; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nsp))
        \replacewith(\modality{#mod}{c# s#pvType storage s#pv = s#nsp;
                                      s#sp[s#e] = s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteMappingSave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,mapping] nsp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#nsp[s#i] = s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(nsp, at(i)), se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadMappingFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,mapping,primitiveElement] nsp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#nsp[s#i]; #c}\endmodality(post))
        \varcond(\hasElementSort(nsp, \sort(alphaPrim)))
        \replacewith({v := find<[alphaPrim]>(storage, consr(nsp, at(i)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArraySave_root {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp[s#i] = s#se; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= i & i < find<[int]>(storage, consr(sp, size))
                -> {storage := save(storage, consr(sp, at(i)), se)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= i & i < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayFind_root {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#sp[s#i]; #c}\endmodality(post))
        \varcond(\hasElementSort(sp, \sort(alphaPrim)))
        \replacewith(0 <= i & i < find<[int]>(storage, consr(sp, size))
                & {v := find<[alphaPrim]>(storage, consr(sp, at(i)))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArraySave_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#nsp[s#i] = s#se; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= i & i < find<[int]>(storage, consr(nsp, size))
                -> {storage := save(storage, consr(nsp, at(i)), se)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= i & i < find<[int]>(storage, consr(nsp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayFind_decompose {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array,primitiveElement] nsp;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v =s#nsp[s#i]; #c}\endmodality(post))
        \varcond(\hasElementSort(nsp, \sort(alphaPrim)))
        // Bounds in the post-update storage (see storageIndexReadArrayFind_root).
        \replacewith(0 <= i & i < find<[int]>(storage, consr(nsp, size))
                & {v := find<[alphaPrim]>(storage, consr(nsp, at(i)))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lp;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression i;

        \find(\modality{#mod}{c# s#lp = s#sp[s#i]; #c}\endmodality(post))
        // Bounds in the post-update storage (see storageIndexReadArrayFind_root).
        \replacewith(0 <= i & i < find<[int]>(storage, consr(sp, size))
                & {lp := consr(sp, at(i))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexReadArrayStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gp;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression i;

        \find(\modality{#mod}{c# s#gp = s#sp[s#i]; #c}\endmodality(post))
        // Bounds in the post-update storage (see storageIndexReadArrayFind_root).
        \replacewith(0 <= i & i < find<[int]>(storage, consr(sp, size))
                & {storage := save(storage, gp,
                        find<[StValue]>(storage, consr(sp, at(i))))}
                    \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteArrayCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp1;
        \schemaVar \program SimpleExpression i;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1[s#i] = s#sp2; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= i & i < find<[int]>(storage, consr(sp1, size))
                -> {storage := save(storage, consr(sp1, at(i)),
                        find<[StValue]>(storage, sp2))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= i & i < find<[int]>(storage, consr(sp1, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for storage dynamic-array push and pop ----------------
    // ------------------------------------------------------------------------

    storagePushValue_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(s#se); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(s#se); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePush_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePop_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.pop(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.pop(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootPush_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lp;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lp = s#nsp.push(); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#lp = s#sp.push(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePushValue_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#sp.push(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#sp.push(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };


    storagePushValueCopySource_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex,array] nsp;
        \schemaVar \program Path[storage,simple] sp2;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.push(s#sp2); #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.push(s#sp2); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePushValueSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#sp.push(s#se); #c}\endmodality(post))
        \replacewith({storage := save(save(storage,
                                      consr(sp, at(find<[int]>(storage,
                                          consr(sp, size)))), se),
                                      consr(sp, size),
                                      find<[int]>(storage, consr(sp, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushValueCopySource {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp1;
        \schemaVar \program Path[storage,simple] sp2;

        \find(\modality{#mod}{c# s#sp1.push(s#sp2); #c}\endmodality(post))
        \replacewith({storage := save(save(storage,
                                      consr(sp1, at(find<[int]>(storage,
                                          consr(sp1, size)))),
                                      find<[Struct]>(storage, sp2)),
                                      consr(sp1, size),
                                      find<[int]>(storage, consr(sp1, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushLengthSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;

        \find(\modality{#mod}{c# s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storageLocalRootPushBind {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lp;
        \schemaVar \program Path[storage,simple,array] sp;

        \find(\modality{#mod}{c# s#lp = s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, size),
                                      find<[int]>(storage, consr(sp, size)) + 1)
                      || lp := consr(sp, at(find<[int]>(storage, consr(sp, size))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePopSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;

        \find(\modality{#mod}{c# s#sp.pop(); #c}\endmodality(post))
        "nonEmpty":
            \replacewith(0 < find<[int]>(storage, consr(sp, size))
                -> {storage := save(delAt(storage,
                                         consr(sp, at(find<[int]>(storage,
                                             consr(sp, size)) - 1))),
                                         consr(sp, size),
                                         find<[int]>(storage, consr(sp, size)) - 1)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "empty":
            \replacewith(!(0 < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lp;
        \schemaVar \program Path[storage,simple] sp;

        \find(\modality{#mod}{c# s#lp = s#sp; #c}\endmodality(post))
        \replacewith({lp := sp}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[storage] lp;

        \find(\modality{#mod}{c# s#aliasType storage s#lp; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lp)
        \heuristics(simplify_prog)
    };

    storageLocalDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#aliasType storage s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for memory reference allocation
    // ------------------------------------------------------------------------

    memoryReferenceDeclFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[memory] mp;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#aliasType memory s#mp; #c}\endmodality(post))
        \replacewith({mp := idC(freshIdp, nil)}
            {memory := addM(memory, freshIdp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, freshIdp) ==>)
        \addprogvars(mp)
