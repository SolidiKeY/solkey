    localDeclPredecrement {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program Variable lv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#pvType s#pv = --s#lv; #c}\endmodality(post))
        \replacewith({pv := lv - 1} {lv := lv - 1}
            \modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };

    // Resolve the assignment form `v = --lv` where both are local value variables.
    localAssignPredecrement {
