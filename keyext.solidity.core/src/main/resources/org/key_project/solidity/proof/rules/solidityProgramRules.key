    // ------------------------------------------------------------------------
    // ----------- Rules for `delete` (storage, primitive targets) -------------
    // ------------------------------------------------------------------------

    // delete sp;  -- save the storage path type's default value.
    storageRootDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] sp;

        \find(\modality{#mod}{c# delete s#sp; #c}\endmodality(post))
        \varcond(\hasSort(sp, \sort(alpha)))
        \replacewith({storage := save(storage, sp,
                                      delValue<[alpha]>(find<[alpha]>(storage, sp)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // delete sp.a;  -- field write of the field's default value
    storageFieldDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field a;

        \find(\modality{#mod}{c# delete s#sp.s#a; #c}\endmodality(post))
        \varcond(\hasFieldSort(a, \sort(alpha)))
        \replacewith({storage := save(storage, consr(sp, a),
                                      delValue<[alpha]>(find<[alpha]>(storage,
                                          consr(sp, a))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // delete sp[i];  -- indexed write of the element/value default value.
    storageIndexDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program SimpleExpression indexExpr;

        \find(\modality{#mod}{c# delete s#sp[s#indexExpr]; #c}\endmodality(post))
        \varcond(\hasElementSort(sp, \sort(alpha)))
        \replacewith({storage := save(storage, consr(sp, at(indexExpr)),
                                      defaultValue<[alpha]>)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

