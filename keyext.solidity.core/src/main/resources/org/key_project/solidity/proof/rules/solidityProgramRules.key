        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# delete s#mp[s#indexExpr]; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\sameAsTerm(indexExpr, idx), \hasMemoryElementSort(mp, \sort(alpha)),
                 \not\isMemoryReferenceElement(mp))
        "inBounds":
            \replacewith({memory := write(memory, mp, at(idx), defaultValue<[alpha]>)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= idx & idx < read<[int]>(memory, mp, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= idx & idx < read<[int]>(memory, mp, size))
        \heuristics(simplify_prog)
    };

    memoryIndexDeleteReference {
        \schemaVar \formula post;
        \schemaVar \program Path[name=memory.simple.array] mp;
        \schemaVar \program SimpleExpression indexExpr;
        \schemaVar \term int idx;

        \find(\modality{#mod}{c# delete s#mp[s#indexExpr]; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\sameAsTerm(indexExpr, idx), \isMemoryReferenceElement(mp))
        "inBounds":
            \replacewith({memory := write(addM(memory, freshIdp), mp, at(idx),
                                          idC(freshIdp, nil))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= idx & idx < read<[int]>(memory, mp, size)
                 & new(memory, freshIdp) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= idx & idx < read<[int]>(memory, mp, size))
        \heuristics(simplify_prog)
    };

    memoryFieldDelete_unfold_leftFst {
        \schemaVar \formula post;
