    // ------------------------------------------------------------------------
    // ----------- Rules for addition operator (+)
    // ------------------------------------------------------------------------

    // Step 1: Unfold non-simple LEFT operand
    // vp = nse + e  =>  T pv = nse; vp = pv + e;
    addition_unfold_left {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#nse + s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, vp), \newTypeOf(pvType, vp))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#pv + s#e; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Step 2: Unfold non-simple RIGHT operand (when left is already simple)
    // vp = se + nse  =>  T pv = nse; vp = se + pv;
    addition_unfold_right {
        \schemaVar \formula post;
        \schemaVar \program Variable[name=value] vp;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#vp = s#se + s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, vp), \newTypeOf(pvType, vp))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#vp = s#se + s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Step 3a: Unfold non-variable LHS (when both operands are simple)
    // nlhs = se1 + se2  =>  T pv = se1 + se2; nlhs = pv;
    addition_unfold_result {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nlhs;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;
        \schemaVar \program Variable[name=value] pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#nlhs = s#se1 + s#se2; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, se1), \newTypeOf(pvType, se1))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#se1 + s#se2;
                                      s#nlhs = s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

