\include "../examples/commonFields.key";

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\programVariables {
    int r;
}

// The call binds the function's named return value to the surrounding program
// variable `r`; after expansion the post-condition can talk about `r`.
\problem {
    \<{ r = getBalance()@Bank; }\>(true)
}
