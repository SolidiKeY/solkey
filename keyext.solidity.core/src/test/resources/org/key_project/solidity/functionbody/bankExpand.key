\include "../examples/commonFields.key";

\programSource "Bank.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\programVariables {
    int r;
}

\rules {
    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };
}

// The call binds the function's named return value to the surrounding program
// variable `r`; after expansion the post-condition can talk about `r`.
\problem {
    \<{ r = getBalance()@Bank; }\>(true)
}
