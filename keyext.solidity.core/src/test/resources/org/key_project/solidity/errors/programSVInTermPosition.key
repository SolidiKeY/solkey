// Malformed on purpose: the program schema variable 'fr' (a FieldReference) is used in a TERM
// position of \find (the equation `fr = fr`), not inside a modality. Loading must fail with a
// clear error pointing at the \sameAsTerm work-around. Used by ErrorMessageTest.

\schemaVariables {
    \program FieldReference fr;
    \formula post;
}

\rules {
    bogusTermPosition {
        \schemaVar \program FieldReference fr;
        \find(fr = fr ==> )
        \replacewith(true ==> )
    };
}

\problem {
    true
}
