// Malformed on purpose: 'NoSuchSort' is not a registered ProgramSVSort.
// Loading must fail with a clear, located error that lists the known sorts and points the
// developer at registering a ProgramSVSort. Used by ErrorMessageTest.

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    bogus {
        \schemaVar \program NoSuchSort p;
        \schemaVar \formula post;
        \find(\modality{#mod}{ s#p; }\endmodality(post))
        \replacewith(post)
    };
}

\problem {
    true
}
