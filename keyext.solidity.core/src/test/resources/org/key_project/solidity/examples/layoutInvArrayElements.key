\functions {
    Struct st;
    Struct dy;
    int j;
}

\problem {
    (shapeInv(fixedArr(3, fixedArr(2, leaf)), st)
        -> selectSt<[int]>(selectSt<[Struct]>(st, at(j)), size) = 2)
    & (shapeInv(dynArr(fixedArr(2, leaf)), dy)
        -> selectSt<[int]>(selectSt<[Struct]>(dy, at(j + 1)), size) = 2)
}
