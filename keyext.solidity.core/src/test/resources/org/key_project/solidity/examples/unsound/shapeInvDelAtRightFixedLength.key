// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: deleting a length resets it to
// 0 and keeps the node fixed (fixedDelAt), so a fixed array of length 3 stops conforming.

\functions {
    Struct st;
}

\problem {
    shapeInv(fixedArr(3, leaf), st) -> shapeInv(fixedArr(3, leaf), delAt(st, cons(size, nil)))
}
