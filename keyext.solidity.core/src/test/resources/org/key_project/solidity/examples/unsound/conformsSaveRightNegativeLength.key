// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: writing -1 to a dynamic
// array's length breaks its conformance. conformsSaveRight must not reach the length as a mtSt.

\functions {
    Struct st;
}

\problem {
    conforms(emptyOf<[int[]]>, st) -> conforms(emptyOf<[int[]]>, save(st, cons(size, nil), -1))
}
