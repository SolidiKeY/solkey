// Storage field read rules from Section 3.3 (Step 3: Generating an Update).
//
// From the Pre-licenciate paper:
//   storageFieldReadFind:         <v = sp.a;> post    ==> {v := find(st, sp·a)} post
//   storageFieldReadBindLocalRoot: <lp = sp.b;> post  ==> {lp := sp·b} post
//   storageFieldReadStoreRoot:     <gp = sp.b;> post  ==> {st := storeSt(st, gp, find(st, sp·b))} post
//   storageRootReadSelect:         <v = sp;> post     ==> {v := select(st, sp)} post
//
// Implementation notes:
// - Concrete field names (age, balance, account) and concrete program variables (st, v).
// - `find<[int]>(st, cons2(st, age))` reads an int field; `find<[Struct]>(st, cons1(v))` reads a struct.
// - `selectSt<[alpha]>(st, field)` reads a root-level value.
// - Member access in \problem modalities is broken, so problem is `true`.

\include "./commonFields.key";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    // storageFieldReadFind: v = sp.age; ==> {v := find(st, sp·age)} post
    storageFieldReadFind_age {
        \schemaVar \formula post;
        \find(\modality{#mod}{ v = st.age; }\endmodality(post))
        \replacewith({v := find<[int]>(st, cons2(st, age))} post)
        \heuristics(simplify_prog)
    };

    // storageFieldReadFind: v = sp.balance; ==> {v := find(st, sp·balance)} post
    storageFieldReadFind_balance {
        \schemaVar \formula post;
        \find(\modality{#mod}{ v = st.balance; }\endmodality(post))
        \replacewith({v := find<[int]>(st, cons2(st, balance))} post)
        \heuristics(simplify_prog)
    };

    // storageFieldReadBindLocalRoot: lp = sp.account; ==> {lp := sp·account} post
    // Here `v` plays the role of the local root target.
    storageFieldReadBindLocalRoot_account {
        \schemaVar \formula post;
        \find(\modality{#mod}{ v = st.account; }\endmodality(post))
        \replacewith({v := find<[Identity]>(st, cons2(st, account))} post)
        \heuristics(simplify_prog)
    };

    // storageRootReadSelect: v = sp; ==> {v := select(st, sp)} post
    // Reading a whole root value (e.g., reading a primitive state variable).
    storageRootReadSelect {
        \schemaVar \formula post;
        \find(\modality{#mod}{ v = st; }\endmodality(post))
        \replacewith({v := selectSt<[int]>(st, st)} post)
        \heuristics(simplify_prog)
    };
}

\problem {
    true
}
