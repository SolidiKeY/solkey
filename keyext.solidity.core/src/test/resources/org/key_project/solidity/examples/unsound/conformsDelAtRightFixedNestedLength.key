// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: the length delete of an inner
// fixed array, below the node the obligation is about, breaks conformance too.

\functions {
    Struct st;
}

\problem {
    conforms(emptyOf<[int[3][]]>, st)
        -> conforms(emptyOf<[int[3][]]>, delAt(st, cons(at(0), cons(size, nil))))
}
