// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#diamondTransferStaysOpen:
// with CInv defined as true and transferSucceeds(to, v) assumed, transferWithCallbackDiamond's
// "transfer succeeds", "invariant on exit" and "resume after callback" goals close
// trivially, isolating the "non-negative amount" obligation 0 <= v, which cannot close
// with v unconstrained.

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
    int v;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    transferSucceeds(to, v) -> \<{ to.transfer(v); }\>(true)
}
