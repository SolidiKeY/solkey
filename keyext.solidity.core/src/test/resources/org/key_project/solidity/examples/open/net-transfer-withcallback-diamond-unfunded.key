// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#diamondTransferStaysOpen:
// with CInv defined as true, transferWithCallbackDiamond's other goals close trivially,
// isolating the "transfer succeeds" goal transferSucceeds(to, 1), which cannot close
// since the calculus tracks neither the contract's balance nor whether the receiver
// accepts.

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    \<{ to.transfer(1); }\>(true)
}
