// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#unfundedDiamondStaysOpen:
// with CInv defined as true, transferWithCallbackDiamond's "invariant on exit" and
// "resume after callback" goals close trivially, isolating the "sufficient funds"
// obligation 0 <= 5 & 5 <= selfBalance, which cannot close with selfBalance
// unconstrained.

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    \<{ to.transfer(5); }\>(true)
}
