\functions {
    Struct st;
    Struct fx;
}

\problem {
    (shapeInv(dynArr(leaf), st)
        -> shapeInv(dynArr(leaf), save(st, cons(size, nil), selectSt<[int]>(st, size) + 1)))
    & (shapeInv(dynArr(dynArr(leaf)), st)
        -> shapeInv(dynArr(dynArr(leaf)),
              save(st, cons(at(0), cons(size, nil)),
                   selectSt<[int]>(selectSt<[Struct]>(st, at(0)), size) + 1)))
    & (shapeInv(fixedArr(2, dynArr(leaf)), fx)
        & 0 < selectSt<[int]>(selectSt<[Struct]>(fx, at(1)), size)
        -> shapeInv(fixedArr(2, dynArr(leaf)),
              save(fx, cons(at(1), cons(size, nil)),
                   selectSt<[int]>(selectSt<[Struct]>(fx, at(1)), size) - 1)))
}
