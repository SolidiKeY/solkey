// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: conformsDynRight establishes
// conformance at int indices only, so the node at a bool key at(TRUE) is unconstrained.
// conformsDynElem must not hand out conformance there; it takes an int index. The int-index
// version closes (layoutInvArrayElements.key).

\functions {
    Struct st;
}

\problem {
    conforms(emptyOf<[int[2][]]>, st)
        & selectSt<[int]>(selectSt<[Struct]>(st, at(TRUE)), size) = 5
        -> false
}
