// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: writing -1 to a dynamic
// array's length breaks its conformance. shapeInvSaveRight must not reach the length as a leaf.

\functions {
    Struct st;
}

\problem {
    shapeInv(dynArr(leaf), st) -> shapeInv(dynArr(leaf), save(st, cons(size, nil), -1))
}
