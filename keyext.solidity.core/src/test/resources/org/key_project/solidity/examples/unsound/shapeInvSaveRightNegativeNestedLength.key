// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: the length write of an inner
// array, below the node the obligation is about, owes the bound too.

\functions {
    Struct st;
}

\problem {
    shapeInv(dynArr(dynArr(leaf)), st)
        -> shapeInv(dynArr(dynArr(leaf)), save(st, cons(at(0), cons(size, nil)), -1))
}
