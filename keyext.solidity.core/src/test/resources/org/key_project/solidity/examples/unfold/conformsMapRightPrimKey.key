// Not a proof obligation to close: RulesTest#conformsMapRightUnfoldsAtAPrimKey runs one proof
// step, conformsMapRight at the top, and checks that the fresh key is a Prim skolem, not an int one.
// The problem itself is unprovable under any rules (st is arbitrary), so it is kept out of
// unsound/; the unsoundness regression is unsound/conformsMapRightIntKeysOnly.key.

\functions {
    Struct st;
}

\problem {
    conforms(emptyOf<[mapping<[int, int[3]]>]>, st)
}
