// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: shapeInvDynRight establishes
// conformance at int indices only, so the node at a bool key at(TRUE) is unconstrained.
// shapeInvDynElem must not hand out conformance there; it takes an int index. The int-index
// version closes (layoutInvArrayElements.key).

\functions {
    Struct st;
}

\problem {
    shapeInv(dynArr(fixedArr(2, leaf)), st)
        & selectSt<[int]>(selectSt<[Struct]>(st, at(TRUE)), size) = 5
        -> false
}
