// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: a false claim of termination
// (docs/storage.md, "Overlapping copies"). Checked on the EVM: nodeTree.kids[0] = nodeTree copies
// nodeTree.kids into nodeTree.kids[0].kids, whose element 0 is again a copy of a node into its own
// first child, and so on until the call halts with TOO_MANY_STACK_ITEMS.
\programSource "RecursiveCopyOverlap.sol";

\rules {
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(conforms(fieldType(RecursiveCopyOverlap$nodeTree), select<[Struct]>(s, RecursiveCopyOverlap$nodeTree)))
        \heuristics(simplify)
    };
}

\problem {
    lenInv(storage) ->
    \<{ copyIntoOwnChild()@RecursiveCopyOverlap; }\>(true)
}
