// Storage field write rules from Section 3.3 (Step 3: Generating an Update).
//
// From the Pre-licenciate paper:
//   storageFieldWriteSave:       <sp.a = se;> post  ==>  {st := save(st, sp·a, se)} post
//   storageFieldWriteCopySource: <sp1.a = sp2;> post ==> {st := save(st, sp1·a, select(st, sp2))} post
//
// Implementation notes:
// - We use concrete program variables (st, v) and concrete field names (age, balance, account)
//   because there is no program SV sort for a field-name metavariable, and the parser does not
//   support schema variables in member-access position (s#sp.age fails to parse).
// - The storage struct is the program variable `st` (declared in commonFields.key).
// - A field path `st.age` in the program maps to `cons2(st, age)` in the logic.
// - Member access in \problem modalities triggers a parser bug (FieldDeclaration cast), so
//   the problem is set to `true` as a load test. The struct theory rules (selectOnStore, etc.)
//   are tested separately in simpleExample1-3.key.

\include "./commonFields.key";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program SimpleExpression se;
}

\rules {
    // storageFieldWriteSave for the `age` field
    // Paper: <sp.a = se;> post ==> {st := save(st, sp·a, se)} post
    storageFieldWriteSave_age {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \find(\modality{#mod}{ st.age = s#se; }\endmodality(post))
        \replacewith({st := save(st, cons2(st, age), se)} post)
        \heuristics(simplify_prog)
    };

    // storageFieldWriteSave for the `balance` field
    storageFieldWriteSave_balance {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \find(\modality{#mod}{ st.balance = s#se; }\endmodality(post))
        \replacewith({st := save(st, cons2(st, balance), se)} post)
        \heuristics(simplify_prog)
    };

    // storageFieldWriteCopySource for the `account` field
    // The RHS is a storage path whose value is read via find, not the path itself.
    storageFieldWriteCopySource_account {
        \schemaVar \formula post;
        \find(\modality{#mod}{ st.account = v; }\endmodality(post))
        \replacewith({st := save(st, cons2(st, account), find<[Struct]>(st, cons1(v)))} post)
        \heuristics(simplify_prog)
    };

    // storageFieldWriteCopySource for the `age` field
    storageFieldWriteCopySource_age {
        \schemaVar \formula post;
        \find(\modality{#mod}{ st.age = v; }\endmodality(post))
        \replacewith({st := save(st, cons2(st, age), find<[int]>(st, cons1(v)))} post)
        \heuristics(simplify_prog)
    };
}

\problem {
    true
}
