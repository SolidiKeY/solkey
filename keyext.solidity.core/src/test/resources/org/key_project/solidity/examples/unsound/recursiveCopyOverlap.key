// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: a false claim, kept open by
// srcView (docs/storage.md, "Overlapping copies"). Counterexample, checked on the EVM: before
// the copy nodeTree = {v 0, kids [S]}, S = {v 0, kids [A, B]}, A = {v 0, kids []}, B = {v 5, kids []}.
// solc copies S into nodeTree in place: kids gets length 2, then kids[0] := A overwrites S itself,
// which shrinks S.kids to [] and clears B; kids[1] := S.kids[1] then reads the cleared B. After the
// copy nodeTree.kids[1].v is 0, while the snapshot copy gives 5.
\programSource "RecursiveCopyOverlap.sol";

\rules {
    insertLenInv {
        \schemaVar \term Struct s;
        \find(lenInv(s))
        \replacewith(conforms(fieldType(RecursiveCopyOverlap$nodeTree), selectSt<[Struct]>(s, RecursiveCopyOverlap$nodeTree)))
        \heuristics(simplify)
    };
}

\problem {
    lenInv(storage) ->
    \<{ copyFromOwnChild()@RecursiveCopyOverlap; }\>(true)
}
