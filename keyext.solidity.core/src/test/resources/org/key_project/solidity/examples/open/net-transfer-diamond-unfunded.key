// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#diamondTransferStaysOpen
// (solc smtCheckerTests/blockchain_state/transfer_3.sol): a transfer reverts when the
// contract's balance is short or the receiver rejects the payment, and the calculus tracks
// neither, so transferNoCallbackDiamond's "transfer succeeds" goal
// transferSucceeds(to, 1) cannot close.

\programVariables {
    int to;
}

\problem {
    \<{ to.transfer(1); }\>(true)
}
