// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#unfundedDiamondStaysOpen
// (which is why it lives outside the RulesTest-scanned directory):
// transferNoCallbackDiamond owes 0 <= 5 & 5 <= selfBalance, and selfBalance is
// unconstrained, so the "sufficient funds" goal cannot close. The "transfer booked"
// goal closes trivially against post = true, isolating the funding obligation as the
// only open goal.

\programVariables {
    int to;
}

\problem {
    \<{ to.transfer(5); }\>(true)
}
