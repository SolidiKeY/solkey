// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: shapeInvMapElem hands out
// conformance at every Prim key (at(TRUE) too), so shapeInvMapRight must owe it at a fresh Prim key.
// With an int skolem, conformance at the int keys alone proved the mapping atom. The problem
// needs HeuristicInstantiation to skip ill-sorted instances: instantiating i with the Prim
// skolem used to abort the proof with an illegal instantiation.

\functions {
    Struct st;
}

\problem {
    (\forall int i; shapeInv(fixedArr(3, leaf), selectSt<[Struct]>(st, at(i))))
        -> shapeInv(mapOf(fixedArr(3, leaf)), st)
}
