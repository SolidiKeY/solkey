// Asserted to stay OPEN by RulesTest#unsoundWfProblemStaysOpen: shapeInvFixedRight establishes
// conformance at int indices only (at(skx), atMap(skx) with skx an int skolem), so the node at
// a bool key at(TRUE) is unconstrained. shapeInvFixedElem must not hand out conformance there; it
// takes an int index. The int-index version closes (layoutInvArrayElements.key).

\functions {
    Struct st;
}

\problem {
    shapeInv(fixedArr(3, fixedArr(2, leaf)), st)
        & selectSt<[int]>(selectSt<[Struct]>(st, at(TRUE)), size) = 5
        -> false
}
