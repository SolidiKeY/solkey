// Revert rules from Section 3.2 (Abrupt Termination) of the Pre-licenciate paper.
//
// revertDiamond: <revert;> post  ==>  false   (no normal successor)
// revertBox:     [revert;] post  ==>  true    (abrupt termination satisfies any postcondition)
//
// KNOWN ISSUE: The Solidity grammar defines `revertStatement: 'revert' functionCall ';'`
// but the parser currently throws an NPE when parsing `revert()` inside a modality
// (IdentifierContext.Identifier() returns null for the 'revert' keyword used as a
// function-call expression).  This file therefore cannot be loaded yet.
// Once the parser is fixed, these taclets should work.

\include "./commonFields.key";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    revertDiamond {
        \schemaVar \formula post;
        \find(\<{ revert(); }\>(post))
        \replacewith(false)
        \heuristics(simplify_prog)
    };

    revertBox {
        \schemaVar \formula post;
        \find(\[{ revert(); }\](post))
        \replacewith(true)
        \heuristics(simplify_prog)
    };
}

\problem {
    (\<{ revert(); }\>(true) = false)
    & (\[{ revert(); }\](false) = true)
}
